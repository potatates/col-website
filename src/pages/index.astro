---
// 首页 = 全站导览。每个板块预告一个栏目页，可一路滚动看完概况，也可随时点进去。
import { u } from '../lib/url';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/zh/Header.astro';
import Footer from '../components/zh/Footer.astro';
import BizPosters from '../components/zh/BizPosters.astro';
import CtaBand from '../components/zh/CtaBand.astro';
import { site, pages, home, irHighlights } from '../content/zh';

// 海报色板：以蓝青为主，夹杂紫、粉、橙，像一面海报墙
const palette = [205, 250, 190, 330, 275, 215, 20, 300, 230, 175, 345, 40];
const hue = (s: string) => palette[[...s].reduce((a, c) => a + c.charCodeAt(0), 0) % palette.length];
const isNum = (v: string) => /^[\d,]+$/.test(v);
const half = Math.ceil(home.marquee.length / 2);
const rows = [home.marquee.slice(0, half), home.marquee.slice(half)];

// 首屏漂浮的海报（位置、角度、视差深度）
const floaters = [
  { t: '罗小黑战记', x: 62, y: 16, r: -8, d: 30, w: 170 },
  { t: '一品布衣', x: 80, y: 8, r: 6, d: -20, w: 150 },
  { t: '修罗武神', x: 74, y: 46, r: -4, d: 45, w: 190 },
  { t: '破夜', x: 90, y: 40, r: 10, d: -35, w: 140 },
  { t: '永徽迷局', x: 60, y: 58, r: 7, d: 25, w: 150 },
];
const news = home.news;
---
<BaseLayout title={`${site.name}_${site.slogan}`} description={home.intro}>
  <Header current="home" />

  <main>
    <!-- 首屏 -->
    <section class="hero spot">
      <div class="mesh" aria-hidden="true">
        <span class="blob b1"></span><span class="blob b2"></span><span class="blob b3"></span><span class="blob b4"></span>
      </div>
      <div class="hero-mouse" aria-hidden="true"></div>
      <div class="floaters" aria-hidden="true">
        {floaters.map((f, i) => (
          <div class="floater" data-depth={f.d} style={`left:${f.x}%;top:${f.y}%;width:${f.w}px;--r:${f.r}deg;--i:${i}`}>
            <div class="cover" style={`--h:${hue(f.t)}`}><span>{f.t}</span></div>
          </div>
        ))}
        <span class="ring" data-depth="-50"></span>
        <span class="sun" data-depth="60"></span>
      </div>
      <div class="container hero-inner">
        <span class="hero-tag">{site.enName} · {site.stockCode}</span>
        <h1>
          <span class="l1">更好内容</span>
          <span class="l2">更好生活</span>
        </h1>
        <p class="hero-sub">{site.tagline}，用好故事连接世界。</p>
        <div class="hero-actions">
          <a href={u("/partner")} class="btn btn-light">合作咨询 <span class="arrow">→</span></a>
          <a href={u("/ip")} class="btn btn-ghost">看看我们的作品 <span class="arrow">→</span></a>
        </div>
      </div>
      <a href="#about" class="scroll-hint" aria-label="向下滚动"><span>SCROLL</span></a>
    </section>

    <!-- 你是来……：可选的受众入口条，不强制选择（决策 D8） -->
    <nav class="container audience reveal" aria-label="按身份快速进入">
      <span class="aud-label">你是来……</span>
      {home.audiences.map((a) => (
        <a href={u(a.href)} class="aud"><strong>{a.label}</strong><small>{a.hint}</small><span class="arrow">→</span></a>
      ))}
    </nav>

    <!-- 首页顺序：业务（含数商）→ 新闻（团队要求前置，让访客先看到最新动态）→ IP → 数商 → 关于 → 投资者 → 加入我们 -->
    <!-- 业务与产品：海报 + 合作伙伴 -->
    <section class="block-section" id="business">
      <div class="container">
        <div class="s-head reveal">
          <span class="s-ghost" aria-hidden="true">BUSINESS</span>
          <div class="s-head-row">
            <h2 class="s-title">一个故事，<span class="hl">无限可能</span></h2>
            <a href={u(pages.business.href)} class="btn btn-outline">全部业务 <span class="arrow">→</span></a>
          </div>
        </div>
        <BizPosters />
        <div class="partners reveal" aria-label="合作伙伴">
          <span class="p-label">合作伙伴</span>
          {home.partners.map((p) => <span class="p-logo">{p}</span>)}
        </div>
      </div>
    </section>

    <!-- 新闻动态 -->
    <section class="block-section" id="news">
      <div class="container">
        <div class="s-head reveal">
          <span class="s-ghost" aria-hidden="true">NEWS</span>
          <div class="s-head-row">
            <h2 class="s-title">新鲜事</h2>
            <a href={u(pages.news.href)} class="btn btn-outline">全部新闻 <span class="arrow">→</span></a>
          </div>
        </div>
        <div class="news">
          {news.map((n, i) => (
            <a href={u("/news")} class="card news-card reveal" style={`--d:${i * 90}ms;--c1:${['#0071ce', '#6c4dff', '#ff5c9a'][i]};--c2:${['#00c1de', '#ff5c9a', '#ffc53d'][i]}`}>
              <span class="news-band" aria-hidden="true"></span>
              <span class="card-tag">{n.tag}</span>
              <span class="card-title">{n.title}</span>
              <span class="news-date">{n.date}</span>
              <span class="card-go">阅读 <span class="arrow">→</span></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- 作品&IP：海报自动滚动，悬停暂停 -->
    <section class="block-section" id="works">
      <div class="container">
        <div class="s-head reveal">
          <span class="s-ghost" aria-hidden="true">WORKS & IP</span>
          <div class="s-head-row">
            <h2 class="s-title">这些故事，<span class="hl">来自这里</span></h2>
            <a href={u(pages.ip.href)} class="btn btn-outline">作品&IP <span class="arrow">→</span></a>
          </div>
        </div>
        <div class="ip-feature">
          {home.ip.map((x, n) => (
            <a href={u('/ip#wall')} class="ipf reveal" style={`--d:${n * 80}ms`}>
              <div class="cover" style={`--h:${hue(x.title)}`}><span>{x.title}</span></div>
              <div class="ipf-body">
                <strong>{x.title}</strong>
                <small>{x.genre} · {x.forms.join(' / ')}</small>
                <span class="ipf-tags">{x.tags.slice(0, 2).map((t) => <em>#{t}</em>)}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
      <div class="marquee reveal" aria-label="代表作品">
        {rows.map((row, r) => (
          <div class:list={['track', { rev: r === 1 }]}>
            {[...row, ...row].map((t, i) => (
              <a href={u("/ip")} class="cover m-cover" style={`--h:${hue(t)};--tilt:${(i % 3) - 1}deg`}><span>{t}</span></a>
            ))}
          </div>
        ))}
      </div>
    </section>

    <!-- 数商服务预告 -->
    <section class="block-section" id="data">
      <div class="container">
        <div class="s-head reveal">
          <span class="s-ghost" aria-hidden="true">DATA</span>
          <div class="s-head-row">
            <h2 class="s-title">{home.data.title}</h2>
            <a href={u(pages.data.href)} class="btn btn-outline">数商服务 <span class="arrow">→</span></a>
          </div>
          <p class="s-intro">{home.data.intro}</p>
        </div>
        <a href={u(pages.data.href)} class="data-panel spot reveal">
          {home.data.services.map((d, i) => (
            <span class="d-item" style={`--d:${i * 80}ms`}><em>0{i + 1}</em><strong>{d.title}</strong><small>{d.text}</small></span>
          ))}
          <span class="d-go">找数商对接人 <span class="arrow">→</span></span>
        </a>
      </div>
    </section>

    <!-- 关于我们 -->
    <section class="block-section" id="about">
      <div class="container">
        <div class="s-head reveal">
          <span class="s-ghost" aria-hidden="true">ABOUT US</span>
          <h2 class="s-title">从清华园出发，<span class="hl">二十多年</span>只做一件事：好内容</h2>
        </div>
        <div class="about reveal">
          <p class="lead">{home.intro}</p>
          <a href={u(pages.about.href)} class="btn btn-primary">走进中文在线 <span class="arrow">→</span></a>
        </div>
        <div class="stats">
          {home.stats.map((s, i) => (
            <div class="stat reveal" style={`--d:${i * 90}ms`}>
              <div class="num"><span data-count={isNum(s.value) ? s.value : undefined}>{s.value}</span><em>{s.unit}</em></div>
              <div class="num-label">{s.label}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 投资者关系 -->
    <section class="block-section" id="investors">
      <div class="container">
        <div class="s-head reveal">
          <span class="s-ghost" aria-hidden="true">INVESTORS</span>
          <div class="s-head-row">
            <h2 class="s-title"><span class="hl">AI + 全球化</span>，双轮驱动</h2>
            <a href={u(pages.investors.href)} class="btn btn-outline">投资者关系 <span class="arrow">→</span></a>
          </div>
        </div>
        <div class="ir">
          <a href={u("/investors#letter")} class="ir-quote spot reveal">
            <span class="q-mark" aria-hidden="true">“</span>
            <p>{home.letterLead}</p>
            <span class="q-by">董事长 童之磊 · 致股东信 →</span>
          </a>
          <div class="ir-stats">
            {irHighlights.slice(0, 4).map((s, i) => (
              <div class="ir-stat reveal" style={`--d:${i * 80}ms`}>
                <div class="num"><span data-count={isNum(s.value) ? s.value : undefined}>{s.value}</span><em>{s.unit}</em></div>
                <div class="num-label">{s.label}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 加入我们 -->
    <section class="block-section" id="join">
      <div class="container">
        <a href={u(pages.join.href)} class="join spot reveal">
          <span class="j-shape s1" aria-hidden="true"></span>
          <span class="j-shape s2" aria-hidden="true"></span>
          <span class="j-en">JOIN US</span>
          <span class="j-title">和我们一起，<br />讲好下一个故事</span>
          <span class="j-tags">
            {['导师计划', '爆款俱乐部', '创新大会', '弹性工作', '运动俱乐部'].map((t) => <span>{t}</span>)}
          </span>
          <span class="j-go">加入我们 <span class="arrow">→</span></span>
        </a>
      </div>
    </section>
  </main>

  <CtaBand />
  <Footer />
</BaseLayout>

<style>
  /* ---------- 首屏 ---------- */
  .hero { position: relative; min-height: 100vh; display: flex; align-items: center; overflow: hidden; isolation: isolate; color: #fff; padding: 120px 0 140px; }
  .mesh { position: absolute; inset: 0; z-index: -3; background: linear-gradient(135deg, #0053a6 0%, var(--brand) 40%, #3b3fd8 100%); }
  .mesh::after { content: ''; position: absolute; inset: auto 0 0 0; height: 30%; background: linear-gradient(180deg, transparent, var(--bg)); }
  .blob { position: absolute; border-radius: 50%; filter: blur(80px); animation: drift 18s ease-in-out infinite; }
  .b1 { width: 620px; height: 620px; background: var(--brand-2); right: -100px; top: -160px; opacity: .75; }
  .b2 { width: 520px; height: 520px; background: var(--violet); left: 20%; top: 30%; opacity: .55; animation-delay: -6s; }
  .b3 { width: 380px; height: 380px; background: var(--pink); right: 18%; bottom: 8%; opacity: .45; animation-delay: -11s; }
  .b4 { width: 300px; height: 300px; background: var(--sun); left: -80px; top: 6%; opacity: .25; animation-delay: -3s; }
  @keyframes drift { 50% { transform: translate(-60px, 50px) scale(1.15); } }
  .hero-mouse {
    position: absolute; inset: 0; z-index: -2; pointer-events: none;
    background: radial-gradient(520px circle at var(--mx, 70%) var(--my, 40%), rgba(255,255,255,.18), transparent 60%);
  }

  .floaters { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .floater { position: absolute; transition: translate .8s var(--ease); animation: bob 7s ease-in-out infinite; animation-delay: calc(var(--i) * -1.4s); }
  .floater .cover { rotate: var(--r); box-shadow: 0 30px 50px -20px rgba(10,20,60,.6); }
  @keyframes bob { 50% { transform: translateY(-18px); } }
  .ring { position: absolute; width: 260px; height: 260px; border-radius: 50%; border: 2px dashed rgba(255,255,255,.4); left: 52%; top: 66%; animation: spin 40s linear infinite; transition: translate .8s var(--ease); }
  .sun { position: absolute; width: 70px; height: 70px; border-radius: 50%; background: var(--sun); left: 88%; top: 72%; box-shadow: 0 0 60px rgba(255,197,61,.7); transition: translate .8s var(--ease); }
  @keyframes spin { to { rotate: 360deg; } }

  .hero-inner { position: relative; width: 100%; }
  .hero-tag { display: inline-block; font-size: 13px; font-weight: 700; letter-spacing: .2em; padding: 7px 16px; border-radius: 999px; background: rgba(255,255,255,.16); backdrop-filter: blur(8px); animation: rise 1s var(--spring) both; }
  .hero h1 { display: flex; flex-direction: column; margin: 26px 0 24px; font-size: clamp(56px, 10vw, 140px); font-weight: 900; line-height: 1.02; letter-spacing: .02em; }
  .l1 { animation: rise 1.1s var(--spring) .05s both; }
  .l2 {
    animation: rise 1.1s var(--spring) .18s both, shine 6s linear 1.4s infinite;
    background: linear-gradient(90deg, #fff 0%, #9ef2ff 30%, #ffd6ea 60%, #fff 100%); background-size: 200% 100%;
    -webkit-background-clip: text; background-clip: text; color: transparent; padding-left: .6em;
  }
  @keyframes shine { to { background-position: -200% 0; } }
  @keyframes rise { from { opacity: 0; transform: translateY(50px); } }
  .hero-sub { font-size: clamp(17px, 1.7vw, 22px); opacity: .92; max-width: 640px; animation: rise 1s var(--spring) .3s both; }
  .hero-actions { display: flex; gap: 14px; margin-top: 40px; flex-wrap: wrap; animation: rise 1s var(--spring) .4s both; }
  .btn-light { background: #fff; color: var(--ink); box-shadow: 0 14px 30px -12px rgba(10,20,60,.5); }
  .btn-light:hover { color: var(--brand); }
  .scroll-hint { position: absolute; left: 50%; bottom: 48px; translate: -50% 0; font-size: 11px; font-weight: 700; letter-spacing: .3em; color: var(--ink); opacity: .6; }
  .scroll-hint span { display: block; animation: hop 1.6s var(--spring) infinite; }
  @keyframes hop { 50% { transform: translateY(8px); } }

  /* ---------- 关于 ---------- */
  .about { display: flex; justify-content: space-between; align-items: flex-end; gap: 40px; flex-wrap: wrap; }
  .lead { font-size: clamp(18px, 1.9vw, 23px); line-height: 1.85; color: var(--text); max-width: 760px; }
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-top: 56px; }
  .stat { position: relative; padding: 8px 0; }
  .stat::before { content: ''; position: absolute; left: -12px; top: 0; width: 56px; height: 56px; border-radius: 50%; background: var(--grad); opacity: .14; transition: transform .6s var(--spring); }


  /* ---------- IP 精选 ---------- */
  .ip-feature { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 8px; }
  .ipf { display: flex; flex-direction: column; gap: 12px; padding: 14px; border-radius: 28px; background: var(--surface); box-shadow: 0 12px 30px -20px rgba(10,22,48,.3); transition: transform .5s var(--spring), box-shadow .4s, opacity .8s var(--ease); }
  .ipf:hover { transform: translateY(-8px) rotate(-.6deg); box-shadow: 0 30px 50px -26px rgba(10,22,48,.4); }
  .ipf .cover { aspect-ratio: 16 / 10; }
  .ipf-body { display: flex; flex-direction: column; gap: 4px; padding: 0 6px 6px; }
  .ipf-body strong { font-size: 18px; color: var(--ink); }
  .ipf-body small { font-size: 13px; color: var(--muted); }
  .ipf-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 4px; }
  .ipf-tags em { font-style: normal; font-size: 12px; font-weight: 700; color: var(--violet); background: color-mix(in srgb, var(--violet) 9%, transparent); padding: 2px 8px; border-radius: 6px; }

  /* ---------- 作品滚动 ---------- */
  .marquee { display: flex; flex-direction: column; gap: 24px; overflow: hidden; padding: 20px 0 40px; mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); }
  .track { display: flex; gap: 22px; width: max-content; animation: scroll 60s linear infinite; }
  .track.rev { animation-direction: reverse; animation-duration: 72s; }
  .marquee:hover .track { animation-play-state: paused; }
  @keyframes scroll { to { transform: translateX(-50%); } }
  .m-cover { width: 180px; flex-shrink: 0; rotate: var(--tilt); }

  /* ---------- 投资者 ---------- */
  .ir { display: grid; grid-template-columns: 1.1fr 1fr; gap: 20px; }
  .ir-quote {
    position: relative; overflow: hidden; isolation: isolate; border-radius: 36px; padding: 48px; color: #fff;
    background: linear-gradient(140deg, #1b3a8c, var(--brand) 55%, var(--brand-2));
    display: flex; flex-direction: column; justify-content: space-between; gap: 28px;
    transition: transform .6s var(--spring), opacity .8s var(--ease);
  }
  .ir-quote:hover { transform: rotate(-1deg) translateY(-6px); }
  .ir-quote::after { content: ''; position: absolute; inset: 0; z-index: -1; opacity: 0; transition: opacity .3s; background: radial-gradient(360px circle at var(--mx, 50%) var(--my, 50%), rgba(255,255,255,.25), transparent 65%); }
  .ir-quote:hover::after { opacity: 1; }
  .q-mark { position: absolute; right: 30px; top: -40px; font-size: 220px; line-height: 1; font-family: Georgia, serif; opacity: .18; }
  .ir-quote p { font-size: clamp(20px, 2vw, 26px); line-height: 1.7; font-weight: 700; }
  .q-by { font-size: 14px; font-weight: 600; opacity: .9; }
  .ir-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .ir-stat { position: relative; overflow: hidden; padding: 28px; border-radius: 28px; background: var(--surface); box-shadow: 0 12px 30px -20px rgba(10,22,48,.3); transition: transform .5s var(--spring), opacity .8s var(--ease); }
  .ir-stat .num span { font-size: clamp(38px, 4vw, 56px); }

  /* ---------- 新闻 ---------- */
  .news { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .news-card { min-height: 260px; padding-top: 0; overflow: hidden; }
  .news-band { display: block; height: 10px; margin: 0 -30px 18px; background: linear-gradient(90deg, var(--c1), var(--c2)); transition: height .5s var(--spring); }
  .news-card:hover .news-band { height: 22px; }
  .news-date { font-size: 13px; color: var(--muted); }

  /* ---------- 加入我们 ---------- */
  .join {
    position: relative; overflow: hidden; isolation: isolate; display: flex; flex-direction: column; gap: 18px;
    padding: 64px; border-radius: 44px; color: #fff;
    background: linear-gradient(130deg, var(--pink), #ff8a5c 55%, var(--sun));
    transition: transform .6s var(--spring), box-shadow .4s, opacity .8s var(--ease);
  }
  .join:hover { transform: scale(1.01) rotate(-.5deg); box-shadow: 0 40px 70px -30px rgba(255,92,154,.6); }
  .join::after { content: ''; position: absolute; inset: 0; z-index: -1; opacity: 0; transition: opacity .3s; background: radial-gradient(420px circle at var(--mx, 50%) var(--my, 50%), rgba(255,255,255,.3), transparent 65%); }
  .join:hover::after { opacity: 1; }
  .j-shape { position: absolute; z-index: -1; transition: transform 1s var(--spring); }
  .j-shape.s1 { width: 360px; height: 360px; border-radius: 50%; border: 3px solid rgba(255,255,255,.35); right: -80px; top: -120px; }
  .j-shape.s2 { width: 160px; height: 160px; border-radius: 38% 62% 55% 45%; background: rgba(255,255,255,.22); right: 18%; bottom: -40px; }
  .join:hover .j-shape.s1 { transform: scale(1.15); }
  .join:hover .j-shape.s2 { transform: rotate(80deg) translateY(-20px); }
  .j-en { font-size: 13px; font-weight: 800; letter-spacing: .25em; }
  .j-title { font-size: clamp(36px, 5vw, 64px); font-weight: 900; line-height: 1.15; }
  .j-tags { display: flex; flex-wrap: wrap; gap: 10px; }
  .j-tags span { padding: 8px 16px; border-radius: 999px; background: rgba(255,255,255,.22); font-size: 14px; font-weight: 600; backdrop-filter: blur(6px); }
  .j-go { align-self: flex-start; display: inline-flex; gap: 10px; padding: 14px 28px; border-radius: 999px; background: #fff; color: #e2457f; font-weight: 700; margin-top: 8px; }
  .j-go .arrow { transition: transform .4s var(--spring); }
  .join:hover .j-go .arrow { transform: translateX(6px); }


  /* ---------- 受众入口条 ---------- */
  .audience { position: relative; z-index: 2; margin-top: -64px; display: flex; flex-wrap: wrap; align-items: stretch; gap: 10px; padding: 14px; border-radius: 28px; background: rgba(255,255,255,.85); backdrop-filter: blur(16px); box-shadow: 0 24px 50px -30px rgba(10,22,48,.4); }
  .aud-label { align-self: center; font-size: 13px; font-weight: 700; color: var(--muted); padding: 0 8px; }
  .aud { flex: 1 1 150px; display: grid; grid-template-columns: 1fr auto; column-gap: 8px; padding: 12px 16px; border-radius: 18px; transition: background .25s, transform .4s var(--spring); }
  .aud strong { font-size: 16px; color: var(--ink); }
  .aud small { grid-column: 1; font-size: 12px; color: var(--muted); }
  .aud .arrow { grid-row: 1 / span 2; grid-column: 2; align-self: center; color: var(--brand); transition: transform .4s var(--spring); }
  .aud:hover { background: var(--bg); transform: translateY(-2px); }
  .aud:hover .arrow { transform: translateX(4px); }

  /* ---------- 数商预告 ---------- */
