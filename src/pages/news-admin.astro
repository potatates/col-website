---
// 新闻发布页（内部用，不在网站导航里，也不被搜索引擎收录）：/news-admin/
// 粘贴公众号文章链接 → 生成草稿 → 预览 → 发布。不需要 GitHub 账号：
// 页面用一把“钥匙”（只能运行本仓库新闻任务的 GitHub 访问令牌）替用户点 GitHub 上的「导入新闻」「发布新闻」。
// 钥匙用密码加密后存在 src/data/news-key.json（由 scripts/news-key.mjs 生成），输入正确密码才能解锁使用。
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const REPO = 'potatates/col-website'; // 仓库迁移到公司账号后改这一行
const keyFiles = import.meta.glob('../data/news-key.json', { eager: true, import: 'default' }) as Record<string, unknown>;
const LOCKED = Object.values(keyFiles)[0] ?? null;
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>官网内容管理_中文在线</title>
  <link rel="icon" href={`${base}/favicon.png`} type="image/png" />
  <style is:global>
    :root { --brand: #0071ce; --ink: #0b1430; --text: #3a4560; --muted: #7a849c; --line: #e4e8f0; --bg: #f4f6fb; --ok: #16a34a; --warn: #b45309; --err: #dc2626; }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: 'PingFang SC', 'Microsoft YaHei', system-ui, sans-serif; background: var(--bg); color: var(--text); line-height: 1.6; }
    .wrap { max-width: 760px; margin: 0 auto; padding: 32px 16px 80px; }
    h1 { font-size: 26px; color: var(--ink); margin: 0 0 4px; }
    .sub { color: var(--muted); margin: 0 0 28px; font-size: 14px; }
    .card { background: #fff; border-radius: 18px; padding: 22px; margin-bottom: 18px; box-shadow: 0 10px 30px -24px rgba(10,22,48,.4); }
    .card h2 { font-size: 17px; color: var(--ink); margin: 0 0 14px; }
    label { display: block; font-size: 14px; font-weight: 600; color: var(--ink); margin: 12px 0 6px; }
    input, select, textarea { width: 100%; font: inherit; padding: 11px 13px; border: 1px solid var(--line); border-radius: 12px; background: #fff; color: var(--ink); }
    textarea { resize: vertical; line-height: 1.6; font-size: 14px; }
    #url-count { margin-top: 6px; color: var(--brand); font-weight: 700; }
    input:focus, select:focus, textarea:focus { outline: 2px solid color-mix(in srgb, var(--brand) 35%, transparent); border-color: var(--brand); }
    .row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    button { font: inherit; font-weight: 700; border: 0; border-radius: 999px; padding: 11px 20px; cursor: pointer; background: var(--brand); color: #fff; }
    button.ghost { background: #eef2f9; color: var(--ink); }
    button.danger { background: #fdecec; color: var(--err); }
    button:disabled { opacity: .5; cursor: default; }
    button { transition: transform .12s, opacity .2s; }
    button:not(:disabled):active { transform: scale(.95); }
    #drafts, #runs { transition: opacity .2s; }
    .busy { opacity: .4; }
    .actions { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 16px; align-items: center; }
    .msg { font-size: 14px; margin-top: 12px; min-height: 1.6em; }
    .msg.ok { color: var(--ok); } .msg.err { color: var(--err); } .msg.warn { color: var(--warn); }
    .hint { font-size: 13px; color: var(--muted); }
    ul.list { list-style: none; margin: 0; padding: 0; }
    ul.list li { border-top: 1px solid var(--line); padding: 14px 0; }
    ul.list li:first-child { border-top: 0; }
    .t { font-weight: 700; color: var(--ink); }
    .meta { font-size: 13px; color: var(--muted); }
    .li-actions { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 8px; }
    .li-actions a, .li-actions button { font-size: 13px; padding: 7px 14px; }
    a.pill { display: inline-block; border-radius: 999px; background: #eef2f9; color: var(--ink); text-decoration: none; font-weight: 700; }
    .status { display: inline-block; font-size: 12px; font-weight: 700; padding: 2px 9px; border-radius: 999px; background: #eef2f9; }
    .status.ok { background: #e7f7ec; color: var(--ok); } .status.run { background: #fff4e0; color: var(--warn); } .status.err { background: #fdecec; color: var(--err); }
    .keybox { display: flex; gap: 10px; }
    .keybox input { flex: 1; }
    [hidden] { display: none !important; }
    .tabs { display: flex; gap: 6px; margin: 0 0 18px; background: #e9edf5; padding: 5px; border-radius: 999px; width: max-content; max-width: 100%; overflow-x: auto; }
    .tabs button { background: none; color: var(--muted); padding: 8px 18px; font-size: 14px; white-space: nowrap; }
    .tabs button.on { background: #fff; color: var(--ink); box-shadow: 0 4px 12px -6px rgba(10,22,48,.3); }
    .ed-fields .row { margin-top: 0; }
    #ed-body { min-height: 360px; font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 13px; }
    .ed-tools { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; margin-bottom: 8px; }
    .ed-tools button { font-size: 13px; padding: 7px 14px; }
    .ed-help { font-size: 13px; color: var(--muted); margin-top: 8px; }
    .ed-help summary { cursor: pointer; }
    .ed-help ul { margin: 8px 0 0; padding-left: 20px; line-height: 1.9; }
    .ed-help b { color: var(--ink); font-family: ui-monospace, Menlo, Consolas, monospace; font-weight: 600; background: #eef2f9; border-radius: 6px; padding: 0 5px; }
    .ed-preview { border: 1px solid var(--line); border-radius: 14px; padding: 18px 20px; max-height: 520px; overflow: auto; background: #fff; }
    .ed-preview h3 { font-size: 17px; color: var(--ink); margin: 22px 0 8px; padding-left: 10px; border-left: 3px solid var(--brand); }
    .ed-preview p { margin: 0 0 12px; font-size: 15px; line-height: 1.9; }
    .ed-preview blockquote { margin: 16px 0; padding: 14px 18px; border-radius: 12px; background: #f0f5fc; font-weight: 700; color: var(--ink); }
    .ed-preview blockquote cite { display: block; margin-top: 6px; font-weight: 400; font-style: normal; font-size: 13px; color: var(--muted); }
    .ed-preview figure { margin: 16px 0; text-align: center; }
    .ed-preview figure img { max-width: 100%; border-radius: 10px; display: block; margin: 0 auto; }
    .ed-preview figcaption { font-size: 13px; color: var(--muted); margin-top: 6px; }
    .run-head { font-size: 14px; font-weight: 700; margin-bottom: 6px; }
    .run-head.ok { color: var(--ok); } .run-head.run { color: var(--warn); } .run-head.err { color: var(--err); }
    #runs li { display: flex; gap: 8px; align-items: baseline; }
    #runs li .t { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 600; }
    .cover-row { display: flex; gap: 14px; align-items: center; margin-top: 6px; flex-wrap: wrap; }
    .cover-row img { width: 160px; aspect-ratio: 16/9; object-fit: cover; border-radius: 10px; background: #eef2f9; }
    /* 新闻封面预览按首页大图的 2:1 裁切显示，裁切位置随下面的选项变化 */
    #ed-cover { width: 200px; aspect-ratio: 2/1; }
    .focus-row { display: grid; grid-template-columns: 170px 1fr; gap: 12px; align-items: start; }
    @media (max-width: 560px) { .focus-row { grid-template-columns: 1fr; } }
    .check { display: flex; gap: 8px; align-items: center; font-weight: 400; }
    .check input { width: auto; }
    .ip-row { display: flex; gap: 12px; align-items: center; }
    .ip-row img { width: 54px; aspect-ratio: 3/4; object-fit: cover; border-radius: 8px; background: #eef2f9; flex-shrink: 0; }
    .ip-row .ip-info { flex: 1; min-width: 0; }
    .ip-row.off img, .ip-row.off .ip-info { opacity: .45; }
    .ip-row .ip-btns { display: flex; gap: 6px; flex-wrap: wrap; justify-content: flex-end; }
    .ip-row .ip-btns button { font-size: 12.5px; padding: 6px 11px; }
    .ip-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .ip-cols h3 { font-size: 14px; color: var(--ink); margin: 14px 0 0; }
    .ip-save { position: sticky; bottom: 12px; display: flex; gap: 12px; align-items: center; background: #fff; border-radius: 999px; padding: 8px 8px 8px 18px; margin-top: 18px; box-shadow: 0 10px 30px -12px rgba(10,22,48,.35); }
    .ip-save .hint { flex: 1; }
    @media (max-width: 560px) { .ip-cols { grid-template-columns: 1fr; } .ip-row { flex-wrap: wrap; } }
    .p-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 16px; margin-top: 14px; }
    .p-item { display: flex; flex-direction: column; gap: 6px; }
    .p-item img { width: 100%; object-fit: cover; border-radius: 10px; background: #eef2f9; }
    .p-item .t { font-size: 13px; line-height: 1.4; }
    .p-item button { font-size: 12.5px; padding: 6px 12px; align-self: flex-start; }
    .p-item.done img { outline: 3px solid var(--ok); }
    .p-dialog { position: fixed; inset: 0; background: rgba(11,20,48,.55); display: grid; place-items: center; padding: 16px; z-index: 10; }
    .p-dialog .card { width: min(640px, 100%); max-height: calc(100vh - 32px); overflow: auto; margin: 0; }
    .p-compare { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-top: 10px; }
    .p-compare figure { margin: 0; text-align: center; font-size: 13px; color: var(--muted); }
    .p-compare img { width: 100%; border-radius: 10px; background: #eef2f9; display: block; margin-bottom: 6px; }
    @media (max-width: 560px) { .row { grid-template-columns: 1fr; } .keybox { flex-direction: column; } }
  </style>
</head>
<body>
  <main class="wrap">
    <h1>官网内容管理</h1>
    <p class="sub">导入公众号文章、修改新闻、更换作品海报。</p>

    <section class="card" id="key-card">
      <h2>请输入密码</h2>
      <p class="hint">密码由网站负责人通过企业微信发给你。</p>
      <form class="keybox" id="unlock">
        <input id="key" type="password" autocomplete="current-password" placeholder="密码" />
        <button id="key-save" type="submit">进入</button>
      </form>
      <label class="hint" style="font-weight:400;display:flex;gap:8px;align-items:center;margin-top:12px"><input type="checkbox" id="remember" checked style="width:auto" /> 在这台电脑上记住（公用电脑请取消勾选）</label>
      <div class="msg" id="key-msg"></div>
    </section>
    <div id="app" hidden>
    <p class="hint" id="key-ok">已解锁 · <a href="#" id="key-change">退出</a></p>
    <nav class="tabs" id="tabs">
      <button type="button" class="on" data-tab="t-news">导入与发布</button>
      <button type="button" data-tab="t-edit">修改新闻</button>
      <button type="button" data-tab="t-ips">IP 作品</button>
      <button type="button" data-tab="t-posters">更换海报</button>
    </nav>

    <div id="t-news">
    <section class="card">
      <h2>导入新闻</h2>
      <form id="import">
        <label for="url">公众号文章链接（可以一次粘贴多条，每行一条）</label>
        <textarea id="url" required rows="4" placeholder="https://mp.weixin.qq.com/s/...&#10;https://mp.weixin.qq.com/s/..." spellcheck="false"></textarea>
        <div class="hint" id="url-count"></div>
        <div class="row">
          <div>
            <label for="section">栏目</label>
            <select id="section"><option value="official">官方新闻</option><option value="media">媒体报道</option></select>
          </div>
          <div>
            <label for="tag">标签（可不填）</label>
            <input id="tag" list="tags" placeholder="如：海外" />
            <datalist id="tags"><option value="海外"></option><option value="短剧"></option><option value="AI"></option><option value="荣誉"></option><option value="影视"></option><option value="网文"></option></datalist>
          </div>
        </div>
        <div class="actions"><button type="submit" id="go">生成草稿</button><span class="hint">约 3–5 分钟后，草稿出现在下面的列表里。</span></div>
        <div class="msg" id="import-msg"></div>
      </form>
    </section>

    <section class="card">
      <h2>待发布的草稿</h2>
      <p class="hint">点「预览」检查内容；没问题点「发布」，几分钟后出现在官网新闻列表。要改文字，到上方「修改新闻」。</p>
      <ul class="list" id="drafts"><li class="hint">加载中…</li></ul>
      <div class="actions"><button type="button" class="ghost" id="refresh">刷新</button><span class="hint" id="refresh-msg" aria-live="polite"></span></div>
    </section>

    </div>

    <div id="t-edit" hidden>
      <section class="card">
        <h2>修改新闻</h2>
        <p class="hint">选一篇新闻（已发布的和草稿都可以），改好后点「保存」，约 3–5 分钟后网站更新。</p>
        <div class="row">
          <div><label for="ed-pick">新闻</label><select id="ed-pick"><option value="">加载中…</option></select></div>
          <div><label for="ed-lang">语言</label><select id="ed-lang"><option value="zh">中文版</option><option value="en">英文版</option></select></div>
        </div>
        <div class="msg" id="ed-msg"></div>
        <form id="ed-form" class="ed-fields" hidden>
          <label for="ed-title">标题</label><input id="ed-title" required />
          <div class="row">
            <div><label for="ed-date">日期</label><input id="ed-date" type="date" required /></div>
            <div><label for="ed-tag">标签（可不填）</label><input id="ed-tag" list="tags" /></div>
          </div>
          <div class="row">
            <div><label for="ed-section">栏目</label><select id="ed-section"><option value="official">官方新闻</option><option value="media">媒体报道</option></select></div>
            <div><label>&nbsp;</label><label class="check"><input type="checkbox" id="ed-draft" /> 草稿（不在新闻列表显示）</label></div>
          </div>
          <label for="ed-summary">导语（标题下面的一两句话）</label><textarea id="ed-summary" rows="2"></textarea>
          <label>封面图</label>
          <div class="cover-row"><img id="ed-cover" alt="" /><button type="button" class="ghost" id="ed-cover-btn">换封面</button><input type="file" id="ed-cover-file" accept="image/*" hidden /><span class="hint" id="ed-cover-note"></span></div>
          <label for="ed-focus">封面裁切时保留</label>
          <div class="focus-row">
            <select id="ed-focus"><option value="">中间（默认）</option><option value="top">上部</option><option value="bottom">下部</option></select>
            <span class="hint">首页和新闻列表会把封面裁成宽幅，上下各少一条。上面的小图就是首页大图的裁切效果；如果标题或人脸被切掉，在这里改成保留上部或下部。只需设置一次，中英文版都生效。</span>
          </div>
          <label for="ed-body">正文</label>
          <div class="ed-tools">
            <button type="button" class="ghost" data-ins="h">＋ 小标题</button>
            <button type="button" class="ghost" data-ins="q">＋ 引语</button>
            <span class="hint">直接改文字就行，段落之间空一行。下面的预览就是网站上的样子。</span>
          </div>
          <textarea id="ed-body" spellcheck="false"></textarea>
          <details class="ed-help">
            <summary>看到奇怪的符号？点这里看说明</summary>
            <ul>
              <li>开头是 <b>##</b> 的一行是<strong>小标题</strong>。</li>
              <li>开头是 <b>&gt;</b> 的行是<strong>引语</strong>；最后一行写 <b>&gt; — 说话人</b>，会显示为出处。</li>
              <li>像 <b>![图注](……jpg)</b> 这样的一行是<strong>一张图片</strong>：方括号里的字是图注；想挪位置就整行剪切、粘贴到别处；不要这张图就删掉整行。</li>
            </ul>
          </details>
          <label>预览</label>
          <div class="ed-preview" id="ed-preview"></div>
          <div class="actions"><button type="submit" id="ed-save">保存</button><a class="pill" id="ed-view" target="_blank" rel="noopener" style="padding:11px 20px">在网站上查看</a></div>
        </form>
      </section>
    </div>

    <div id="t-ips" hidden>
      <section class="card">
        <h2>IP 作品</h2>
        <p class="hint">「IP 与作品」页的明星 IP 墙和首页的 IP 精选。列表顺序就是网站上的顺序；隐藏的作品不在网站上显示（之后可以再打开）。改完点最下面的「保存」。</p>
        <ul class="list" id="ip-list" style="margin-top:10px"><li class="hint">加载中…</li></ul>
        <div class="actions"><button type="button" class="ghost" id="ip-add">＋ 新增作品</button></div>
        <div class="msg" id="ip-msg"></div>

        <form id="ip-form" hidden>
          <h2 id="ip-form-title" style="margin-top:22px">编辑作品</h2>
          <div class="cover-row"><img id="ip-poster" alt="" style="width:120px;aspect-ratio:3/4" /><button type="button" class="ghost" id="ip-poster-btn">选择海报</button><input type="file" id="ip-poster-file" accept="image/*" hidden /><span class="hint" id="ip-poster-note">竖版海报，自动裁成 3:4</span></div>
          <div class="ip-cols">
            <div><h3>中文</h3>
              <label for="ip-zh-title">作品名</label><input id="ip-zh-title" />
              <label for="ip-zh-genre">类型</label><input id="ip-zh-genre" list="ip-genres-zh" placeholder="如：短剧" />
              <label for="ip-zh-forms">形态（用顿号隔开）</label><input id="ip-zh-forms" placeholder="如：网文、微短剧" />
              <label for="ip-zh-tags">亮点标签（每行一个，建议 1–2 个）</label><textarea id="ip-zh-tags" rows="2"></textarea>
              <label for="ip-zh-intro">简介</label><textarea id="ip-zh-intro" rows="4"></textarea>
            </div>
            <div><h3>English</h3>
              <label for="ip-en-title">Title</label><input id="ip-en-title" />
              <label for="ip-en-genre">Genre</label><input id="ip-en-genre" list="ip-genres-en" placeholder="e.g. Microdrama" />
              <label for="ip-en-forms">Formats (comma separated)</label><input id="ip-en-forms" placeholder="e.g. Webnovel, Microdrama" />
              <label for="ip-en-tags">Highlight tags (one per line)</label><textarea id="ip-en-tags" rows="2"></textarea>
              <label for="ip-en-intro">Intro</label><textarea id="ip-en-intro" rows="4"></textarea>
            </div>
          </div>
          <datalist id="ip-genres-zh"></datalist><datalist id="ip-genres-en"></datalist>
          <p class="hint" style="margin-top:10px">作品详情页上的数据卡片和大事记暂时不能在这里改（已有的会保留）；新作品的详情页显示简介和标签。</p>
          <div class="actions"><button type="submit">确定</button><button type="button" class="ghost" id="ip-cancel">取消</button></div>
        </form>

        <div class="ip-save" id="ip-savebar" hidden><span class="hint" id="ip-dirty">有改动还没保存</span><button type="button" id="ip-save">保存</button></div>
      </section>
    </div>

    <div id="t-posters" hidden>
      <section class="card">
        <h2>更换海报</h2>
        <p class="hint">找到要换的海报，点「更换」选一张新图。新图会自动裁成和原来一样的比例（从中间裁），确认后约 3–5 分钟网站更新。</p>
        <input id="p-search" placeholder="搜索作品名，如：罗小黑" style="margin-top:10px" />
        <div class="p-grid" id="p-grid"><p class="hint">加载中…</p></div>
        <details style="margin-top:18px"><summary class="hint">其他图片（网站上暂未用到）</summary><div class="p-grid" id="p-grid-unused"></div></details>
        <input type="file" id="p-file" accept="image/*" hidden />
      </section>
    </div>

    <section class="card">
      <h2>最近的操作</h2>
      <div class="run-head" id="run-head"></div>
      <ul class="list" id="runs"><li class="hint">加载中…</li></ul>
    </section>
    </div>
    <div class="p-dialog" id="p-dialog" hidden>
      <div class="card">
        <h2 id="p-d-title">更换海报</h2>
        <div class="p-compare"><figure><img id="p-d-old" alt="" />原来</figure><figure><img id="p-d-new" alt="" />换成（已裁好）</figure></div>
        <p class="hint" id="p-d-note"></p>
        <div class="actions"><button type="button" id="p-d-ok">确认更换</button><button type="button" class="ghost" id="p-d-cancel">取消</button></div>
        <div class="msg" id="p-d-msg"></div>
      </div>
    </div>
  </main>

  <script is:inline define:vars={{ base, REPO, LOCKED }}>
    const API = `https://api.github.com/repos/${REPO}`;
    const $ = (id) => document.getElementById(id);
    // 解锁后的钥匙：勾选“记住”时存在本机浏览器，否则只在本次打开期间有效
    let mem = '';
    const store = {
      get: () => { if (mem) return mem; try { return localStorage.getItem('col-news-key') || sessionStorage.getItem('col-news-key') || ''; } catch { return ''; } },
      set: (v, remember) => { mem = v; try { localStorage.removeItem('col-news-key'); sessionStorage.removeItem('col-news-key'); if (v) (remember ? localStorage : sessionStorage).setItem('col-news-key', v); } catch {} },
    };
    const b64 = (s) => Uint8Array.from(atob(s), (c) => c.charCodeAt(0));
    async function unlock(pw) {
      if (!LOCKED) throw new Error('发布页还没有设置密码，请联系网站负责人。');
      const material = await crypto.subtle.importKey('raw', new TextEncoder().encode(pw), 'PBKDF2', false, ['deriveKey']);
      const key = await crypto.subtle.deriveKey({ name: 'PBKDF2', salt: b64(LOCKED.salt), iterations: LOCKED.iter, hash: 'SHA-256' }, material, { name: 'AES-GCM', length: 256 }, false, ['decrypt']);
      try { return new TextDecoder().decode(await crypto.subtle.decrypt({ name: 'AES-GCM', iv: b64(LOCKED.iv) }, key, b64(LOCKED.data))); }
      catch { throw new Error('密码不对，请再试一次。'); }
    }
    const esc = (s) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    const say = (el, text, kind = '') => { el.textContent = text; el.className = `msg ${kind}`; };

    async function gh(path, opts = {}) {
      const key = store.get();
      if (!key) throw new Error('请先在上方填入钥匙。');
      const r = await fetch(`${API}${path}`, { ...opts, headers: { Accept: 'application/vnd.github+json', Authorization: `Bearer ${key}`, 'X-GitHub-Api-Version': '2022-11-28', ...(opts.headers || {}) } });
      if (r.status === 401) { store.set(''); throw new Error('发布页的钥匙已过期或失效，请联系网站负责人重新设置。'); }
      const fail = (msg) => Object.assign(new Error(msg), { status: r.status });
      if (r.status === 403 || r.status === 404) throw fail('钥匙没有权限，请联系网站负责人检查设置。');
      if (!r.ok) throw fail(`GitHub 返回错误（${r.status}），请稍后再试。`);
      return r.status === 204 ? null : r.json();
    }
    const runWorkflow = (file, inputs) => gh(`/actions/workflows/${file}/dispatches`, { method: 'POST', body: JSON.stringify({ ref: 'main', inputs }) });

    // 密码
    function showKey() { const has = !!store.get(); $('key-card').hidden = has; $('app').hidden = !has; if (has) { loadDrafts(); loadRuns(); } }
    $('unlock').onsubmit = async (e) => {
      e.preventDefault();
      const pw = $('key').value;
      if (!pw) return;
      $('key-save').disabled = true; say($('key-msg'), '正在解锁…');
      try {
        const token = await unlock(pw);
        store.set(token, $('remember').checked);
        await gh('/actions/runs?per_page=1');
        say($('key-msg'), ''); $('key').value = ''; showKey();
      } catch (err) { store.set(''); say($('key-msg'), err.message, 'err'); }
      finally { $('key-save').disabled = false; }
    };
    $('key-change').onclick = (e) => { e.preventDefault(); store.set(''); showKey(); };

    // 导入：从粘贴的文字里找出所有公众号链接（去重），条数显示在输入框下面
    const links = () => [...new Set($('url').value.match(/https:\/\/mp\.weixin\.qq\.com\/s[^\s，,；;]*/g) || [])];
    $('url').oninput = () => { const n = links().length; $('url-count').textContent = n ? `识别到 ${n} 条链接` : ''; };
    $('import').onsubmit = async (e) => {
      e.preventDefault();
      const urls = links();
      if (!urls.length) return say($('import-msg'), '请粘贴公众号文章链接（以 https://mp.weixin.qq.com/s 开头）。', 'err');
      $('go').disabled = true;
      try {
        // 多条链接一起交给一次导入：只更新一次网站，也不会互相冲突
        await runWorkflow('news-import.yml', { url: urls.join(' '), section: $('section').value, tag: $('tag').value.trim() });
        say($('import-msg'), `已提交 ${urls.length} 篇！约 ${urls.length > 3 ? '5–10' : '3–5'} 分钟后草稿会出现在下面的列表里（点「刷新」）。已经导入过的会自动跳过。`, 'ok');
        $('url-count').textContent = '';
        $('url').value = ''; $('tag').value = '';
        setTimeout(loadRuns, 4000);
      } catch (err) { say($('import-msg'), err.message, 'err'); }
      finally { $('go').disabled = false; }
    };

    // 已点过「发布/删除」的草稿：网站更新完（约 3–5 分钟）之前，草稿还会留在列表里；记下来防止重复点。
    function pending() {
      try {
        const all = JSON.parse(localStorage.getItem('news-pending') || '{}'), now = Date.now();
        for (const k in all) if (now - all[k].t > 15 * 60 * 1000) delete all[k];
        return all;
      } catch { return {}; }
    }
    function markPending(id, act) {
      try { const all = pending(); all[id] = { act, t: Date.now() }; localStorage.setItem('news-pending', JSON.stringify(all)); } catch {}
    }

    // 草稿列表（网站每次更新时生成的 news/drafts.json）
    async function loadDrafts() {
      const ul = $('drafts');
      try {
        const r = await fetch(`${base}/news/drafts.json?t=${Date.now()}`, { cache: 'no-store' });
        const { drafts } = await r.json();
        const sent = pending();
        if (!drafts.length) { ul.innerHTML = '<li class="hint">目前没有草稿。</li>'; return; }
        ul.innerHTML = drafts.map((d) => `
          <li>
            <div class="t">${esc(d.title)}</div>
            <div class="meta">${esc(d.date)}${d.tag ? ' · ' + esc(d.tag) : ''} · 编号 ${esc(d.id)} · ${d.hasEn ? '有英文版' : '只有中文版'}</div>
            <div class="li-actions">
              <a class="pill" href="${base}/news/${esc(d.id)}/" target="_blank" rel="noopener">预览</a>
              ${d.hasEn ? `<a class="pill" href="${base}/en/news/${esc(d.id)}/" target="_blank" rel="noopener">英文预览</a>` : ''}
              ${sent[d.id] ? `<button type="button" disabled>${sent[d.id].act === 'publish' ? '已提交发布，网站更新中…' : '已提交删除，网站更新中…'}</button>` : `
              <button type="button" data-act="publish" data-id="${esc(d.id)}">发布</button>
              <button type="button" class="danger" data-act="delete" data-id="${esc(d.id)}">删除草稿</button>`}
            </div>
          </li>`).join('');
      } catch { ul.innerHTML = '<li class="hint">草稿列表暂时读不到，请稍后点「刷新」。</li>'; }
    }
    $('drafts').onclick = async (e) => {
      const b = e.target.closest('button[data-act]');
      if (!b) return;
      const act = b.dataset.act, id = b.dataset.id;
      if (act === 'delete' && !confirm(`确定删除草稿 ${id}？`)) return;
      if (act === 'publish' && !confirm(`确定发布这篇新闻？发布后几分钟内出现在官网。`)) return;
      b.disabled = true;
      try {
        await runWorkflow('news-publish.yml', { id, action: act });
        markPending(id, act);
        b.parentElement.querySelectorAll('button').forEach((x) => { x.disabled = true; });
        b.textContent = act === 'publish' ? '已提交发布，网站更新中…' : '已提交删除，网站更新中…';
        setTimeout(loadRuns, 4000);
      } catch (err) { alert(err.message); b.disabled = false; }
    };

    // 最近的操作：列出网站内容的每一次改动（GitHub 上的提交记录），并标出是否已经上线。
    // 一次改动会触发一次「网站更新」；连续几次改动时，前面没跑完的更新会被后面的取代，这是正常的，所以不单独列出更新任务。
    const NAMES = { 'news-import.yml': '导入新闻', 'news-publish.yml': '发布/删除新闻', 'deploy.yml': '网站更新' };
    const ours = /^(修改新闻|更换|更新 IP|发布新闻|删除新闻|新闻草稿)/;
    async function loadRuns() {
      const ul = $('runs'), head = $('run-head');
      if (!store.get()) return;
      try {
        const [{ workflow_runs: runs }, commits] = await Promise.all([gh('/actions/runs?per_page=30'), gh('/commits?sha=main&per_page=10')]);
        const file = (w) => w.path.split('/').pop();
        const deploys = runs.filter((w) => file(w) === 'deploy.yml');
        const live = deploys.find((w) => w.conclusion === 'success');
        const liveTime = live ? Date.parse(live.head_commit?.timestamp || live.created_at) : 0;
        const lastDone = deploys.find((w) => w.status === 'completed' && w.conclusion !== 'cancelled');
        const busy = runs.some((w) => NAMES[file(w)] && w.status !== 'completed');
        const fmt = (t) => new Date(t).toLocaleString('zh-CN', { month: 'numeric', day: 'numeric', hour: '2-digit', minute: '2-digit' });

        const items = [];
        for (const c of commits) {
          const msg = c.commit.message.split('\n')[0], t = Date.parse(c.commit.committer.date);
          const label = ours.test(msg) ? msg : '网站程序更新（技术人员）';
          if (items.length && items.at(-1).label === label && !ours.test(msg)) continue; // 连续的程序更新只列一条
          items.push({ t, label, st: t <= liveTime ? ['ok', '已上线'] : busy ? ['run', '上线中'] : ['err', '未上线'] });
        }
        // 还没产生改动的任务：正在处理的导入/发布，以及最近 3 天失败的
        for (const w of runs) {
          const f = file(w);
          if (f === 'deploy.yml' || !NAMES[f]) continue;
          const t = Date.parse(w.created_at);
          if (w.status !== 'completed') items.push({ t, label: `${NAMES[f]}（处理中）`, st: ['run', '处理中'] });
          else if (w.conclusion === 'failure' && Date.now() - t < 3 * 864e5) items.push({ t, label: `${NAMES[f]}没有成功`, st: ['err', '失败'], fail: true });
        }
        items.sort((a, b) => b.t - a.t);

        if (busy) { head.className = 'run-head run'; head.textContent = '网站正在更新，约 3–5 分钟后生效。'; }
        else if (lastDone && lastDone.conclusion === 'failure') { head.className = 'run-head err'; head.textContent = '最近一次网站更新失败，请截图发给网站负责人。'; }
        else { head.className = 'run-head ok'; head.textContent = `网站已是最新${live ? `（${fmt(live.updated_at)} 更新）` : ''}。`; }

        ul.innerHTML = items.slice(0, 8).map((x) => `<li><span class="status ${x.st[0]}">${x.st[1]}</span><span class="t" title="${esc(x.label)}">${esc(x.label)}</span><span class="meta">${fmt(x.t)}${x.fail ? ' · 请截图发给网站负责人' : ''}</span></li>`).join('') || '<li class="hint">还没有记录。</li>';
        if (busy) setTimeout(() => { loadRuns(); loadDrafts(); }, 20000);
      } catch (err) { ul.innerHTML = `<li class="hint">${esc(err.message)}</li>`; }
    }
    $('refresh').onclick = async () => {
      const b = $('refresh'), msg = $('refresh-msg');
      b.disabled = true; b.textContent = '刷新中…'; msg.textContent = '';
      $('drafts').classList.add('busy'); $('runs').classList.add('busy');
      const t0 = Date.now();
      await Promise.allSettled([loadDrafts(), loadRuns()]);
      await new Promise((r) => setTimeout(r, Math.max(0, 500 - (Date.now() - t0)))); // 太快时也让人看得出刷过了
      $('drafts').classList.remove('busy'); $('runs').classList.remove('busy');
      b.disabled = false; b.textContent = '刷新';
      msg.textContent = '已刷新 ' + new Date().toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
    };

    // ---------- 分页 ----------
    const loaded = {};
    $('tabs').onclick = (e) => {
      const b = e.target.closest('button[data-tab]');
      if (!b) return;
      for (const x of $('tabs').querySelectorAll('button')) { x.classList.toggle('on', x === b); $(x.dataset.tab).hidden = x !== b; }
      if (b.dataset.tab === 't-edit' && !loaded.edit) { loaded.edit = true; loadNewsList(); }
      if (b.dataset.tab === 't-posters' && !loaded.posters) { loaded.posters = true; loadPosters(); }
      if (b.dataset.tab === 't-ips' && !loaded.ips) { loaded.ips = true; loadIps(); }
    };

    // ---------- 直接修改仓库里的文件（GitHub Contents 接口；需要钥匙有 Contents 读写权限） ----------
    const NO_WRITE = '钥匙还没有修改文件的权限。请网站负责人在 GitHub → Settings → Developer settings → Fine-grained tokens 里编辑这把钥匙，加上「Contents: Read and write」（钥匙和密码都不用换）。';
    const repoPath = (p) => p.split('/').map(encodeURIComponent).join('/');
    const fromB64 = (c) => new TextDecoder().decode(Uint8Array.from(atob(c.replace(/\s/g, '')), (ch) => ch.charCodeAt(0)));
    function toB64(bytes) { let s = ''; for (let i = 0; i < bytes.length; i += 0x8000) s += String.fromCharCode(...bytes.subarray(i, i + 0x8000)); return btoa(s); }
    const textB64 = (t) => toB64(new TextEncoder().encode(t));
    async function getFile(p) {
      try { return await gh(`/contents/${repoPath(p)}?ref=main&t=${Date.now()}`); }
      catch (e) { if (e.status === 404) return null; throw e; }
    }
    async function putFile(p, content, message) {
      for (let attempt = 0; attempt < 2; attempt++) {
        const cur = await getFile(p);
        try {
          return await gh(`/contents/${repoPath(p)}`, { method: 'PUT', body: JSON.stringify({ message, content, branch: 'main', ...(cur ? { sha: cur.sha } : {}) }) });
        } catch (e) {
          if (e.status === 403 || e.status === 404) throw new Error(NO_WRITE);
          if ((e.status === 409 || e.status === 422) && attempt === 0) continue; // 同时有别的更新：取最新版本再试一次
          throw e;
        }
      }
    }
    // 图片：裁成指定比例（从中间裁）、限制宽度，转成 JPEG（base64）
    async function prepImage(file, ratio, maxW) {
      const img = await new Promise((res, rej) => { const i = new Image(); i.onload = () => res(i); i.onerror = () => rej(new Error('这个文件打不开，请换一张 JPG 或 PNG 图片。')); i.src = URL.createObjectURL(file); });
      let sw = img.naturalWidth, sh = img.naturalHeight, sx = 0, sy = 0;
      if (ratio) { if (sw / sh > ratio) { const w = sh * ratio; sx = (sw - w) / 2; sw = w; } else { const h = sw / ratio; sy = (sh - h) / 2; sh = h; } }
      const w = Math.round(Math.min(sw, maxW)), h = Math.round(w * sh / sw);
      const c = document.createElement('canvas'); c.width = w; c.height = h;
      const g = c.getContext('2d'); g.fillStyle = '#fff'; g.fillRect(0, 0, w, h); g.drawImage(img, sx, sy, sw, sh, 0, 0, w, h);
      let q = 0.86, url = c.toDataURL('image/jpeg', q);
      while (url.length > 1.2e6 && q > 0.5) { q -= 0.08; url = c.toDataURL('image/jpeg', q); }
      return { url, b64: url.split(',')[1], w, h };
    }
    const afterSave = '已保存！约 3–5 分钟后网站更新（浏览器可能还会显示旧版几分钟，刷新即可）。';

    // ---------- 修改新闻 ----------
    let ed = null; // 正在编辑的文件 { id, lang, path, order, fm, cover }
    async function loadNewsList() {
      try {
        const r = await fetch(`${base}/news/all.json?t=${Date.now()}`, { cache: 'no-store' });
        const list = (await r.json()).news;
        $('ed-pick').innerHTML = '<option value="">— 选择一篇新闻 —</option>' + list.map((n) => `<option value="${esc(n.id)}">${esc(n.date)}　${n.draft ? '【草稿】' : ''}${esc(n.title)}</option>`).join('');
      } catch { say($('ed-msg'), '新闻列表暂时读不到，请稍后再试。', 'err'); }
    }
    function parseMd(text) {
      const m = text.replace(/^﻿/, '').match(/^---\s*\n([\s\S]*?)\n---[ \t]*\n?([\s\S]*)$/);
      if (!m) return { order: [], fm: {}, body: text };
      const order = [], fm = {};
      for (const line of m[1].split('\n')) {
        const i = line.indexOf(':');
        if (i <= 0) continue;
        const k = line.slice(0, i).trim(); let v = line.slice(i + 1).trim();
        if (v.startsWith('"')) { try { v = JSON.parse(v); } catch { v = v.slice(1, -1); } }
        order.push(k); fm[k] = v;
      }
      return { order, fm, body: m[2].replace(/^\n+/, ''), lead: /^\n/.test(m[2]) ? '\n' : '' };
    }
    function buildMd(order, fm, body, lead = '\n') {
      const keys = ['date', 'section', 'title', 'tag', 'image', 'focus', 'summary', 'link', 'source', 'wechat', 'draft'];
      const all = [...new Set([...keys.filter((k) => order.includes(k) || fm[k]), ...order])];
      const lines = all.filter((k) => fm[k] !== undefined && fm[k] !== '' && fm[k] !== false && fm[k] !== 'false').map((k) => {
        const v = fm[k];
        if (v === true || v === 'true') return `${k}: true`;
        return `${k}: ${/^(date|section|image|focus|link|wechat)$/.test(k) ? v : JSON.stringify(String(v))}`;
      });
      return `---\n${lines.join('\n')}\n---\n${body.trim() ? lead + body.trim() + '\n' : ''}`;
    }
    async function openEditor() {
      const id = $('ed-pick').value, lang = $('ed-lang').value;
      $('ed-form').hidden = true; say($('ed-msg'), '');
      if (!id) return;
      say($('ed-msg'), '读取中…');
      try {
        const path = `src/news/${id}/${lang}.md`;
        const f = await getFile(path);
        let parsed, isNew = false;
        if (f) parsed = parseMd(fromB64(f.content));
        else if (lang === 'en') {
          // 还没有英文版：沿用中文版的日期、栏目、封面、外链和草稿状态，标题和正文留空待填
          const zf = await getFile(`src/news/${id}/zh.md`);
          const z = zf ? parseMd(fromB64(zf.content)) : { order: [], fm: {} };
          const keep = {}; for (const k of ['date', 'section', 'image', 'focus', 'link', 'draft']) if (z.fm[k]) keep[k] = z.fm[k];
          if (z.fm.source) keep.source = 'COL Group';
          parsed = { order: Object.keys(keep), fm: keep, body: '' }; isNew = true;
        } else throw new Error('找不到这篇新闻的文件，可能已被删除。');
        ed = { id, lang, path, order: parsed.order, fm: parsed.fm, lead: parsed.lead ?? '\n', cover: null };
        const fm = parsed.fm;
        $('ed-title').value = fm.title || ''; $('ed-date').value = fm.date || ''; $('ed-tag').value = fm.tag || '';
        $('ed-section').value = fm.section || 'official'; $('ed-draft').checked = fm.draft === true || fm.draft === 'true';
        $('ed-summary').value = fm.summary || ''; $('ed-body').value = parsed.body; renderPreview();
        $('ed-focus').value = fm.focus === 'top' || fm.focus === 'bottom' ? fm.focus : ''; showFocus();
        $('ed-cover').src = fm.image ? `${base}/news/${fm.image}.jpg?t=${Date.now()}` : ''; $('ed-cover-note').textContent = fm.image ? '' : '（没有封面）';
        const ext = !!fm.link;
        $('ed-view').hidden = ext || isNew; $('ed-view').href = `${base}${lang === 'en' ? '/en' : ''}/news/${id}/`;
        $('ed-form').hidden = false;
        say($('ed-msg'), isNew ? '这篇还没有英文版：填好标题、导语和正文后保存，就会生成英文版。' : ext ? '这条新闻链接到外部原文，网站上只显示标题、日期和封面。' : '', isNew ? 'warn' : '');
      } catch (e) { say($('ed-msg'), e.message, 'err'); }
    }
    $('ed-pick').onchange = openEditor; $('ed-lang').onchange = openEditor;
    // 封面裁切位置：预览图跟着选项变
    function showFocus() { $('ed-cover').style.objectPosition = { top: '50% 0', bottom: '50% 100%' }[$('ed-focus').value] || '50% 50%'; }
    $('ed-focus').onchange = showFocus;
    $('ed-cover-btn').onclick = () => $('ed-cover-file').click();
    $('ed-cover-file').onchange = async () => {
      const file = $('ed-cover-file').files[0]; $('ed-cover-file').value = '';
      if (!file || !ed) return;
      try { ed.cover = await prepImage(file, 0, 1200); $('ed-cover').src = ed.cover.url; $('ed-cover-note').textContent = '新封面，保存后生效'; }
      catch (e) { say($('ed-msg'), e.message, 'err'); }
    };
    $('ed-form').onsubmit = async (e) => {
      e.preventDefault();
      if (!ed) return;
      const fm = ed.fm;
      fm.title = $('ed-title').value.trim(); fm.date = $('ed-date').value; fm.tag = $('ed-tag').value.trim();
      fm.section = $('ed-section').value; fm.draft = $('ed-draft').checked; fm.focus = $('ed-focus').value; fm.summary = $('ed-summary').value.trim().replace(/\s*\n\s*/g, ' ');
      const body = $('ed-body').value;
      if (!fm.title || !fm.date) return say($('ed-msg'), '标题和日期不能空。', 'err');
      if (!fm.link && !body.trim()) return say($('ed-msg'), '正文不能空。', 'err');
      $('ed-save').disabled = true; say($('ed-msg'), '保存中…');
      try {
        if (ed.cover) {
          const img = `${ed.id}/cover`;
          await putFile(`public/news/${img}.jpg`, ed.cover.b64, `更换新闻封面：${fm.title}`);
          fm.image = img; ed.cover = null;
        }
        await putFile(ed.path, textB64(buildMd(ed.order, fm, body, ed.lead)), `修改新闻：${fm.title}`);
        say($('ed-msg'), afterSave, 'ok');
        $('ed-view').hidden = !!fm.link;
        setTimeout(loadRuns, 4000);
      } catch (err) { say($('ed-msg'), err.message, 'err'); }
      finally { $('ed-save').disabled = false; }
    };

    // ---------- 更换海报 ----------
    let posters = [], pTarget = null, pNew = null, pVer = 0;
    async function loadPosters() {
      try {
        const r = await fetch(`${base}/posters.json?t=${Date.now()}`, { cache: 'no-store' });
        const d = await r.json(); posters = d.posters; pVer = Date.parse(d.updated);
        renderPosters();
      } catch { $('p-grid').innerHTML = '<p class="hint">海报列表暂时读不到，请稍后再试。</p>'; }
    }
    const pSrc = (p) => p.done || `${base}/${p.file}?v=${pVer}`;
    function renderPosters() {
      const q = $('p-search').value.trim().toLowerCase();
      const item = (p) => `<div class="p-item${p.done ? ' done' : ''}">
          <img src="${pSrc(p)}" alt="" loading="lazy" style="aspect-ratio:${p.w}/${p.h}" />
          <div class="t">${esc(p.used.filter((t) => !t.endsWith('）')).join('、') || p.used.join('、') || p.name)}</div>
          <div class="meta">${p.w}×${p.h}${p.done ? ' · 已更换' : ''}</div>
          <button type="button" class="ghost" data-file="${esc(p.file)}">更换</button></div>`;
      const match = (p) => !q || p.name.toLowerCase().includes(q) || p.used.some((t) => t.toLowerCase().includes(q));
      const used = posters.filter((p) => p.used.length && match(p)), unused = posters.filter((p) => !p.used.length && match(p));
      $('p-grid').innerHTML = used.map(item).join('') || '<p class="hint">没有找到。</p>';
      $('p-grid-unused').innerHTML = unused.map(item).join('') || '<p class="hint">没有。</p>';
    }
    $('p-search').oninput = renderPosters;
    document.addEventListener('click', (e) => {
      const b = e.target.closest('.p-item button[data-file]');
      if (!b) return;
      pTarget = posters.find((p) => p.file === b.dataset.file);
      $('p-file').click();
    });
    $('p-file').onchange = async () => {
      const file = $('p-file').files[0]; $('p-file').value = '';
      if (!file || !pTarget) return;
      try {
        pNew = await prepImage(file, pTarget.w / pTarget.h, 900);
        $('p-d-title').textContent = `更换海报：${pTarget.used[0] || pTarget.name}`;
        $('p-d-old').src = pSrc(pTarget); $('p-d-new').src = pNew.url;
        $('p-d-note').textContent = `新图 ${pNew.w}×${pNew.h}` + (pNew.w < pTarget.w * 0.75 ? '。注意：新图比原来模糊，建议找清晰一点的图。' : '。');
        say($('p-d-msg'), ''); $('p-d-ok').disabled = false; $('p-dialog').hidden = false;
      } catch (e) { alert(e.message); }
    };
    $('p-d-cancel').onclick = () => { $('p-dialog').hidden = true; pNew = null; };
    $('p-d-ok').onclick = async () => {
      if (!pTarget || !pNew) return;
      $('p-d-ok').disabled = true; say($('p-d-msg'), '上传中…');
      try {
        await putFile(`public/${pTarget.file}`, pNew.b64, `更换海报：${pTarget.used[0] || pTarget.name}`);
        pTarget.done = pNew.url; pTarget.w = pNew.w; pTarget.h = pNew.h;
        $('p-dialog').hidden = true; renderPosters();
        setTimeout(loadRuns, 4000);
        alert(afterSave);
      } catch (err) { say($('p-d-msg'), err.message, 'err'); $('p-d-ok').disabled = false; }
    };

    // 正文预览（与网站详情页同样的规则：空行分段，## 小标题，> 引语，![图注](路径) 图片）
    function renderPreview() {
      const out = [];
      for (const raw of $('ed-body').value.split(/\n\s*\n/)) {
        const c = raw.trim();
        if (!c) continue;
        const img = c.match(/^!\[([^\]]*)\]\(([^)\s]+)\)$/);
        if (img) { out.push(`<figure><img src="${base}/news/${esc(img[2])}" alt="" />${img[1] ? `<figcaption>${esc(img[1])}</figcaption>` : ''}</figure>`); continue; }
        if (/^#{2,3}\s/.test(c)) { out.push(`<h3>${esc(c.replace(/^#+\s*/, ''))}</h3>`); continue; }
        if (c.startsWith('>')) {
          const lines = c.split('\n').map((l) => l.replace(/^>\s?/, '').trim()).filter(Boolean);
          const last = lines.at(-1), by = lines.length > 1 && /^[—–-]{1,2}\s*/.test(last) ? last.replace(/^[—–-]{1,2}\s*/, '') : '';
          out.push(`<blockquote>“${esc((by ? lines.slice(0, -1) : lines).join(' '))}”${by ? `<cite>— ${esc(by)}</cite>` : ''}</blockquote>`);
          continue;
        }
        out.push(`<p>${esc(c.replace(/\s*\n\s*/g, ' '))}</p>`);
      }
      $('ed-preview').innerHTML = out.join('') || '<p class="hint">（正文是空的）</p>';
    }
    $('ed-body').addEventListener('input', renderPreview);
    // 插入小标题 / 引语：放在光标所在的位置，前后自动空行，并选中占位文字方便直接改
    document.querySelector('.ed-tools').onclick = (e) => {
      const b = e.target.closest('button[data-ins]');
      if (!b) return;
      const ta = $('ed-body'), v = ta.value;
      const [snippet, ph] = b.dataset.ins === 'h' ? ['## 小标题', '小标题'] : ['> 引语内容\n> — 说话人', '引语内容'];
      let at = ta.selectionEnd ?? v.length;
      const nl = v.indexOf('\n\n', at); at = nl === -1 ? v.length : nl; // 插到当前段落后面
      const before = v.slice(0, at).replace(/\s*$/, ''), after = v.slice(at).replace(/^\s*/, '');
      ta.value = `${before}${before ? '\n\n' : ''}${snippet}\n\n${after}`;
      const start = before.length + (before ? 2 : 0) + snippet.indexOf(ph);
      ta.focus(); ta.setSelectionRange(start, start + ph.length);
      renderPreview();
    };

    // ---------- IP 作品（src/data/ips.json，一个文件存全部作品，中英文在同一条里） ----------
    let ipData = null, ipEdit = null, ipPosters = {}, ipChanges = [];
    const IP_FILE = 'src/data/ips.json';
    async function loadIps() {
      try {
        const f = await getFile(IP_FILE);
        if (!f) throw new Error('找不到作品数据文件。');
        ipData = JSON.parse(fromB64(f.content)); ipPosters = {}; ipChanges = [];
        renderIps();
      } catch (e) { $('ip-list').innerHTML = `<li class="hint">${esc(e.message)}</li>`; }
    }
    const ipPosterSrc = (w) => ipPosters[w.poster]?.url || (w.poster ? `${base}/posters/${w.poster}.jpg` : '');
    function renderIps() {
      const works = ipData.works;
      $('ip-list').innerHTML = works.map((w, i) => `<li class="ip-row${w.hidden ? ' off' : ''}">
          <img src="${ipPosterSrc(w)}" alt="" loading="lazy" />
          <div class="ip-info"><div class="t">${esc(w.zh?.title || w.slug)}</div><div class="meta">${esc(w.en?.title || '（缺英文名）')} · ${esc(w.zh?.genre || '')}${w.hidden ? ' · 已隐藏' : ''}</div></div>
          <div class="ip-btns">
            <button type="button" class="ghost" data-ip="up" data-i="${i}" ${i === 0 ? 'disabled' : ''} aria-label="上移">↑</button>
            <button type="button" class="ghost" data-ip="down" data-i="${i}" ${i === works.length - 1 ? 'disabled' : ''} aria-label="下移">↓</button>
            <button type="button" class="ghost" data-ip="toggle" data-i="${i}">${w.hidden ? '显示' : '隐藏'}</button>
            <button type="button" class="ghost" data-ip="edit" data-i="${i}">编辑</button>
          </div></li>`).join('');
      const g = (l) => [...new Set(works.map((w) => w[l]?.genre).filter(Boolean))].map((x) => `<option value="${esc(x)}"></option>`).join('');
      $('ip-genres-zh').innerHTML = g('zh'); $('ip-genres-en').innerHTML = g('en');
      $('ip-savebar').hidden = !ipChanges.length;
      $('ip-dirty').textContent = ipChanges.length ? `有 ${ipChanges.length} 处改动还没保存` : '';
    }
    const changed = (what) => { ipChanges.push(what); renderIps(); say($('ip-msg'), ''); };
    $('ip-list').onclick = (e) => {
      const b = e.target.closest('button[data-ip]');
      if (!b) return;
      const i = Number(b.dataset.i), works = ipData.works, w = works[i];
      if (b.dataset.ip === 'up' && i > 0) { works.splice(i - 1, 0, works.splice(i, 1)[0]); changed(`调整顺序`); }
      if (b.dataset.ip === 'down' && i < works.length - 1) { works.splice(i + 1, 0, works.splice(i, 1)[0]); changed(`调整顺序`); }
      if (b.dataset.ip === 'toggle') { w.hidden = !w.hidden; changed(`${w.hidden ? '隐藏' : '显示'}《${w.zh?.title}》`); }
      if (b.dataset.ip === 'edit') openIp(w);
    };
    const lines = (v) => v.split('\n').map((x) => x.trim()).filter(Boolean);
    const parts = (v) => v.split(/[、,，;；]/).map((x) => x.trim()).filter(Boolean);
    function openIp(w) {
      ipEdit = w ? { w, isNew: false } : { w: { slug: '', poster: '', hidden: false, zh: {}, en: {} }, isNew: true };
      const z = ipEdit.w.zh || {}, n = ipEdit.w.en || {};
      $('ip-form-title').textContent = ipEdit.isNew ? '新增作品' : `编辑：${z.title || ipEdit.w.slug}`;
      $('ip-zh-title').value = z.title || ''; $('ip-zh-genre').value = z.genre || ''; $('ip-zh-forms').value = (z.forms || []).join('、');
      $('ip-zh-tags').value = (z.tags || []).join('\n'); $('ip-zh-intro').value = z.intro || '';
      $('ip-en-title').value = n.title || ''; $('ip-en-genre').value = n.genre || ''; $('ip-en-forms').value = (n.forms || []).join(', ');
      $('ip-en-tags').value = (n.tags || []).join('\n'); $('ip-en-intro').value = n.intro || '';
      $('ip-poster').src = ipPosterSrc(ipEdit.w); ipEdit.poster = null;
      $('ip-poster-note').textContent = ipEdit.isNew ? '必须选一张竖版海报（自动裁成 3:4）' : '要换海报就点「选择海报」';
      $('ip-form').hidden = false; $('ip-form').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
    $('ip-add').onclick = () => openIp(null);
    $('ip-cancel').onclick = () => { $('ip-form').hidden = true; ipEdit = null; };
    $('ip-poster-btn').onclick = () => $('ip-poster-file').click();
    $('ip-poster-file').onchange = async () => {
      const file = $('ip-poster-file').files[0]; $('ip-poster-file').value = '';
      if (!file || !ipEdit) return;
      try { ipEdit.poster = await prepImage(file, 3 / 4, 900); $('ip-poster').src = ipEdit.poster.url; $('ip-poster-note').textContent = `新海报 ${ipEdit.poster.w}×${ipEdit.poster.h}，点「确定」后生效`; }
      catch (e) { say($('ip-msg'), e.message, 'err'); }
    };
    $('ip-form').onsubmit = (e) => {
      e.preventDefault();
      const { w, isNew } = ipEdit;
      const zt = $('ip-zh-title').value.trim(), et = $('ip-en-title').value.trim();
      if (!zt) return alert('请填写中文作品名。');
      if (isNew && !ipEdit.poster) return alert('新作品需要一张海报。');
      w.zh = { ...w.zh, title: zt, genre: $('ip-zh-genre').value.trim(), forms: parts($('ip-zh-forms').value), tags: lines($('ip-zh-tags').value), intro: $('ip-zh-intro').value.trim() || undefined };
      w.en = { ...w.en, title: et || undefined, genre: $('ip-en-genre').value.trim() || undefined, forms: parts($('ip-en-forms').value), tags: lines($('ip-en-tags').value), intro: $('ip-en-intro').value.trim() || undefined };
      if (isNew) {
        // 网址里的作品编号：用英文名生成（只含字母数字和连字符），重名时加数字
        let slug = (et || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 40) || `ip-${Date.now().toString(36)}`;
        const taken = new Set(ipData.works.map((x) => x.slug)); let s0 = slug, k = 2; while (taken.has(slug)) slug = `${s0}-${k++}`;
        w.slug = slug; w.poster = slug; ipData.works.push(w);
      }
      if (ipEdit.poster) { if (!w.poster) w.poster = w.slug; ipPosters[w.poster] = ipEdit.poster; }
      $('ip-form').hidden = true; ipEdit = null;
      changed(isNew ? `新增《${zt}》` : `修改《${zt}》`);
      if (!et) say($('ip-msg'), '提醒：还没有英文名，英文网站会先显示中文名。', 'warn');
    };
    $('ip-save').onclick = async () => {
      if (!ipChanges.length) return;
      const b = $('ip-save'); b.disabled = true; say($('ip-msg'), '保存中…');
      try {
        for (const [name, img] of Object.entries(ipPosters)) await putFile(`public/posters/${name}.jpg`, img.b64, `更换海报：${name}`);
        const summary = [...new Set(ipChanges)].join('，').slice(0, 80);
        await putFile(IP_FILE, textB64(JSON.stringify(ipData, null, 2) + '\n'), `更新 IP 作品：${summary}`);
        ipChanges = []; ipPosters = {}; renderIps();
        say($('ip-msg'), afterSave, 'ok');
        setTimeout(loadRuns, 4000);
      } catch (err) { say($('ip-msg'), err.message, 'err'); }
      finally { b.disabled = false; }
    };

    showKey();
  </script>
</body>
</html>
