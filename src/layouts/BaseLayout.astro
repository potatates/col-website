---
import { u } from '../lib/url';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import AiChat from '../components/zh/AiChat.astro';

import { langOf } from '../lib/i18n';

interface Props {
  title: string;
  description?: string;
}
const { title, description = '' } = Astro.props;
const lang = langOf(Astro.url) === 'en' ? 'en' : 'zh-CN';
// 英文标题用“页面 | COL Group”的惯例写法
const docTitle = lang === 'en' ? title.replace('_', ' | ') : title;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{docTitle}</title>
    <meta name="description" content={description} />
    <!-- 网站图标：Logo 中的太极“O” -->
    <link rel="icon" href={u("/favicon.png")} type="image/png" sizes="64x64" />
    <link rel="icon" href={u("/favicon-32.png")} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={u("/apple-touch-icon.png")} />
    <!-- 页面之间平滑过渡，避免每次点击都“白屏重载” -->
    <ClientRouter />
    <!-- 深色模式：首帧前就设置好，避免闪白；页面过渡后重新应用 -->
    <script is:inline>
      (function () {
        var apply = function () { try { if (localStorage.getItem('theme') === 'dark') document.documentElement.dataset.theme = 'dark'; } catch (e) {} };
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
  </head>
  <body>
    <div class="aura" aria-hidden="true"><div class="aura-grid"></div></div>
    <slot />
    <AiChat />
    <div class="cursor" id="cursor" aria-hidden="true"></div>

    <script>
      // ------------------------------------------------------------------
      // 全站交互。使用页面过渡后，每次进入新页面都会触发 astro:page-load。
      // ------------------------------------------------------------------
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      let observers: IntersectionObserver[] = [];
      let cleanups: (() => void)[] = [];

      // 鼠标光斑：卡片与封面记录鼠标位置（事件委托，只绑定一次）
      document.addEventListener('pointermove', (e) => {
        const el = (e.target as HTMLElement).closest<HTMLElement>('.card, .cover, .spot');
        if (!el) return;
        const r = el.getBoundingClientRect();
        el.style.setProperty('--mx', `${e.clientX - r.left}px`);
        el.style.setProperty('--my', `${e.clientY - r.top}px`);
        // 封面 3D 倾斜
        if (!reduce && el.classList.contains('cover') && el.closest('a')) {
          const px = (e.clientX - r.left) / r.width - 0.5;
          const py = (e.clientY - r.top) / r.height - 0.5;
          el.style.transform = `perspective(700px) rotateY(${px * 12}deg) rotateX(${-py * 12}deg) translateY(-4px)`;
        }
      });
      // 光标跟随：经过可点击元素时放大
      document.addEventListener('pointermove', (e) => {
        if (e.pointerType !== 'mouse' || reduce) return;
        const c = document.getElementById('cursor');
        if (!c) return;
        c.style.transform = `translate(${e.clientX}px, ${e.clientY}px)`;
        c.classList.add('on');
        c.classList.toggle('big', !!(e.target as HTMLElement).closest('a, button, summary'));
        // 首屏海报随鼠标轻微视差
        document.querySelectorAll<HTMLElement>('[data-depth]').forEach((el) => {
          const d = Number(el.dataset.depth);
          const x = (e.clientX / innerWidth - 0.5) * d;
          const y = (e.clientY / innerHeight - 0.5) * d;
          el.style.translate = `${x}px ${y}px`;
        });
      });
      document.addEventListener('pointerleave', () => document.getElementById('cursor')?.classList.remove('on'));

      document.addEventListener('pointerout', (e) => {
        const el = (e.target as HTMLElement).closest<HTMLElement>('.cover');
        if (el && !el.contains(e.relatedTarget as Node)) el.style.transform = '';
      });

      // 点击下拉菜单里的链接后收起菜单（鼠标移出页头前不再弹出）
      let fromDropdown = false;
      document.addEventListener('click', (e) => {
        const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('.dropdown a');
        if (!link) return;
        fromDropdown = true;
        link.blur();
        closeDropdown();
      });
      function closeDropdown() {
        const header = document.getElementById('site-header');
        if (!header) return;
        header.classList.add('dd-off');
        header.addEventListener('mouseleave', () => header.classList.remove('dd-off'), { once: true });
      }

      // 筛选标签（IP 墙、活动墙）：在当前列表内显示/隐藏，不跳页
      document.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-filter-key]');
        if (!btn) return;
        const box = btn.closest('[data-filterable]');
        if (!box) return;
        box.querySelectorAll('[data-filter-key]').forEach((b) => b.classList.toggle('on', b === btn));
        const key = btn.dataset.filterKey!;
        const val = btn.dataset.filterValue!;
        box.querySelectorAll<HTMLElement>('[data-genre], [data-status], [data-tag]').forEach((item) => {
          item.classList.toggle('hide', key !== 'all' && item.dataset[key] !== val);
        });
      });

      // 合作页：点某类合作卡片的“发送咨询”，预选表单里的合作类型并滚动到表单
      document.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-topic]');
        if (!btn) return;
        const form = document.querySelector<HTMLFormElement>('[data-proto-form]');
        if (!form) return;
        const select = form.querySelector<HTMLSelectElement>('select[name=topic]');
        if (select) select.value = btn.dataset.topic!;
        form.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
        form.querySelector<HTMLInputElement>('input[name=name]')?.focus({ preventScroll: true });
      });

      // 原型阶段的表单：不提交到后台，只给出提示（捕获阶段处理，先于页面过渡路由拦截）
      document.addEventListener('submit', (e) => {
        const form = (e.target as HTMLElement).closest<HTMLFormElement>('[data-proto-form]');
        if (!form) return;
        e.preventDefault();
        e.stopImmediatePropagation();
        const msg = form.querySelector('.f-msg');
        if (msg) msg.textContent = isEn() ? 'Prototype: the form is not connected yet. In the live site, inquiries are routed to the right contact by type.' : '原型阶段：表单尚未接入后台。正式版提交后会按合作类型自动分派给对应负责人。';
      }, true);

      // ---------------- AI 助手（原型：关键词匹配预设问答） ----------------
      type Faq = { q: string; keywords: string[]; a: string; link?: { label: string; href: string } };
      type Field = { label: string; placeholder: string };
      type Contact = { keywords: string[]; a: string; org: Field; who: Field; topic: string; need: Field; reach: Field; submit: string; missing: string; received: string; topics: { id: string; name: string }[] };
      const aiData = () => JSON.parse(document.getElementById('ai-data')?.textContent || '{}') as { faq: Faq[]; suggestions: string[]; fallback: string; contact: Contact };
      const aiBox = () => document.getElementById('ai-chat');
      function aiToggle(open?: boolean) {
        const box = aiBox();
        if (!box) return;
        const on = open ?? !box.classList.contains('open');
        box.classList.toggle('open', on);
        box.querySelector('#ai-panel')?.setAttribute('aria-hidden', String(!on));
        box.querySelector('.ai-fab')?.setAttribute('aria-expanded', String(on));
        if (on) {
          // 打开过一次后：本次会话不再弹出问候气泡
          box.classList.remove('nudge');
          try { sessionStorage.setItem('ai-seen', '1'); } catch {}
        }
        if (on) setTimeout(() => box.querySelector<HTMLTextAreaElement>('.ai-form [name=q]')?.focus(), 250);
      }
      function aiAdd(cls: string, html: string) {
        const log = document.getElementById('ai-log');
        if (!log) return null;
        const el = document.createElement('div');
        el.className = `msg ${cls}`;
        el.innerHTML = html;
        log.appendChild(el);
        log.scrollTop = log.scrollHeight;
        return el;
      }
      const esc = (t: string) => t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
      function aiAsk(q: string) {
        const text = q.trim();
        if (!text) return;
        const { faq, suggestions, fallback, contact } = aiData();
        aiAdd('user', esc(text));
        const typing = aiAdd('bot', '<span class="typing"><i></i><i></i><i></i></span>');
        const low = text.toLowerCase();
        const has = (ks: string[]) => ks.some((k) => low.includes(k.toLowerCase()));
        const exact = faq.find((f) => f.q === text);
        const wantsContact = !exact && has(contact.keywords);
        const hit = exact ?? (wantsContact ? undefined : faq.find((f) => has(f.keywords)));
        const base = aiBox()?.dataset.base ?? '';
        setTimeout(() => {
          if (!typing) return;
          if (wantsContact) {
            aiLead(typing, contact);
          } else if (hit) {
            // 页面路径补结尾“/”，避免 GitHub Pages 跳转时丢掉 #锚点（同 lib/url.ts）
            const href = hit.link ? hit.link.href.replace(/^([^?#]*?)(\/?)([?#].*)?$/, (_m: string, p: string, _s: string, r = '') => `${p}/${r}`) : '';
            const link = hit.link ? `<br><a href="${base}${href}" data-ai-link>${esc(hit.link.label)} →</a>` : '';
            typing.innerHTML = esc(hit.a) + link;
          } else {
            const chips = suggestions.map((s) => `<button class="ai-chip" data-ai-q="${esc(s)}">${esc(s)}</button>`).join('');
            typing.innerHTML = `${esc(fallback)}<div class="ai-chips" style="margin-top:10px">${chips}</div>`;
          }
          const log = document.getElementById('ai-log');
          if (log) log.scrollTop = log.scrollHeight;
        }, reduce ? 0 : 650);
      }
      // 合作留言卡：在对话里放一张小表单（填空 + 点选合作方向）；topic 为合作卡片 id 时预先选好方向
      let leadCount = 0;
      function aiLead(el: HTMLElement, contact: Contact, topic?: string) {
        const n = ++leadCount;
        const field = (name: string, f: Field, area = false) =>
          `<label class="lead-f"><span>${esc(f.label)}</span>${area
            ? `<textarea name="${name}" rows="2" placeholder="${esc(f.placeholder)}"></textarea>`
            : `<input name="${name}" placeholder="${esc(f.placeholder)}" autocomplete="off">`}</label>`;
        const opts = contact.topics.map((t) =>
          `<label class="lead-opt"><input type="radio" name="topic" value="${esc(t.name)}"${t.id === topic ? ' checked' : ''}><span>${esc(t.name)}</span></label>`).join('');
        el.classList.add('has-lead');
        el.innerHTML = `${esc(contact.a)}<form class="lead" data-ai-lead data-astro-reload novalidate>
          ${field('org', contact.org)}${field('who', contact.who)}
          <fieldset class="lead-f"><legend>${esc(contact.topic)}</legend><div class="lead-opts">${opts}</div></fieldset>
          ${field('need', contact.need, true)}${field('reach', contact.reach)}
          <p class="lead-err" aria-live="polite"></p>
          <button type="submit">${esc(contact.submit)} <span aria-hidden="true">→</span></button>
        </form>`;
        el.querySelector('form')!.id = `lead-${n}`;
      }
      // 合作页的 AI 入口与各合作卡片按钮：打开 AI 助手（捕获阶段拦截，不跳转页面）；卡片按钮直接给出对应方向的模板
      document.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-ai-chat]');
        if (!btn) return;
        e.preventDefault();
        e.stopPropagation();
        aiToggle(true);
        const topic = btn.dataset.topic;
        if (topic) {
          const el = aiAdd('bot', '');
          if (el) { aiLead(el, aiData().contact, topic); el.scrollIntoView({ block: 'nearest' }); }
        }
      }, true);
      document.addEventListener('click', (e) => {
        const t = e.target as HTMLElement;
        if (t.closest('[data-ai-nudge-close]')) {
          aiBox()?.classList.remove('nudge');
          try { sessionStorage.setItem('ai-seen', '1'); } catch {}
          return;
        }
        if (t.closest('.ai-nudge [data-ai-open]')) { aiToggle(true); return; }
        if (t.closest('[data-ai-open]')) { aiToggle(); return; }
        if (t.closest('[data-ai-close]')) { aiToggle(false); return; }
        const chip = t.closest<HTMLElement>('[data-ai-q]');
        if (chip) { aiAsk(chip.dataset.aiQ!); return; }
        if (t.closest('[data-ai-link]')) aiToggle(false);
      });
      // 发送合作留言卡：需选方向并留联系方式；发送后卡片锁定，显示一条整理好的留言与“已转交”回复
      document.addEventListener('submit', (e) => {
        const form = (e.target as HTMLElement).closest<HTMLFormElement>('[data-ai-lead]');
        if (!form) return;
        e.preventDefault();
        e.stopImmediatePropagation();
        const { contact } = aiData();
        const data = new FormData(form);
        const v = (k: string) => (data.get(k) as string | null)?.trim() ?? '';
        if (!v('topic') || !v('reach')) {
          form.querySelector('.lead-err')!.textContent = contact.missing;
          return;
        }
        form.querySelector('.lead-err')!.textContent = '';
        form.querySelectorAll('input, textarea, button').forEach((x) => ((x as HTMLInputElement).disabled = true));
        form.classList.add('sent');
        const lines = [v('topic'), [v('org'), v('who')].filter(Boolean).join(' · '), v('need'), v('reach')].filter(Boolean);
        aiAdd('user', lines.map(esc).join('<br>'));
        const typing = aiAdd('bot', '<span class="typing"><i></i><i></i><i></i></span>');
        setTimeout(() => { if (typing) typing.textContent = contact.received.replace('{topic}', v('topic')); }, reduce ? 0 : 650);
      }, true);
      document.addEventListener('submit', (e) => {
        const form = (e.target as HTMLElement).closest<HTMLFormElement>('[data-ai-form]');
        if (!form) return;
        e.preventDefault();
        e.stopImmediatePropagation();
        const input = form.querySelector<HTMLTextAreaElement>('[name=q]');
        if (input) { aiAsk(input.value); input.value = ''; input.dispatchEvent(new Event('input', { bubbles: true })); }
      }, true);
      // 输入框随内容长高（放得下整段留言模板）；回车发送，Shift+回车换行
      document.addEventListener('input', (e) => {
        const t = e.target as HTMLElement;
        if (!(t instanceof HTMLTextAreaElement) || !t.closest('[data-ai-form]')) return;
        t.style.height = 'auto';
        t.style.height = `${Math.min(t.scrollHeight, 140)}px`;
      });
      document.addEventListener('keydown', (e) => {
        const t = e.target as HTMLElement;
        if (e.key !== 'Enter' || e.shiftKey || e.isComposing || !(t instanceof HTMLTextAreaElement)) return;
        const form = t.closest<HTMLFormElement>('[data-ai-form]');
        if (!form) return;
        e.preventDefault();
        form.requestSubmit();
      });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') aiToggle(false); });

      // 数字滚动计数
      function countUp(el: HTMLElement) {
        const raw = el.dataset.count ?? '';
        const target = Number(raw.replace(/,/g, ''));
        if (!Number.isFinite(target) || reduce) return;
        const comma = raw.includes(',');
        const fmt = (n: number) => (comma ? Math.round(n).toLocaleString('en-US') : String(Math.round(n)));
        const t0 = performance.now();
        const dur = 1400;
        const step = (t: number) => {
          const p = Math.min(1, (t - t0) / dur);
          el.textContent = fmt(target * (1 - Math.pow(1 - p, 3)));
          if (p < 1) requestAnimationFrame(step);
        };
        el.textContent = fmt(0);
        requestAnimationFrame(step);
      }

      const isEn = () => document.documentElement.lang === 'en';

      function init() {
        observers.forEach((o) => o.disconnect());
        cleanups.forEach((f) => f());
        observers = [];
        cleanups = [];

        // 页头：滚动后变白、进度条、移动端菜单
        const header = document.getElementById('site-header');
        const bar = document.getElementById('progress');
        const onScroll = () => {
          const y = window.scrollY;
          header?.classList.toggle('scrolled', y > 40);
          const max = document.documentElement.scrollHeight - innerHeight;
          if (bar) bar.style.transform = `scaleX(${max > 0 ? y / max : 0})`;
        };
        onScroll();
        addEventListener('scroll', onScroll, { passive: true });
        cleanups.push(() => removeEventListener('scroll', onScroll));

        // 发展历程：吸附期间前 70% 的滚动让曲线横向推进、逐个点亮；之后缩成一屏全景并停留，往回滚则恢复（窄屏为竖向列表，不处理）
        const journeys = [...document.querySelectorAll<HTMLElement>('[data-journey]')];
        if (journeys.length) {
          const onJourney = () => {
            journeys.forEach((j) => {
              if (innerWidth <= 1100) return;
              const track = j.querySelector<HTMLElement>('.jr-track')!;
              const sticky = j.querySelector<HTMLElement>('.jr-sticky')!;
              const total = j.offsetHeight - sticky.offsetHeight;
              const raw = Math.min(1, Math.max(0, -j.getBoundingClientRect().top / Math.max(total, 1)));
              const fit = raw > 0.75;
              if (fit !== j.classList.contains('fit')) {
                j.classList.add('zooming');
                j.classList.toggle('fit', fit);
                clearTimeout(Number(j.dataset.zt));
                j.dataset.zt = String(setTimeout(() => j.classList.remove('zooming'), 950));
              }
              const clip = track.querySelector<SVGRectElement>('.jr-clip');
              if (fit) {
                clip?.setAttribute('width', '1000');
                track.querySelectorAll<HTMLElement>('.jr-node').forEach((n) => n.classList.add('on'));
                return;
              }
              const p = Math.min(1, raw / 0.7);
              const bigW = track.scrollWidth;
              const shift = Math.max(0, bigW - sticky.clientWidth + 60);
              const x = 30 - p * shift;
              track.style.transform = `translateX(${x}px)`;
              const edge = (sticky.clientWidth * 0.8 - x) / bigW;
              clip?.setAttribute('width', String(Math.max(0, Math.min(1, edge)) * 1000));
              track.querySelectorAll<HTMLElement>('.jr-node').forEach((n) => n.classList.toggle('on', Number(n.dataset.x) <= edge));
            });
          };
          onJourney();
          addEventListener('scroll', onJourney, { passive: true });
          addEventListener('resize', onJourney);
          cleanups.push(() => { removeEventListener('scroll', onJourney); removeEventListener('resize', onJourney); });
        }

        document.getElementById('theme-btn')?.addEventListener('click', () => {
          const dark = document.documentElement.dataset.theme !== 'dark';
          if (dark) document.documentElement.dataset.theme = 'dark';
          else delete document.documentElement.dataset.theme;
          try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch (e) {}
        });

        const btn = document.getElementById('menu-btn');
        btn?.addEventListener('click', () => {
          const open = header!.classList.toggle('open');
          btn.setAttribute('aria-expanded', String(open));
        });
        document.querySelectorAll('#drawer a').forEach((a) =>
          a.addEventListener('click', () => header?.classList.remove('open'))
        );

        // 滚动渐显（同组元素依次出现）
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => {
            if (!e.isIntersecting) return;
            e.target.classList.add('in');
            e.target.querySelectorAll<HTMLElement>('[data-count]').forEach(countUp);
            io.unobserve(e.target);
          }),
          { threshold: 0.12 }
        );
        document.querySelectorAll<HTMLElement>('.reveal').forEach((el) => io.observe(el));
        observers.push(io);

        // 吸附导航随滚动高亮当前板块
        // 做法：每次滚动时，找出顶部已越过屏幕上方 35% 位置的最后一个板块
        const spyLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-spy]')];
        const spyTargets = spyLinks
          .map((a) => document.getElementById(a.dataset.spy!))
          .filter((el): el is HTMLElement => !!el);
        if (spyTargets.length) {
          let current = '';
          const update = () => {
            const line = innerHeight * 0.35;
            let id = '';
            for (const t of spyTargets) if (t.getBoundingClientRect().top <= line) id = t.id;
            if (id === current) return;
            current = id;
            spyLinks.forEach((a) => {
              const on = a.dataset.spy === id;
              a.classList.toggle('active', on);
              if (!on) return;
              // 让当前条目在导航里可见：手机横向条左右滚动，桌面侧栏上下滚动
              // 手机端不显示小板块，按它所属的一级条目定位（否则隐藏条目的位置为 0，导航条会往回跳）
              const shown = a.getClientRects().length ? a : a.closest('.rail-item')?.querySelector<HTMLElement>('.rail-link');
              const list = a.closest<HTMLElement>('.rail-list');
              if (shown && list && list.scrollWidth > list.clientWidth) {
                const dx = shown.getBoundingClientRect().left - list.getBoundingClientRect().left;
                // 目标不能超出可滚动范围：超出时手机 Safari 会先冲过头再弹回来
                const max = list.scrollWidth - list.clientWidth;
                const left = Math.max(0, Math.min(max, Math.round(list.scrollLeft + dx - 16)));
                if (left !== Math.round(list.scrollLeft)) list.scrollTo({ left, behavior: 'smooth' });
              }
              const rail = a.closest<HTMLElement>('.rail');
              if (rail && rail.scrollHeight > rail.clientHeight) {
                const delta = a.getBoundingClientRect().top - rail.getBoundingClientRect().top;
                rail.scrollTo({ top: rail.scrollTop + delta - 120, behavior: 'smooth' });
              }
            });
            // 分组（如业务与产品的各业务）：当前位置在该组内时展开其小板块
            document.querySelectorAll<HTMLElement>('[data-spy-group]').forEach((g) => {
              const key = g.dataset.spyGroup!;
              g.classList.toggle('open', id === key || id.startsWith(`${key}-`));
            });
          };
          update();
          addEventListener('scroll', update, { passive: true });
          cleanups.push(() => removeEventListener('scroll', update));
        }

        // 实时股价：用 <script> 读取腾讯财经公开行情（qt.gtimg.cn 不支持跨域 fetch，但可作为脚本加载，
        // 返回 v_sz300364="51~中文在线~300364~现价~昨收~今开~…"），填入页头小标签和投资者关系页。每分钟刷新一次。
        if (document.querySelector('[data-stock]')) {
          const en = isEn();
          const loadStock = () => {
            const tag = document.createElement('script');
            tag.src = `https://qt.gtimg.cn/q=sz300364&_=${Date.now()}`;
            tag.charset = 'gbk';
            tag.onload = tag.onerror = () => {
              tag.remove();
              const f = String((window as any).v_sz300364 ?? '').split('~');
              if (!Number(f[3])) return;
              const chg = Number(f[31]);
              const sign = chg > 0 ? '+' : '';
              const t = f[30] ?? '';
              const vals: Record<string, string> = {
                price: Number(f[3]).toFixed(2),
                chg: `${sign}${chg.toFixed(2)}`,
                pct: `${sign}${Number(f[32]).toFixed(2)}%`,
                open: Number(f[5]).toFixed(2),
                high: Number(f[33]).toFixed(2),
                low: Number(f[34]).toFixed(2),
                cap: en ? `CNY ${(Number(f[45]) / 10).toFixed(2)} bn` : `${Number(f[45]).toFixed(2)} 亿元`,
                // 成交额：接口单位为万元
                amount: en ? `CNY ${(Number(f[37]) / 100).toFixed(0)} M` : `${(Number(f[37]) / 10000).toFixed(2)} 亿元`,
                time: t.length >= 12 ? `${en ? 'As of' : '更新于'} ${t.slice(4, 6)}-${t.slice(6, 8)} ${t.slice(8, 10)}:${t.slice(10, 12)} ·` : '',
              };
              document.querySelectorAll<HTMLElement>('[data-stock]').forEach((el) => {
                const k = el.dataset.stock!;
                if (k === 'status') {
                  el.textContent = `${el.dataset.stockLive} · ${t.slice(8, 10)}:${t.slice(10, 12)}`;
                  return;
                }
                if (!(k in vals)) return;
                el.textContent = vals[k];
                if (k === 'price' || k === 'chg' || k === 'pct') {
                  el.classList.toggle('stock-up', chg > 0);
                  el.classList.toggle('stock-down', chg < 0);
                }
              });
            };
            document.head.appendChild(tag);
          };
          loadStock();
          const timer = setInterval(loadStock, 60_000);
          // 8 秒后仍没有数据（接口被网络拦截等）：行情卡片标签改为“行情暂不可用”，保留“完整行情”链接
          const failTimer = setTimeout(() => {
            if (Number((window as any).v_sz300364?.split('~')[3])) return;
            document.querySelectorAll<HTMLElement>('[data-stock-fail]').forEach((el) => { el.textContent = el.dataset.stockFail!; });
          }, 8000);
          cleanups.push(() => { clearInterval(timer); clearTimeout(failTimer); });
        }

        // AI 助手更醒目：本次会话还没打开过时，进站 3 秒后弹出一次问候气泡，10 秒后自动收起（光环见 AiChat 样式）
        {
          const box = aiBox();
          let seen = false;
          try { seen = sessionStorage.getItem('ai-seen') === '1'; } catch {}
          if (box && !seen) {
            let shown = false;
            try { shown = sessionStorage.getItem('ai-nudged') === '1'; } catch {}
            if (!shown) {
              const t1 = setTimeout(() => {
                if (box.classList.contains('open')) return;
                box.classList.add('nudge');
                try { sessionStorage.setItem('ai-nudged', '1'); } catch {}
              }, 3000);
              const t2 = setTimeout(() => box.classList.remove('nudge'), 13000);
              cleanups.push(() => { clearTimeout(t1); clearTimeout(t2); });
            }
          }
        }

        if (fromDropdown) {
          closeDropdown();
          fromDropdown = false;
        }

        // 从别的页面跳到某个小板块（如 /business/ip#audio）：定位到该板块，卡片则短暂高亮
        const hash = decodeURIComponent(location.hash.slice(1));
        const target = hash ? document.getElementById(hash) : null;
        if (target && target.classList.contains('contact-card')) {
          // 合作页：高亮对应的合作卡片（例如从 IP 授权按钮过来 → IP授权卡片），其余卡片淡出，并预填表单
          const type = new URLSearchParams(location.search).get('type');
          const grid = target.closest('.b-contacts');
          grid?.classList.add('has-focus');
          grid?.querySelectorAll('.contact-card').forEach((c) => c.classList.toggle('is-focus', c === target));
          target.classList.add('in');
          const badge = target.querySelector('.cc-badge');
          if (badge) badge.textContent = isEn() ? (type ? `You selected: ${type}` : 'Here’s who you’re looking for') : (type ? `您选择的：${type}` : '您要找的在这里');
          const form = document.querySelector<HTMLFormElement>('[data-proto-form]');
          const topic = target.querySelector<HTMLElement>('[data-topic]')?.dataset.topic;
          const select = form?.querySelector<HTMLSelectElement>('select[name=topic]');
          if (topic && select) select.value = topic;
          const msg = form?.querySelector<HTMLTextAreaElement>('textarea[name=message]');
          if (type && msg && !msg.value) msg.value = isEn() ? `I’d like to discuss: ${type}` : `我想洽谈：${type}`;
          requestAnimationFrame(() => target.scrollIntoView({ behavior: 'instant', block: 'center' }));
          // 用户点开别的卡片或开始填写表单后，取消淡出效果
          const clear = (e: Event) => {
            if ((e.target as HTMLElement).closest('.is-focus')) return;
            grid?.classList.remove('has-focus');
            document.removeEventListener('click', clear);
          };
          setTimeout(() => document.addEventListener('click', clear), 0);
          cleanups.push(() => document.removeEventListener('click', clear));
        } else if (target) {
          // 定位两次：页面切换后立即一次，图片等加载、布局稳定后再校正一次
          const go = () => target.scrollIntoView({ behavior: 'instant', block: 'start' });
          setTimeout(go, 0);
          setTimeout(go, 400);
          if (target.classList.contains('card')) {
            target.classList.add('is-target');
            setTimeout(() => target.classList.remove('is-target'), 2200);
          }
        }

        // 首页业务导览：悬停/聚焦某项时切换右侧预览
        const rows = [...document.querySelectorAll<HTMLElement>('[data-biz]')];
        const panels = [...document.querySelectorAll<HTMLElement>('[data-biz-panel]')];
        const activate = (key: string) => {
          rows.forEach((r) => r.classList.toggle('active', r.dataset.biz === key));
          panels.forEach((p) => p.classList.toggle('active', p.dataset.bizPanel === key));
        };
        rows.forEach((r) => {
          r.addEventListener('mouseenter', () => activate(r.dataset.biz!));
          r.addEventListener('focusin', () => activate(r.dataset.biz!));
        });
      }

      document.addEventListener('astro:page-load', init);
    </script>
  </body>
</html>
