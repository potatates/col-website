---
// 栏目页共用版式：页头 → 主题色题图 → [左侧页面内导航 | 连续的各板块] → 下一章 → 合作咨询横幅（合作页除外）→ 页脚
import BaseLayout from './BaseLayout.astro';
import Header from '../components/zh/Header.astro';
import Footer from '../components/zh/Footer.astro';
import PageHero from '../components/zh/PageHero.astro';
import SideNav from '../components/zh/SideNav.astro';
import Blocks from '../components/zh/Blocks.astro';
import NextPage from '../components/zh/NextPage.astro';
import CtaBand from '../components/zh/CtaBand.astro';
import type { Page } from '../content/zh';
import { useLang } from '../lib/i18n';
const { site, nextOf } = useLang(Astro.url).c;

interface Props {
  page: Page;
  crumbs?: { label: string; href: string }[];
}
const { page, crumbs = [] } = Astro.props;
const next = nextOf[page.key];
const theme = page.theme ?? ['#0071ce', '#00c1de'];
---
<BaseLayout title={`${page.title}_${site.name}`} description={page.intro}>
  <Header current={page.key} />
  <main style={`--c1:${theme[0]};--c2:${theme[1]}`}>
    <PageHero title={page.title} en={page.en} intro={page.intro} crumbs={crumbs} theme={theme}>
      <slot name="aside" slot="aside" />
    </PageHero>

    <div class="container page-grid">
      <SideNav title={page.title} items={page.sections.map((s) => ({ id: s.id, label: s.label }))} />
      <div class="page-body">
        {page.sections.map((s) => (
          <section id={s.id} class="block-section">
            <div class="s-head reveal">
              <span class="s-ghost" aria-hidden="true">{s.en}</span>
              <h2 class="s-title">{s.title ?? s.label}</h2>
              {s.intro && <p class="s-intro">{s.intro}</p>}
            </div>
            <div class="s-body">
              <Blocks blocks={s.blocks} />
            </div>
          </section>
        ))}
      </div>
    </div>

    <slot />
    {next && <NextPage next={next} />}
    {page.key !== 'partner' && <CtaBand />}
  </main>
  <Footer />
</BaseLayout>
