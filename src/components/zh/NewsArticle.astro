---
// 本站发布的新闻详情页（/news/<slug>）：示范新闻的版式层级——标题 > 小标题 > 正文 > 引语，配图位于标题下方。
// 内容来自 zh.ts / en.ts 官方新闻中带 slug + body 的条目。
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import CtaBand from './CtaBand.astro';
import { u as asset } from '../../lib/url';
import { useLang } from '../../lib/i18n';
import type { NewsItem } from '../../content/zh';

interface Props { slug: string }
const { c, ui, l: u } = useLang(Astro.url);
const { site, pages } = c;
const all = pages.news.sections.flatMap((s) => s.blocks).flatMap((b) => (b.type === 'news' ? b.items : [])) as NewsItem[];
const n = all.find((x) => x.slug === Astro.props.slug)!;
const more = all.filter((x) => x !== n).slice(0, 3);
const theme = pages.news.theme ?? ['#0071ce', '#00c1de'];
---
<BaseLayout title={`${n.title}_${site.name}`} description={n.text}>
  <Header current="news" />
  <main style={`--c1:${theme[0]};--c2:${theme[1]}`}>
    <header class="na-top">
      <div class="container na-head">
        <nav class="na-crumbs" aria-label={ui.crumbs}>
          <a href={u('/')} class="link-u">{ui.home}</a><span>/</span><a href={u('/news')} class="link-u">{pages.news.title}</a>
        </nav>
        <div class="na-meta"><time>{n.date}</time>{n.tag && <span class="na-tag">{n.tag}</span>}<span class="na-own">{ui.newsOwn}</span></div>
        <h1>{n.title}</h1>
        {n.text && <p class="na-dek">{n.text}</p>}
      </div>
    </header>
    <article class="container na">
      {n.img && <img class="na-img" src={asset(`/news/${n.img}.jpg`)} alt="" />}
      <div class="na-body">
        {n.body!.map((x) => (
          'h' in x ? <h2>{x.h}</h2>
          : 'quote' in x ? <blockquote><p>“{x.quote}”</p>{x.by && <cite>— {x.by}</cite>}</blockquote>
          : <p>{x.p}</p>
        ))}
      </div>
      <footer class="na-foot">
        <a href={u('/news')} class="btn btn-outline">← {ui.backToList} {pages.news.title}</a>
      </footer>
    </article>

    <section class="container na-more">
      <h2 class="na-more-h">{ui.newsMore}</h2>
      <div class="na-grid">
        {more.map((m) => {
          const own = !!(m.slug && m.body);
          const href = own ? u(`/news/${m.slug}`) : m.href;
          const Tag = href ? 'a' : 'div';
          return (
            <Tag class="na-card" href={href} target={!own && href ? '_blank' : undefined} rel={!own && href ? 'noopener' : undefined}>
              {m.img && <img src={asset(`/news/${m.img}.jpg`)} alt="" loading="lazy" />}
              <time>{m.date}</time>
              <strong>{m.title}</strong>
            </Tag>
          );
        })}
      </div>
    </section>
    <CtaBand />
  </main>
  <Footer />
</BaseLayout>

<style>
  /* 题头：主题色渐变带（让页头白色导航可读），标题在带内；配图压在渐变带下沿 */
  .na-top { color: #fff; padding: 140px 0 150px; background: radial-gradient(60% 90% at 85% 0%, color-mix(in srgb, var(--c2) 80%, transparent), transparent 70%), linear-gradient(135deg, var(--c1), color-mix(in srgb, var(--c1) 55%, #0b1430)); }
  .na-head { max-width: 820px; }
  .na { max-width: 820px; margin-top: -110px; position: relative; }
  .na-crumbs { display: flex; gap: 8px; font-size: 13px; color: rgba(255,255,255,.75); margin-bottom: 30px; }
  .na-meta { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; font-size: 14px; color: rgba(255,255,255,.8); font-variant-numeric: tabular-nums; }
  .na-tag { font-size: 12px; font-weight: 700; color: #fff; background: rgba(255,255,255,.18); border-radius: 999px; padding: 3px 10px; }
  .na-own { font-size: 12px; font-weight: 700; color: var(--c1); border-radius: 999px; padding: 3px 10px; background: #fff; }
  /* 层级：标题 34–44px 粗体 > 导语 19px > 小标题 22px > 正文 17px */
  .na-head h1 { margin-top: 18px; font-size: clamp(28px, 4vw, 44px); line-height: 1.3; font-weight: 900; color: #fff; letter-spacing: -.01em; }
  .na-dek { margin-top: 18px; font-size: 19px; line-height: 1.75; color: rgba(255,255,255,.85); }
  .na-img { width: 100%; border-radius: 22px; margin-bottom: 40px; box-shadow: 0 24px 50px -30px rgba(10,22,48,.45); }
  .na-body h2 { margin: 44px 0 14px; font-size: 22px; font-weight: 800; color: var(--ink); padding-left: 14px; border-left: 4px solid var(--c1); line-height: 1.4; }
  .na-body p { font-size: 17px; line-height: 2; color: var(--text); margin-bottom: 20px; }
  .na-body blockquote { margin: 36px 0; padding: 28px 32px; border-radius: 22px; background: linear-gradient(120deg, color-mix(in srgb, var(--c1) 9%, var(--surface)), color-mix(in srgb, var(--violet) 8%, var(--surface))); }
  .na-body blockquote p { font-size: 20px; line-height: 1.8; font-weight: 700; color: var(--ink); margin: 0; }
  .na-body cite { display: block; margin-top: 12px; font-style: normal; font-size: 14px; color: var(--muted); }
  .na-foot { margin-top: 48px; padding-top: 28px; border-top: 1px solid var(--line); }
  .na-more { padding-top: 90px; }
  .na-more-h { font-size: 24px; font-weight: 900; color: var(--ink); margin-bottom: 22px; }
  .na-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .na-card { display: flex; flex-direction: column; gap: 8px; padding: 14px 14px 20px; border-radius: 22px; background: var(--surface); box-shadow: 0 10px 26px -20px rgba(10,22,48,.3); transition: transform .45s var(--spring); }
  a.na-card:hover { transform: translateY(-6px); }
  .na-card img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 14px; margin-bottom: 6px; }
  .na-card time { font-size: 13px; color: var(--muted); padding: 0 6px; }
  .na-card strong { font-size: 15px; line-height: 1.5; color: var(--ink); padding: 0 6px; }
  @media (max-width: 768px) {
    .na-top { padding: 110px 0 120px; }
    .na { margin-top: -80px; }
    .na-body p { font-size: 16px; }
    .na-grid { grid-template-columns: 1fr; }
  }
</style>
