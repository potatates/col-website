---
// 内容块渲染器：所有栏目页的内容都通过这里渲染，保证全站视觉与交互一致
import { u as asset } from '../../lib/url';
import { useLang } from '../../lib/i18n';
import type { Block } from '../../content/zh';
const { ui, l: u } = useLang(Astro.url);
// 深色模式下黑色字的 logo 换成白字版本（public/products/*-dark.png）
const DARK_LOGOS = ['flareflow', 'cyshenbi', '4yt', '17k']; // 17k-dark 为官方反白版
import PosterImg from './PosterImg.astro';

interface Props { blocks: Block[] }
const { blocks } = Astro.props;

// 海报色板：以蓝青为主，夹杂紫、粉、橙，像一面海报墙
const palette = [205, 250, 190, 330, 275, 215, 20, 300, 230, 175, 345, 40];
const hue = (s: string) => palette[[...s].reduce((a, c) => a + c.charCodeAt(0), 0) % palette.length];
const isNum = (v: string) => /^[\d,]+$/.test(v);
---
{blocks.map((b) => {
  switch (b.type) {
    case 'text':
      return (
        <div class:list={['b-text reveal', { lead: b.lead }]}>
          {b.paras.map((p) => <p>{p}</p>)}
        </div>
      );

    case 'stats':
      return (
        <div class="reveal">
          <div class:list={['b-stats', `n${Math.min(b.items.length, 4)}`]}>
            {b.items.map((s) => (
              <div class="b-stat">
                <div class="num"><span data-count={isNum(s.value) ? s.value : undefined}>{s.value}</span>{s.unit && <em>{s.unit}</em>}</div>
                <div class="num-label">{s.label}</div>
              </div>
            ))}
          </div>
          {b.note && <p class="b-note">{b.note}</p>}
        </div>
      );

    case 'cards':
      return (
        <div class:list={['b-cards', b.featured ? 'featured' : `c${b.cols ?? 3}`]}>
          {b.items.map((c, i) => {
            const live = !!c.href && c.href !== '#';
            const Tag = live ? 'a' : 'div';
            return (
              <Tag
                class="card reveal"
                id={c.id}
                href={live ? u(c.href) : undefined}
                target={live && c.external ? '_blank' : undefined}
                rel={live && c.external ? 'noopener' : undefined}
                style={`--d:${(i % 4) * 70}ms;${c.color ? `--c1:${c.color[0]};--c2:${c.color[1]}` : ''}`}
              >
                {c.color && <span class="card-stripe" aria-hidden="true"></span>}
                {c.logo && (
                  <span class="card-logo">
                    <img class="logo-light" src={asset(`/products/${c.logo}.png`)} alt={c.title} loading="lazy" />
                    {DARK_LOGOS.includes(c.logo) && <img class="logo-dark" src={asset(`/products/${c.logo}-dark.png`)} alt="" aria-hidden="true" loading="lazy" />}
                  </span>
                )}
                {c.tag && <span class="card-tag">{c.tag}</span>}
                <span class="card-title">{c.title}</span>
                {c.text && <span class="card-text">{c.text}</span>}
                {live && <span class="card-go">{c.external ? ui.visitSite : ui.learnMore} <span class="arrow">{c.external ? '↗' : '→'}</span></span>}
                {c.href === '#' && <span class="card-soon">{ui.linkSoon}</span>}
              </Tag>
            );
          })}
        </div>
      );

    case 'covers':
      return (
        <>
        {b.title && <h4 class="b-subtitle reveal">{b.title}</h4>}
        <div class="b-covers">
          {b.items.map((c, i) => (
            <div class="b-cover reveal" style={`--d:${(i % 6) * 50}ms`}>
              <div class:list={['cover', { 'has-poster': c.poster }]} style={`--h:${hue(c.title)}`}>
                {c.poster ? <PosterImg name={c.poster} alt={c.title} /> : <span>{c.title}</span>}
              </div>
              {c.poster && <strong class="cv-title">{c.title}</strong>}
              {c.sub && <small>{c.sub}</small>}
            </div>
          ))}
        </div>
        </>
      );

    case 'tags':
      return (
        <div class="b-tags reveal">
          {b.title && <h4>{b.title}</h4>}
          <div class="tags">{b.items.map((t) => <span class="tag">{t}</span>)}</div>
        </div>
      );

    case 'steps':
      return (
        <ol class="b-steps reveal">
          {b.items.map((s, i) => (
            <li class:list={['step', { colored: !!s.color }]} style={`--d:${i * 80}ms;${s.color ? `--c1:${s.color[0]};--c2:${s.color[1]}` : ''}`}>
              <span class="step-no">{String(i + 1).padStart(2, '0')}</span>
              <strong>{s.title}</strong>
              {s.text && <span>{s.text}</span>}
            </li>
          ))}
        </ol>
      );

    case 'journey': {
      // 发展历程：一条上扬的发光曲线（参照集团介绍的“跨越式发展”页）。桌面端吸附在屏幕上：
      // 先随滚动横向推进、逐个点亮（大字号）；滚到底时整条时间线缩小成一屏全景并停留。手机端改为竖向列表
      const n = b.items.length, W = 1000, H = 600;
      // 向上的卡片放在波峰、向下的卡片放在波谷，整体缓缓上扬，相邻卡片不互相遮挡
      const pts = b.items.map((_, i) => ({ x: 45 + i * ((W - 90) / (n - 1)), y: 440 - i * 17 + (i % 2 === 0 ? -30 : 30) }));
      const d = pts.map((p, i) => {
        if (i === 0) return `M0 ${p.y + 30} C 30 ${p.y + 30} 40 ${p.y} ${p.x} ${p.y}`;
        const q = pts[i - 1], h = (p.x - q.x) / 2;
        return `C ${q.x + h} ${q.y} ${p.x - h} ${p.y} ${p.x} ${p.y}`;
      }).join(' ') + ` C ${W - 30} ${pts[n - 1].y} ${W - 20} ${pts[n - 1].y - 40} ${W} ${pts[n - 1].y - 60}`;
      return (
        <div class="b-journey" data-journey style={`--n:${n}`}>
          <div class="jr-sticky">
            <div class="jr-track" style={`--bigw:${n * 330 + 260}px`}>
              <svg class="jr-svg" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true">
                <defs>
                  <linearGradient id="jr-grad" x1="0" x2="1" y1="0" y2="0">
                    <stop offset="0" class="s1" /><stop offset=".5" class="s2" /><stop offset="1" class="s3" />
                  </linearGradient>
                  {/* 彩色线按滚动进度从左往右露出：用裁切矩形而不是虚线偏移，保证线条连续 */}
                  <clipPath id="jr-clip"><rect class="jr-clip" x="0" y="-100" width="0" height={H + 200} /></clipPath>
                </defs>
                <path d={d} class="jr-base" vector-effect="non-scaling-stroke" />
                <g clip-path="url(#jr-clip)">
                  <path d={d} class="jr-line jr-blur" vector-effect="non-scaling-stroke" />
                  <path d={d} class="jr-line" vector-effect="non-scaling-stroke" />
                </g>
              </svg>
              {b.items.map((t, i) => (
                <div class:list={['jr-node', { up: i % 2 === 0, era: t.era, first: i === 0, last: i === n - 1 }]} style={`left:${(pts[i].x / W) * 100}%;top:${(pts[i].y / H) * 100}%`} data-x={pts[i].x / W}>
                  <span class="jr-dot"></span>
                  <div class="jr-card">
                    {t.era && <span class="jr-era">#{t.era}</span>}
                    <span class="jr-year">{t.year}</span>
                    <p>{t.text}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      );
    }

    case 'timeline':
      return (
        <ol class="b-timeline">
          {b.items.map((t, i) => (
            <li class="reveal" style={`--d:${i * 70}ms`}>
              <span class="tl-year">{t.year}</span>
              <span class="tl-dot"></span>
              <p>{t.text}</p>
            </li>
          ))}
        </ol>
      );

    case 'honors':
      return (
        <div class="b-honors">
          {b.items.map((h, i) => (
            <div class="honor reveal" style={`--d:${(i % 3) * 70}ms`}>
              <span class="honor-year">{h.year}</span>
              <ul>{h.items.map((t) => <li>{t}</li>)}</ul>
            </div>
          ))}
        </div>
      );

    case 'quote':
      return (
        <figure class="b-quote reveal">
          <blockquote>{b.text}</blockquote>
          <figcaption>
            <span class="avatar" aria-hidden="true">{b.author?.slice(-2)}</span>
            <span><strong>{b.author}</strong><small>{b.role}</small></span>
            {b.href && <a href={u(b.href)} class="btn btn-outline">{b.hrefLabel} <span class="arrow">→</span></a>}
          </figcaption>
        </figure>
      );

    case 'letter':
      return (
        <article class="b-letter reveal">
          <h3>{b.title}</h3>
          <blockquote>{b.lead}</blockquote>
          <ol class="themes">
            {b.themes.map((t, i) => (
              <li class="theme"><em>{i + 1}</em><strong>{t.k}</strong><span>{t.v}</span></li>
            ))}
          </ol>
          <details class="full">
            <summary><span>{ui.readFull}</span></summary>
            <p>{ui.letterSoon}</p>
          </details>
          <footer><strong>{b.author}</strong> · {b.role} · {b.date}</footer>
        </article>
      );

    case 'news': {
      // 新闻列表：按标签筛选（不跳页）；详情页上线前条目不可点击
      const tags = [...new Set(b.items.map((n) => n.tag).filter(Boolean))] as string[];
      return (
        <div class="b-newswrap" data-filterable>
          {tags.length > 1 && (
            <div class="filters reveal">
              <button class="chip on" data-filter-key="all" data-filter-value="all">{ui.all}</button>
              {tags.map((t) => <button class="chip" data-filter-key="tag" data-filter-value={t}>{t}</button>)}
            </div>
          )}
          <ul class="b-news">
            {b.items.map((n, i) => (
              <li class="reveal" id={`news-${n.date}`} data-tag={n.tag} style={`--d:${i * 60}ms`}>
                {(() => {
                  // 有原文链接（官网文章，与公众号同文）时整行可点，新窗口打开
                  const Row = n.href ? 'a' : 'div';
                  return (
                    <Row class:list={['news-row', { 'has-img': n.img, live: n.href }]} href={n.href} target={n.href ? '_blank' : undefined} rel={n.href ? 'noopener' : undefined}>
                      {n.img && <img class="news-img" src={asset(`/news/${n.img}.jpg`)} alt="" loading="lazy" />}
                      <span class="news-body">
                        <span class="news-meta"><time>{n.date}</time>{n.tag && <span class="news-tag">{n.tag}</span>}</span>
                        <span class="news-title">{n.title}</span>
                        {n.text && <span class="news-text">{n.text}</span>}
                      </span>
                      {n.href ? <span class="news-go">{ui.readSource} <span class="arrow">↗</span></span> : <span class="news-soon">{ui.detailSoon}</span>}
                    </Row>
                  );
                })()}
              </li>
            ))}
          </ul>
        </div>
      );
    }

    case 'docs':
      return (
        <div class="b-docs">
          {b.cols.map((col) => (
            <div class="reveal">
              <h4 class="docs-title">{col.title}</h4>
              <ul>
                {col.items.map((d) => (
                  <li><a href={u(b.href)} target="_blank" rel="noopener"><time>{d.date}</time><span>{d.title}</span><em>PDF ↗</em></a></li>
                ))}
              </ul>
            </div>
          ))}
          <a href={u(b.href)} target="_blank" rel="noopener" class="btn btn-outline docs-more">{ui.cninfoAll} <span class="arrow">↗</span></a>
        </div>
      );

    case 'ipwall': {
      // IP 墙：卡片 = 海报 + 数据标签 + 题材；顶部按题材筛选（不跳页）
      const genres = [...new Set(b.items.map((x) => x.genre))];
      return (
        <div class="b-ipwall" data-filterable>
          <div class="filters reveal">
            <button class="chip on" data-filter-key="all" data-filter-value="all">{ui.all}</button>
            {genres.map((g) => <button class="chip" data-filter-key="genre" data-filter-value={g}>{g}</button>)}
          </div>
          <div class="ip-grid">
            {b.items.map((x, i) => (
              <a class="ip-card reveal" href={u(`/partner?type=${encodeURIComponent(x.title)}#license`)} data-genre={x.genre} style={`--d:${(i % 4) * 60}ms`}>
                <div class:list={['cover', { 'has-poster': x.poster }]} style={`--h:${hue(x.title)}`}>
                  {x.poster ? <PosterImg name={x.poster} wide={x.wide} alt={x.title} /> : <span>{x.title}</span>}
                </div>
                <strong class="ip-title">{x.title}</strong>
                <div class="ip-meta">
                  <span class="ip-genre">{x.genre}{x.forms.length > 0 && ` · ${x.forms.join(' / ')}`}</span>
                  {x.tags.map((t) => <span class="ip-tag">{t}</span>)}
                </div>
                <span class="ip-go">{ui.talkLicense} <span class="arrow">→</span></span>
              </a>
            ))}
          </div>
          {b.note && <p class="b-note">{b.note}</p>}
        </div>
      );
    }

    case 'stock':
      // 实时股价：数值由 BaseLayout 全站脚本填入（data-stock），读取失败时保持 --
      return (
        <div class="b-stock reveal">
          <div class="sk-id"><strong>{b.name}</strong><span>{b.code}</span></div>
          <div class="sk-price"><strong data-stock="price">--.--</strong><span data-stock="chg"></span><span data-stock="pct"></span></div>
          <dl class="sk-meta">
            <div><dt>{ui.stockOpen}</dt><dd data-stock="open">--</dd></div>
            <div><dt>{ui.stockHigh}</dt><dd data-stock="high">--</dd></div>
            <div><dt>{ui.stockLow}</dt><dd data-stock="low">--</dd></div>
            <div><dt>{ui.stockCap}</dt><dd data-stock="cap">--</dd></div>
          </dl>
          <p class="sk-note"><span data-stock="time"></span> {b.note} · <a href={b.link.href} target="_blank" rel="noopener">{b.link.label} ↗</a></p>
        </div>
      );

    case 'aichat':
      // 打开右下角 AI 助手（BaseLayout 中 [data-ai-chat] 的点击处理）
      return (
        <div class="b-aichat reveal">
          <span class="ac-icon" aria-hidden="true">✦</span>
          <div class="ac-text"><strong>{b.title}</strong><p>{b.text}</p></div>
          <button type="button" class="btn btn-primary" data-ai-chat>{b.cta} <span class="arrow">→</span></button>
        </div>
      );

    case 'videos':
      // 预告片 / 样片墙：原型为占位，正式版接入视频文件或视频平台
      return (
        <div class="b-videos">
          {b.items.map((v, i) => (
            v.src ? (
              // 有视频文件：直接播放（public/videos/ 下的 mp4 与封面图）
              <figure class:list={['video has-video reveal', { vertical: v.vertical }]} style={`--d:${(i % 4) * 70}ms`}>
                <video controls preload="none" playsinline poster={asset(`/videos/${v.src}.jpg`)} src={asset(`/videos/${v.src}.mp4`)}></video>
                <figcaption><strong>{v.title}</strong>{v.sub && <small>{v.sub}</small>}</figcaption>
              </figure>
            ) : (
              <figure class:list={['video reveal', { vertical: v.vertical }]} style={`--d:${(i % 4) * 70}ms;--h:${hue(v.title)}`}>
              <button class="play" aria-label={`${ui.play} ${v.title}`} title={ui.videoSoon}>▶</button>
              <figcaption><strong>{v.title}</strong>{v.sub && <small>{v.sub}</small>}</figcaption>
            </figure>
            )
          ))}
          {b.note && <p class="b-note">{b.note}</p>}
        </div>
      );

    case 'people':
      return (
        <div class:list={['b-people', `c${b.cols ?? 3}`]}>
          {b.items.map((p, i) => (
            <div class="person card reveal" style={`--d:${(i % 4) * 70}ms`}>
              <span class="p-avatar" aria-hidden="true">{p.name.replace(/[（(].*$/, '').slice(-2)}</span>
              <span class="card-title">{p.name}</span>
              <span class="card-tag">{p.role}</span>
              {p.text && <span class="card-text">{p.text}</span>}
              {(p.email || p.phone) && (
                <span class="p-contact">
                  {p.email && <a href={`mailto:${p.email}`}>✉ {p.email}</a>}
                  {p.phone && <span>☏ {p.phone}</span>}
                </span>
              )}
            </div>
          ))}
        </div>
      );

    case 'contacts':
      // 合作页：每类合作一张卡（负责人 + 说明），点“发送咨询”会预选下方表单的合作类型
      return (
        <div class="b-contacts">
          {b.items.map((c, i) => (
            <div class="contact-card card reveal" id={c.id} style={`--d:${(i % 3) * 70}ms`}>
              <span class="cc-badge" aria-live="polite"></span>
              <span class="card-tag">{c.tag}</span>
              <span class="card-title">{c.title}</span>
              <span class="card-text">{c.text}</span>
              <div class="cc-people">
                {c.people.map((p) => (
                  <div class="cc-person">
                    <span class="p-avatar sm" aria-hidden="true">{p.name.replace(/[（(].*$/, '').slice(-2)}</span>
                    <span>
                      <strong>{p.name}</strong><small>{p.role}</small>
                      {p.email && <a href={`mailto:${p.email}`}>{p.email}</a>}
                      {p.phone && <small>{p.phone}</small>}
                    </span>
                  </div>
                ))}
              </div>
              <button class="card-go cc-go" data-topic={c.title} data-ai-chat>{ui.sendInquiry} <span class="arrow">→</span></button>
            </div>
          ))}
        </div>
      );

    case 'form':
      // 留资表单：原型阶段不提交到后台，提交后提示；正式版接入表单服务并按合作类型自动分派
      return (
        <form class="b-form reveal" id={b.id ?? 'inquiry'} data-proto-form data-astro-reload>
          <div class="f-row">
            <label>{ui.form.topic}<select name="topic" required>{b.topics.map((t) => <option>{t}</option>)}</select></label>
            <label>{ui.form.name}<input name="name" required placeholder={ui.form.namePh} /></label>
          </div>
          <div class="f-row">
            <label>{ui.form.company}<input name="company" placeholder={ui.form.companyPh} /></label>
            <label>{ui.form.title}<input name="title" placeholder={ui.form.titlePh} /></label>
          </div>
          <div class="f-row">
            <label>{ui.form.email}<input name="email" type="email" required placeholder="name@company.com" /></label>
            <label>{ui.form.phone}<input name="phone" placeholder={ui.form.phonePh} /></label>
          </div>
          <label>{ui.form.message}<textarea name="message" rows="4" placeholder={ui.form.messagePh}></textarea></label>
          <div class="f-foot">
            <button class="btn btn-primary" type="submit">{ui.form.submit} <span class="arrow">→</span></button>
            <p class="f-msg" role="status" aria-live="polite"></p>
          </div>
          {b.note && <p class="b-note">{b.note}</p>}
        </form>
      );

    case 'gallery': {
      const tags = [...new Set(b.items.map((x) => x.tag))];
      return (
        <div class="b-gallery" data-filterable>
          <div class="filters reveal">
            <button class="chip on" data-filter-key="all" data-filter-value="all">{ui.all}</button>
            {tags.map((t) => <button class="chip" data-filter-key="tag" data-filter-value={t}>{t}</button>)}
          </div>
          <div class="g-grid">
            {b.items.map((x, i) => (
              <figure class:list={['g-item reveal', `g${i % 5}`]} data-tag={x.tag} style={`--d:${(i % 4) * 60}ms;--h:${hue(x.caption)}`}>
                <span class="g-ph" aria-hidden="true">{ui.photoSoon}</span>
                <figcaption><em>{x.tag}</em>{x.caption}</figcaption>
              </figure>
            ))}
          </div>
          {b.note && <p class="b-note">{b.note}</p>}
        </div>
      );
    }

    case 'faq':
      return (
        <div class="b-faq reveal">
          {b.items.map((f) => (
            <details class="faq">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      );

    case 'logos':
      return (
        <div class="reveal">
          <div class="b-logos">{b.items.map((l) => <span class="logo-tile">{l}</span>)}</div>
          {b.note && <p class="b-note">{b.note}</p>}
        </div>
      );

    case 'downloads':
      return (
        <div class="b-downloads">
          {b.items.map((d, i) => (
            <div class="dl card reveal" style={`--d:${(i % 4) * 60}ms`}>
              <span class="dl-icon" aria-hidden="true">↓</span>
              <span class="card-title">{d.title}</span>
              <span class="card-text">{d.meta}</span>
            </div>
          ))}
        </div>
      );

    case 'contact':
      return (
        <div class="b-contact reveal">
          {b.items.map((c) => <div><span>{c.k}</span><strong>{c.v}</strong></div>)}
          {b.cta && <a href={u(b.cta.href)} target="_blank" rel="noopener" class="btn btn-primary">{b.cta.label} <span class="arrow">↗</span></a>}
        </div>
      );
  }
})}

<style>
  /* 文本 */
  .b-text { display: flex; flex-direction: column; gap: 16px; max-width: 840px; }
  .b-text p { font-size: 17px; color: var(--muted); line-height: 1.95; }
  .b-text.lead p { font-size: clamp(20px, 2.2vw, 28px); color: var(--ink); line-height: 1.7; font-weight: 600; }

  /* 数字：大号渐变字自由排列，不加表格框 */
  .b-stats { display: flex; flex-wrap: wrap; gap: 32px 64px; }
  .b-stat { position: relative; min-width: 160px; }
  .b-stat::before {
    content: ''; position: absolute; left: -10px; top: 6px; width: 46px; height: 46px; border-radius: 50%;
    background: linear-gradient(135deg, var(--c1, var(--brand)), var(--c2, var(--brand-2))); opacity: .14; z-index: -1;
    transition: transform .6s var(--spring);
  }
  .b-stats .num span { background: linear-gradient(120deg, var(--c1, var(--brand)), var(--c2, var(--brand-2))); -webkit-background-clip: text; background-clip: text; }
  .b-note { font-size: 12px; color: var(--muted); margin-top: 14px; }

  /* 卡片 */
  /* ---------- 发展历程：横向推进 → 滚到底缩成全景 ---------- */
  .b-journey { position: relative; height: calc(var(--n) * 20vh + 160vh); }
  .jr-sticky { position: sticky; top: 96px; height: calc(100vh - 128px); min-height: 560px; overflow: hidden; border-radius: 32px; padding: 0 12px;
    /* 浅色：中性浅灰底 + 深色文字，只有曲线是橙粉渐变；深色：青紫粉（星空感） */
    --jr-ink: #141821; --jr-text: #5b6170; --jr-year: #141821; --jr-base: rgba(20,24,33,.1); --jr-dot-glow: rgba(255,122,40,.45); --jr-ring: rgba(255,122,40,.16);
    --jr-s1: #ffb020; --jr-s2: #ff6a3d; --jr-s3: #ff3d8b; --jr-era1: #141821; --jr-era2: #141821;
    background: linear-gradient(160deg, #fbfbfc, #f2f3f6);
    box-shadow: inset 0 0 0 1px rgba(20,24,33,.06); color: var(--jr-ink); }
  :global([data-theme="dark"]) .jr-sticky { --jr-ink: #fff; --jr-text: rgba(255,255,255,.82); --jr-year: #9fd8ff; --jr-base: rgba(255,255,255,.12); --jr-dot-glow: #9ab8ff; --jr-ring: rgba(255,255,255,.12);
    --jr-s1: #00c1de; --jr-s2: #7b6cff; --jr-s3: #ff7ad9; --jr-era1: #7ce8ff; --jr-era2: #c9a8ff;
    background: radial-gradient(60% 80% at 80% 20%, rgba(123,108,255,.35), transparent 60%), radial-gradient(50% 60% at 10% 90%, rgba(0,193,222,.25), transparent 60%), linear-gradient(160deg, #070b2a, #140a3d 60%, #2a0b45); box-shadow: none; }
  .jr-track { position: relative; width: var(--bigw); height: 100%; transition: width .9s var(--ease); will-change: transform; }
  .b-journey.zooming .jr-track { transition: width .9s var(--ease), transform .9s var(--ease); }
  .b-journey.fit .jr-track { width: 100%; transform: none !important; }
  .jr-svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .jr-base { fill: none; stroke: var(--jr-base); stroke-width: 3; }
  .jr-line { fill: none; stroke: url(#jr-grad); stroke-width: 4; stroke-linecap: round; }
  .jr-svg .s1 { stop-color: var(--jr-s1); } .jr-svg .s2 { stop-color: var(--jr-s2); } .jr-svg .s3 { stop-color: var(--jr-s3); }
  .jr-blur { stroke-width: 12; opacity: .45; filter: blur(5px); }
  .jr-node { position: absolute; width: 0; height: 0; }
  .jr-dot { position: absolute; width: 16px; height: 16px; left: -8px; top: -8px; border-radius: 50%; background: #fff; box-shadow: 0 0 0 5px var(--jr-ring), 0 0 20px var(--jr-dot-glow); transform: scale(.45); opacity: .5; transition: transform .6s var(--spring), opacity .4s; }
  .jr-node.era .jr-dot { width: 24px; height: 24px; left: -12px; top: -12px; background: radial-gradient(circle, #fff 30%, var(--jr-s2) 31%, #fff 62%); }
  .jr-card { position: absolute; left: 50%; width: 250px; translate: -50% 0; opacity: 0; transform: translateY(12px); transition: opacity .6s var(--ease), transform .6s var(--spring), width .9s var(--ease); }
  .fit .jr-card { width: 136px; }
  .jr-node.up .jr-card { bottom: 20px; }
  .jr-node.first .jr-card { translate: -14px 0; }
  .jr-node.last .jr-card { translate: calc(-100% + 14px) 0; text-align: right; }
  .jr-node:not(.up) .jr-card { top: 20px; transform: translateY(-12px); }
  .jr-node.on .jr-dot { transform: scale(1); opacity: 1; }
  .jr-node.on .jr-card { opacity: 1; transform: none; }
  .jr-era { display: block; font-size: 24px; transition: font-size .9s var(--ease); font-weight: 900; line-height: 1.3; margin-bottom: 2px; background: linear-gradient(90deg, var(--jr-era1), var(--jr-era2)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .jr-year { display: block; font-size: 44px; transition: font-size .9s var(--ease); font-weight: 900; color: var(--jr-year); line-height: 1.1; font-variant-numeric: tabular-nums; }
  .jr-card p { margin-top: 4px; font-size: 15px; line-height: 1.55; transition: font-size .9s var(--ease); color: var(--jr-text); }
  .fit .jr-era { font-size: 15px; }
  .fit .jr-year { font-size: 24px; }
  .fit .jr-card p { font-size: 12.5px; line-height: 1.5; }
  @media (max-width: 1100px) {
    .b-journey { height: auto; }
    .jr-sticky { position: relative; top: 0; height: auto; min-height: 0; border-radius: 26px; padding: 28px 22px; }
    .jr-track { width: auto; transform: none !important; height: auto; display: flex; flex-direction: column; gap: 22px; padding-left: 22px; border-left: 2px solid var(--jr-base); }
    .jr-svg { display: none; }
    .jr-node { position: relative; left: auto !important; top: auto !important; width: auto; height: auto; }
    .jr-dot { left: -31px; top: 8px; transform: none; opacity: 1; }
    .jr-node.era .jr-dot { left: -35px; }
    .jr-card, .jr-node.up .jr-card, .jr-node:not(.up) .jr-card { position: static; width: auto; translate: none; opacity: 1; transform: none; }
    .jr-year { font-size: 32px; }
    .jr-card p { font-size: 14px; }
  }

  /* 重点产品：便当盒排布，前两张大、后三张小 */
  .b-cards.featured { display: grid; grid-template-columns: repeat(6, 1fr); gap: 20px; margin-bottom: 20px; }
  .b-cards.featured > * { grid-column: span 2; }
  .b-cards.featured > :nth-child(-n+2) { grid-column: span 3; }
  .card-logo { display: flex; align-items: center; height: 56px; margin-bottom: 18px; }
  .card-logo img { max-height: 100%; max-width: 70%; object-fit: contain; }
  .card-logo .logo-dark { display: none; }
  :global([data-theme="dark"]) .card-logo:has(.logo-dark) .logo-light { display: none; }
  :global([data-theme="dark"]) .card-logo .logo-dark { display: block; }
  .b-cards.featured > :nth-child(n+3) .card-logo { height: 44px; }
  .b-cards { display: grid; gap: 20px; }
  .b-cards.c2 { grid-template-columns: repeat(2, 1fr); }
  .b-cards.c3 { grid-template-columns: repeat(3, 1fr); }
  .b-cards.c4 { grid-template-columns: repeat(4, 1fr); }

  /* 封面 */
  .b-covers { display: grid; grid-template-columns: repeat(6, 1fr); gap: 22px; }
  .b-cover:nth-child(even) { margin-top: 28px; }
  .cv-title { display: block; margin-top: 10px; font-size: 14px; font-weight: 600; color: var(--ink); line-height: 1.35; }
  .b-cover small { display: block; margin-top: 4px; font-size: 13px; color: var(--muted); }

  /* 标签 */
  .b-tags h4 { font-size: 16px; font-weight: 800; margin-bottom: 14px; color: var(--ink); }
  .tags { display: flex; flex-wrap: wrap; gap: 10px; }
  .tag {
    padding: 10px 18px; border-radius: 999px; background: var(--surface); font-size: 15px; font-weight: 500; cursor: default;
    box-shadow: 0 6px 16px -10px rgba(10,22,48,.25); transition: transform .4s var(--spring), background .25s, color .25s;
  }

  /* 实时股价 */
  .b-stock { display: grid; grid-template-columns: auto 1fr; align-items: center; gap: 16px 40px; padding: 28px 32px; margin-bottom: 40px; border-radius: 28px; background: var(--surface); box-shadow: 0 18px 40px -26px rgba(10,22,48,.35); }
  .sk-id { display: flex; flex-direction: column; }
  .sk-id strong { font-size: 18px; color: var(--ink); }
  .sk-id span { font-size: 13px; color: var(--muted); font-weight: 700; letter-spacing: .05em; }
  .sk-price { display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap; font-variant-numeric: tabular-nums; }
  .sk-price strong { font-size: clamp(40px, 5vw, 56px); font-weight: 900; line-height: 1; color: var(--ink); }
  .sk-price span { font-size: 18px; font-weight: 700; }
  .sk-meta { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; padding-top: 16px; border-top: 1px solid var(--line); }
  .sk-meta dt { font-size: 12px; color: var(--muted); }
  .sk-meta dd { font-size: 16px; font-weight: 700; color: var(--ink); font-variant-numeric: tabular-nums; }
  .sk-note { grid-column: 1 / -1; font-size: 12px; color: var(--muted); }
  .sk-note a { color: var(--brand); font-weight: 700; }

  /* 步骤：彩色圆形编号 + 连线 */
  .b-steps { list-style: none; display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; gap: 16px; position: relative; }
  .b-steps::before { content: ''; position: absolute; left: 28px; right: 28px; top: 28px; border-top: 2px dashed color-mix(in srgb, var(--c1, var(--brand)) 35%, transparent); }
  .step { position: relative; display: flex; flex-direction: column; gap: 6px; }
  .step-no {
    width: 56px; height: 56px; border-radius: 50%; display: grid; place-items: center; font-size: 16px; font-weight: 900; color: #fff;
    background: linear-gradient(135deg, var(--c1, var(--brand)), var(--c2, var(--brand-2))); margin-bottom: 10px;
    box-shadow: 0 10px 20px -10px var(--c1, var(--brand)); transition: transform .5s var(--spring);
  }
  .step strong { font-size: 19px; font-weight: 800; color: var(--ink); }
  .step span:last-child:not(.step-no) { font-size: 14px; color: var(--muted); }

  /* 时间线 */
  .b-timeline { list-style: none; display: grid; grid-template-columns: repeat(6, 1fr); gap: 16px; }
  .b-timeline li { position: relative; padding: 24px 20px; border-radius: 24px; background: var(--surface); box-shadow: 0 10px 24px -18px rgba(10,22,48,.3); transition: transform .5s var(--spring); cursor: default; }
  .b-timeline li:nth-child(even) { margin-top: 36px; }
  .tl-year { font-size: 36px; font-weight: 900; display: block; line-height: 1.1; background: linear-gradient(120deg, var(--c1, var(--brand)), var(--c2, var(--brand-2))); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .tl-dot { display: none; }
  .b-timeline p { font-size: 14px; color: var(--muted); margin-top: 8px; }

  /* 荣誉 */
  .b-honors { columns: 3; column-gap: 20px; }
  .honor { break-inside: avoid; margin-bottom: 20px; padding: 24px; border-radius: 24px; background: var(--surface); box-shadow: 0 10px 24px -18px rgba(10,22,48,.3); transition: transform .5s var(--spring); }
  .honor-year { display: inline-block; font-size: 14px; font-weight: 800; color: #fff; padding: 3px 14px; border-radius: 999px; background: linear-gradient(120deg, var(--c1, var(--brand)), var(--c2, var(--brand-2))); }
  .honor ul { list-style: none; margin-top: 12px; }
  .honor li { font-size: 14px; color: var(--text); line-height: 1.7; margin-bottom: 8px; padding-left: 18px; position: relative; }
  .honor li::before { content: '★'; position: absolute; left: 0; top: 0; font-size: 11px; color: var(--sun); }

  /* 引言：彩色大卡 */
  .b-quote {
    position: relative; overflow: hidden; border-radius: 32px; padding: 48px; color: #fff;
    background: linear-gradient(135deg, var(--c1, var(--brand)), var(--violet));
  }
  .b-quote::before { content: '“'; position: absolute; right: 36px; top: -30px; font-size: 240px; line-height: 1; color: rgba(255,255,255,.15); font-family: Georgia, serif; }
  .b-quote::after { content: ''; position: absolute; width: 280px; height: 280px; border-radius: 50%; background: var(--c2, var(--brand-2)); filter: blur(60px); opacity: .5; left: -60px; bottom: -120px; }
  .b-quote blockquote { position: relative; z-index: 1; font-size: clamp(20px, 2.4vw, 30px); line-height: 1.7; font-weight: 700; }
  .b-quote figcaption { position: relative; z-index: 1; display: flex; align-items: center; gap: 14px; margin-top: 32px; flex-wrap: wrap; }
  .b-quote figcaption > span:nth-child(2) { display: flex; flex-direction: column; margin-right: auto; }
  .b-quote small { opacity: .8; font-size: 13px; }
  .b-quote .btn-outline { background: var(--surface); box-shadow: none; }
  .b-quote .btn-outline:hover { background: var(--night); }
  .avatar { width: 56px; height: 56px; border-radius: 50%; background: #fff; color: var(--c1, var(--brand)); display: grid; place-items: center; font-weight: 900; }

  /* 致股东信 */
  .b-letter { background: var(--surface); border-radius: 32px; padding: 44px; box-shadow: 0 16px 40px -24px rgba(10,22,48,.3); }
  .b-letter h3 { font-size: 26px; font-weight: 800; color: var(--ink); }
  .b-letter blockquote { margin: 22px 0 28px; padding: 24px 28px; border-radius: 22px; background: linear-gradient(120deg, color-mix(in srgb, var(--c2, var(--brand-2)) 12%, transparent), color-mix(in srgb, var(--violet) 10%, transparent)); font-size: 18px; line-height: 1.9; font-weight: 600; }
  .themes { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .theme { display: flex; flex-direction: column; gap: 6px; padding: 20px; border-radius: 20px; background: var(--bg); transition: transform .5s var(--spring), background .3s; }
  .theme em { font-style: normal; width: 32px; height: 32px; border-radius: 50%; background: linear-gradient(135deg, var(--c1, var(--brand)), var(--c2, var(--brand-2))); color: #fff; display: grid; place-items: center; font-size: 14px; font-weight: 800; }
  .theme strong { font-size: 16px; color: var(--ink); }
  .theme span { color: var(--muted); font-size: 14px; }
  .full { margin-top: 22px; }
  .full summary { cursor: pointer; color: var(--c1, var(--brand)); font-weight: 700; list-style: none; }
  .full summary::after { content: ' ↓'; display: inline-block; transition: transform .4s var(--spring); }
  .full[open] summary::after { transform: rotate(180deg); }
  .full p { margin-top: 12px; color: var(--muted); }
  .b-letter footer { margin-top: 24px; color: var(--muted); font-size: 14px; }

  /* 新闻 */
  .b-news { list-style: none; display: flex; flex-direction: column; gap: 10px; }
  .b-news time { font-size: 13px; color: var(--muted); font-variant-numeric: tabular-nums; }
  .news-tag { font-size: 12px; font-weight: 700; color: var(--c1, var(--brand)); background: color-mix(in srgb, var(--c1, var(--brand)) 10%, transparent); border-radius: 999px; padding: 3px 10px; justify-self: start; }
  .news-title { font-size: 16px; font-weight: 600; }

  /* 公告 */
  .b-docs { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .b-docs > div { background: var(--surface); border-radius: 28px; padding: 28px; box-shadow: 0 12px 30px -20px rgba(10,22,48,.3); }
  .docs-title { font-size: 18px; font-weight: 800; margin-bottom: 8px; }
  .b-docs ul { list-style: none; }
  .b-docs li a { display: grid; grid-template-columns: 92px 1fr auto; gap: 14px; align-items: center; padding: 14px 10px; border-radius: 14px; transition: background .2s, transform .4s var(--spring); }
  .b-docs li a:hover { background: var(--bg); transform: translateX(4px); }
  .b-docs time { font-size: 13px; color: var(--muted); font-variant-numeric: tabular-nums; }
  .b-docs em { font-style: normal; font-size: 12px; font-weight: 700; color: var(--c1, var(--brand)); }
  .docs-more { grid-column: 1 / -1; justify-self: start; }

  /* 联系 */
  .b-contact { display: flex; align-items: center; gap: 48px; flex-wrap: wrap; padding: 32px; border-radius: 28px; background: var(--surface); box-shadow: 0 12px 30px -20px rgba(10,22,48,.3); }
  .b-contact span { display: block; font-size: 13px; color: var(--muted); }
  .b-contact strong { font-size: 22px; font-weight: 800; color: var(--ink); }
  .b-contact .btn { margin-left: auto; }


  .b-subtitle { font-size: 18px; font-weight: 800; color: var(--ink); margin-top: 8px; }


  .card-soon { margin-top: auto; padding-top: 12px; font-size: 12px; color: var(--muted); }
  .ip-card { display: block; }
  .ip-go { display: inline-flex; gap: 6px; margin-top: 10px; font-size: 13px; font-weight: 700; color: var(--c1, var(--brand)); }
  .ip-go .arrow { transition: transform .4s var(--spring); }
  .ip-card:hover .ip-go .arrow { transform: translateX(6px); }
  .ip-card:hover .cover { box-shadow: 0 30px 50px -20px rgba(10,22,48,.55); }
  .b-news li.hide { display: none; }
  .news-row { display: grid; grid-template-columns: 110px 72px 1fr auto; align-items: center; gap: 20px; padding: 22px 24px; border-radius: 22px; background: var(--surface); box-shadow: 0 8px 20px -16px rgba(10,22,48,.3); }
  .news-row { grid-template-columns: 1fr auto; }
  .news-row.has-img { grid-template-columns: 220px 1fr auto; padding: 14px 24px 14px 14px; }
  .news-img { width: 220px; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 14px; }
  .news-body { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .news-meta { display: flex; align-items: center; gap: 12px; }
  .news-text { font-size: 14px; line-height: 1.7; color: var(--muted); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .news-go { font-size: 13px; font-weight: 700; color: var(--c1, var(--brand)); white-space: nowrap; }
  .news-go .arrow { display: inline-block; transition: transform .4s var(--spring); }
  a.news-row { transition: transform .4s var(--spring), box-shadow .3s; }
  a.news-row:hover { transform: translateX(6px); box-shadow: 0 18px 36px -20px rgba(10,22,48,.35); }
  a.news-row:hover .news-go .arrow { transform: translate(3px, -3px); }
  .news-soon { font-size: 12px; color: var(--muted); white-space: nowrap; }


  /* 带业务颜色的卡片：顶部一条渐变色带；带颜色的步骤：各自的渐变圆点与连线 */
  .card-stripe { position: absolute; left: 0; right: 0; top: 0; height: 6px; background: linear-gradient(90deg, var(--c1), var(--c2)); }
  .b-steps:has(.step.colored)::before { display: none; }
  .step.colored::after { content: ''; position: absolute; left: 60px; right: -12px; top: 27px; height: 3px; border-radius: 3px; background: linear-gradient(90deg, var(--c2), transparent); opacity: .5; }
  .step.colored:last-child::after { display: none; }
  .step.colored strong { color: var(--c1); }

  /* IP 墙 */
  .filters { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 24px; align-items: center; }
  .filters .sep { width: 1px; height: 22px; background: var(--line); margin: 0 6px; }
  .chip { border: 0; cursor: pointer; font: inherit; font-size: 14px; font-weight: 600; padding: 8px 16px; border-radius: 999px; background: var(--surface); color: var(--muted); box-shadow: 0 4px 12px -8px rgba(10,22,48,.3); transition: background .25s, color .25s, transform .3s var(--spring); }
  .chip:hover { color: var(--c1, var(--brand)); transform: translateY(-2px); }
  .chip.on { background: linear-gradient(120deg, var(--c1, var(--brand)), var(--c2, var(--brand-2))); color: #fff; }
  .ip-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 22px; }
  .ip-card.hide, .g-item.hide { display: none; }
  .ip-title { display: block; margin-top: 14px; font-size: 16px; line-height: 1.4; }
  .ip-meta { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }
  .ip-genre { width: 100%; font-size: 13px; color: var(--muted); }
  .ip-tag { font-size: 12px; font-weight: 600; color: var(--c1, var(--brand)); background: color-mix(in srgb, var(--c1, var(--brand)) 9%, transparent); padding: 2px 8px; border-radius: 6px; }

  /* 视频墙 */
  .b-aichat { display: flex; align-items: center; gap: 22px; padding: 26px 30px; margin-bottom: 28px; border-radius: 24px; background: linear-gradient(120deg, color-mix(in srgb, var(--brand) 10%, var(--surface)), color-mix(in srgb, var(--brand-2) 12%, var(--surface))); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--brand) 18%, transparent); }
  /* AI 入口按钮：无描边；悬停时出现紫粉色光晕 */
  .b-aichat .btn { border: 0; cursor: pointer; font: inherit; font-weight: 600; transition: box-shadow .35s, transform .4s var(--spring); }
  .b-aichat .btn:hover { box-shadow: 0 10px 28px -6px color-mix(in srgb, var(--pink) 65%, transparent), 0 0 24px color-mix(in srgb, var(--violet) 45%, transparent); }
  .ac-icon { flex-shrink: 0; width: 52px; height: 52px; border-radius: 50%; display: grid; place-items: center; font-size: 22px; color: #fff; background: var(--grad); }
  .ac-text { flex: 1; }
  .ac-text strong { display: block; font-size: 19px; color: var(--ink); }
  .ac-text p { margin-top: 4px; font-size: 15px; color: var(--muted); line-height: 1.6; }
  @media (max-width: 768px) { .b-aichat { flex-direction: column; align-items: flex-start; } }
  .b-videos { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; align-items: start; }
  .video { position: relative; aspect-ratio: 16 / 9; border-radius: 20px; overflow: hidden; color: #fff; grid-column: span 2;
