---
// 内容块渲染器：所有栏目页的内容都通过这里渲染，保证全站视觉与交互一致
import { u } from '../../lib/url';
import type { Block } from '../../content/zh';

interface Props { blocks: Block[] }
const { blocks } = Astro.props;

// 海报色板：以蓝青为主，夹杂紫、粉、橙，像一面海报墙
const palette = [205, 250, 190, 330, 275, 215, 20, 300, 230, 175, 345, 40];
const hue = (s: string) => palette[[...s].reduce((a, c) => a + c.charCodeAt(0), 0) % palette.length];
const isNum = (v: string) => /^[\d,]+$/.test(v);
---
{blocks.map((b) => {
  switch (b.type) {
    case 'text':
      return (
        <div class:list={['b-text reveal', { lead: b.lead }]}>
          {b.paras.map((p) => <p>{p}</p>)}
        </div>
      );

    case 'stats':
      return (
        <div class="reveal">
          <div class:list={['b-stats', `n${Math.min(b.items.length, 4)}`]}>
            {b.items.map((s) => (
              <div class="b-stat">
                <div class="num"><span data-count={isNum(s.value) ? s.value : undefined}>{s.value}</span>{s.unit && <em>{s.unit}</em>}</div>
                <div class="num-label">{s.label}</div>
              </div>
            ))}
          </div>
          {b.note && <p class="b-note">{b.note}</p>}
        </div>
      );

    case 'cards':
      return (
        <div class:list={['b-cards', `c${b.cols ?? 3}`]}>
          {b.items.map((c, i) => {
            const Tag = c.href ? 'a' : 'div';
            return (
              <Tag
                class="card reveal"
                id={c.id}
                href={u(c.href)}
                target={c.external ? '_blank' : undefined}
                rel={c.external ? 'noopener' : undefined}
                style={`--d:${(i % 4) * 70}ms`}
              >
                {c.tag && <span class="card-tag">{c.tag}</span>}
                <span class="card-title">{c.title}</span>
                {c.text && <span class="card-text">{c.text}</span>}
                {c.href && <span class="card-go">{c.external ? '访问官网' : '了解更多'} <span class="arrow">{c.external ? '↗' : '→'}</span></span>}
              </Tag>
            );
          })}
        </div>
      );

    case 'covers':
      return (
        <>
        {b.title && <h4 class="b-subtitle reveal">{b.title}</h4>}
        <div class="b-covers">
          {b.items.map((c, i) => (
            <div class="b-cover reveal" style={`--d:${(i % 6) * 50}ms`}>
              <div class="cover" style={`--h:${hue(c.title)}`}><span>{c.title}</span></div>
              {c.sub && <small>{c.sub}</small>}
            </div>
          ))}
        </div>
        </>
      );

    case 'tags':
      return (
        <div class="b-tags reveal">
          {b.title && <h4>{b.title}</h4>}
          <div class="tags">{b.items.map((t) => <span class="tag">{t}</span>)}</div>
        </div>
      );

    case 'steps':
      return (
        <ol class="b-steps reveal">
          {b.items.map((s, i) => (
            <li class="step" style={`--d:${i * 80}ms`}>
              <span class="step-no">{String(i + 1).padStart(2, '0')}</span>
              <strong>{s.title}</strong>
              {s.text && <span>{s.text}</span>}
            </li>
          ))}
        </ol>
      );

    case 'timeline':
      return (
        <ol class="b-timeline">
          {b.items.map((t, i) => (
            <li class="reveal" style={`--d:${i * 70}ms`}>
              <span class="tl-year">{t.year}</span>
              <span class="tl-dot"></span>
              <p>{t.text}</p>
            </li>
          ))}
        </ol>
      );

    case 'honors':
      return (
        <div class="b-honors">
          {b.items.map((h, i) => (
            <div class="honor reveal" style={`--d:${(i % 3) * 70}ms`}>
              <span class="honor-year">{h.year}</span>
              <ul>{h.items.map((t) => <li>{t}</li>)}</ul>
            </div>
          ))}
        </div>
      );

    case 'quote':
      return (
        <figure class="b-quote reveal">
          <blockquote>{b.text}</blockquote>
          <figcaption>
            <span class="avatar" aria-hidden="true">{b.author?.slice(-2)}</span>
            <span><strong>{b.author}</strong><small>{b.role}</small></span>
            {b.href && <a href={u(b.href)} class="btn btn-outline">{b.hrefLabel} <span class="arrow">→</span></a>}
          </figcaption>
        </figure>
      );

    case 'letter':
      return (
        <article class="b-letter reveal">
          <h3>{b.title}</h3>
          <blockquote>{b.lead}</blockquote>
          <ol class="themes">
            {b.themes.map((t, i) => (
              <li class="theme"><em>{i + 1}</em><strong>{t.k}</strong><span>{t.v}</span></li>
            ))}
          </ol>
          <details class="full">
            <summary><span>阅读全文</span></summary>
            <p>（全文待从官网迁入，正式版在此处展开完整信件内容。）</p>
          </details>
          <footer><strong>{b.author}</strong> · {b.role} · {b.date}</footer>
        </article>
      );

    case 'news':
      return (
        <ul class="b-news">
          {b.items.map((n, i) => (
            <li class="reveal" style={`--d:${i * 60}ms`}>
              <a href="#">
                <time>{n.date}</time>
                {n.tag && <span class="news-tag">{n.tag}</span>}
                <span class="news-title">{n.title}</span>
                <span class="arrow">→</span>
              </a>
            </li>
          ))}
        </ul>
      );

    case 'docs':
      return (
        <div class="b-docs">
          {b.cols.map((col) => (
            <div class="reveal">
              <h4 class="docs-title">{col.title}</h4>
              <ul>
                {col.items.map((d) => (
                  <li><a href={u(b.href)} target="_blank" rel="noopener"><time>{d.date}</time><span>{d.title}</span><em>PDF ↗</em></a></li>
                ))}
              </ul>
            </div>
          ))}
          <a href={u(b.href)} target="_blank" rel="noopener" class="btn btn-outline docs-more">巨潮资讯查看全部 <span class="arrow">↗</span></a>
        </div>
      );

    case 'ipwall': {
      // IP 墙：卡片 = 封面 + 数据标签 + 题材 + 开发状态；顶部按题材/状态筛选（不跳页）
      const genres = [...new Set(b.items.map((x) => x.genre))];
      const statuses = [...new Set(b.items.map((x) => x.status))];
      return (
        <div class="b-ipwall" data-filterable>
          <div class="filters reveal">
            <button class="chip on" data-filter-key="all" data-filter-value="all">全部</button>
            {genres.map((g) => <button class="chip" data-filter-key="genre" data-filter-value={g}>{g}</button>)}
            <span class="sep" aria-hidden="true"></span>
            {statuses.map((t) => <button class="chip" data-filter-key="status" data-filter-value={t}>{t}</button>)}
          </div>
          <div class="ip-grid">
            {b.items.map((x, i) => (
              <article class="ip-card reveal" data-genre={x.genre} data-status={x.status} style={`--d:${(i % 4) * 60}ms`}>
                <div class="cover" style={`--h:${hue(x.title)}`}>
                  <span class:list={['status', `s-${['可授权', '改编中', '已授权'].indexOf(x.status)}`]}>{x.status}</span>
                  <span>{x.title}</span>
                </div>
                <div class="ip-meta">
                  <span class="ip-genre">{x.genre}{x.forms.length > 0 && ` · ${x.forms.join(' / ')}`}</span>
                  {x.tags.map((t) => <span class="ip-tag">#{t}</span>)}
                </div>
              </article>
            ))}
          </div>
          {b.note && <p class="b-note">{b.note}</p>}
        </div>
      );
    }

    case 'videos':
      // 预告片 / 样片墙：原型为占位，正式版接入视频文件或视频平台
      return (
        <div class="b-videos">
          {b.items.map((v, i) => (
            <figure class:list={['video reveal', { vertical: v.vertical }]} style={`--d:${(i % 4) * 70}ms;--h:${hue(v.title)}`}>
              <button class="play" aria-label={`播放 ${v.title}（待接入）`} title="视频待接入">▶</button>
              <figcaption><strong>{v.title}</strong>{v.sub && <small>{v.sub}</small>}</figcaption>
            </figure>
          ))}
          {b.note && <p class="b-note">{b.note}</p>}
        </div>
      );

    case 'people':
      return (
        <div class:list={['b-people', `c${b.cols ?? 3}`]}>
          {b.items.map((p, i) => (
            <div class="person card reveal" style={`--d:${(i % 4) * 70}ms`}>
              <span class="p-avatar" aria-hidden="true">{p.name.replace(/[（(].*$/, '').slice(-2)}</span>
              <span class="card-title">{p.name}</span>
              <span class="card-tag">{p.role}</span>
              {p.text && <span class="card-text">{p.text}</span>}
              {(p.email || p.phone) && (
                <span class="p-contact">
                  {p.email && <a href={`mailto:${p.email}`}>✉ {p.email}</a>}
                  {p.phone && <span>☏ {p.phone}</span>}
                </span>
              )}
            </div>
          ))}
        </div>
      );

    case 'contacts':
      // 合作页：每类合作一张卡（负责人 + 说明），点“发送咨询”会预选下方表单的合作类型
      return (
        <div class="b-contacts">
          {b.items.map((c, i) => (
            <div class="contact-card card reveal" id={c.id} style={`--d:${(i % 3) * 70}ms`}>
              <span class="cc-badge" aria-live="polite"></span>
              <span class="card-tag">{c.tag}</span>
              <span class="card-title">{c.title}</span>
              <span class="card-text">{c.text}</span>
              <div class="cc-people">
                {c.people.map((p) => (
                  <div class="cc-person">
                    <span class="p-avatar sm" aria-hidden="true">{p.name.replace(/[（(].*$/, '').slice(-2)}</span>
                    <span>
                      <strong>{p.name}</strong><small>{p.role}</small>
                      {p.email && <a href={`mailto:${p.email}`}>{p.email}</a>}
                      {p.phone && <small>{p.phone}</small>}
                    </span>
                  </div>
                ))}
              </div>
              <button class="card-go cc-go" data-topic={c.title}>发送咨询 <span class="arrow">→</span></button>
            </div>
          ))}
        </div>
      );

    case 'form':
      // 留资表单：原型阶段不提交到后台，提交后提示；正式版接入表单服务并按合作类型自动分派
      return (
        <form class="b-form reveal" id={b.id ?? 'inquiry'} data-proto-form data-astro-reload>
          <div class="f-row">
            <label>合作类型<select name="topic" required>{b.topics.map((t) => <option>{t}</option>)}</select></label>
            <label>姓名<input name="name" required placeholder="您的姓名" /></label>
          </div>
          <div class="f-row">
            <label>公司 / 机构<input name="company" placeholder="公司名称" /></label>
            <label>职务<input name="title" placeholder="您的职务" /></label>
          </div>
          <div class="f-row">
            <label>邮箱<input name="email" type="email" required placeholder="name@company.com" /></label>
            <label>电话 / 微信<input name="phone" placeholder="便于我们联系您" /></label>
          </div>
          <label>需求描述<textarea name="message" rows="4" placeholder="简单介绍您的需求，我们会尽快安排对应负责人联系您"></textarea></label>
          <div class="f-foot">
            <button class="btn btn-primary" type="submit">提交咨询 <span class="arrow">→</span></button>
            <p class="f-msg" role="status" aria-live="polite"></p>
          </div>
          {b.note && <p class="b-note">{b.note}</p>}
        </form>
      );

    case 'gallery': {
      const tags = [...new Set(b.items.map((x) => x.tag))];
      return (
        <div class="b-gallery" data-filterable>
          <div class="filters reveal">
            <button class="chip on" data-filter-key="all" data-filter-value="all">全部</button>
            {tags.map((t) => <button class="chip" data-filter-key="tag" data-filter-value={t}>{t}</button>)}
          </div>
          <div class="g-grid">
            {b.items.map((x, i) => (
              <figure class:list={['g-item reveal', `g${i % 5}`]} data-tag={x.tag} style={`--d:${(i % 4) * 60}ms;--h:${hue(x.caption)}`}>
                <span class="g-ph" aria-hidden="true">照片待提供</span>
                <figcaption><em>{x.tag}</em>{x.caption}</figcaption>
              </figure>
            ))}
          </div>
          {b.note && <p class="b-note">{b.note}</p>}
        </div>
      );
    }

    case 'faq':
      return (
        <div class="b-faq reveal">
          {b.items.map((f) => (
            <details class="faq">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      );

    case 'logos':
      return (
        <div class="reveal">
          <div class="b-logos">{b.items.map((l) => <span class="logo-tile">{l}</span>)}</div>
          {b.note && <p class="b-note">{b.note}</p>}
        </div>
      );

    case 'downloads':
      return (
        <div class="b-downloads">
          {b.items.map((d, i) => (
            <a href="#" class="dl card reveal" style={`--d:${(i % 4) * 60}ms`} title="文件待提供">
              <span class="dl-icon" aria-hidden="true">↓</span>
              <span class="card-title">{d.title}</span>
              <span class="card-text">{d.meta}</span>
            </a>
          ))}
        </div>
      );

    case 'contact':
      return (
        <div class="b-contact reveal">
          {b.items.map((c) => <div><span>{c.k}</span><strong>{c.v}</strong></div>)}
          {b.cta && <a href={u(b.cta.href)} target="_blank" rel="noopener" class="btn btn-primary">{b.cta.label} <span class="arrow">↗</span></a>}
        </div>
      );
  }
})}

<style>
  /* 文本 */
  .b-text { display: flex; flex-direction: column; gap: 16px; max-width: 840px; }
  .b-text p { font-size: 17px; color: var(--muted); line-height: 1.95; }
  .b-text.lead p { font-size: clamp(20px, 2.2vw, 28px); color: var(--ink); line-height: 1.7; font-weight: 600; }

  /* 数字：大号渐变字自由排列，不加表格框 */
  .b-stats { display: flex; flex-wrap: wrap; gap: 32px 64px; }
  .b-stat { position: relative; min-width: 160px; }
  .b-stat::before {
    content: ''; position: absolute; left: -10px; top: 6px; width: 46px; height: 46px; border-radius: 50%;
    background: linear-gradient(135deg, var(--c1, var(--brand)), var(--c2, var(--brand-2))); opacity: .14; z-index: -1;
    transition: transform .6s var(--spring);
  }
  .b-stats .num span { background: linear-gradient(120deg, var(--c1, var(--brand)), var(--c2, var(--brand-2))); -webkit-background-clip: text; background-clip: text; }
  .b-note { font-size: 12px; color: var(--muted); margin-top: 14px; }

  /* 卡片 */
  .b-cards { display: grid; gap: 20px; }
  .b-cards.c2 { grid-template-columns: repeat(2, 1fr); }
  .b-cards.c3 { grid-template-columns: repeat(3, 1fr); }
  .b-cards.c4 { grid-template-columns: repeat(4, 1fr); }

  /* 封面 */
  .b-covers { display: grid; grid-template-columns: repeat(6, 1fr); gap: 22px; }
  .b-cover:nth-child(even) { margin-top: 28px; }
  .b-cover small { display: block; margin-top: 10px; font-size: 13px; color: var(--muted); }

  /* 标签 */
  .b-tags h4 { font-size: 16px; font-weight: 800; margin-bottom: 14px; color: var(--ink); }
  .tags { display: flex; flex-wrap: wrap; gap: 10px; }
  .tag {
    padding: 10px 18px; border-radius: 999px; background: var(--surface); font-size: 15px; font-weight: 500; cursor: default;
    box-shadow: 0 6px 16px -10px rgba(10,22,48,.25); transition: transform .4s var(--spring), background .25s, color .25s;
  }

  /* 步骤：彩色圆形编号 + 连线 */
  .b-steps { list-style: none; display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; gap: 16px; position: relative; }
  .b-steps::before { content: ''; position: absolute; left: 28px; right: 28px; top: 28px; border-top: 2px dashed color-mix(in srgb, var(--c1, var(--brand)) 35%, transparent); }
  .step { position: relative; display: flex; flex-direction: column; gap: 6px; }
  .step-no {
    width: 56px; height: 56px; border-radius: 50%; display: grid; place-items: center; font-size: 16px; font-weight: 900; color: #fff;
    background: linear-gradient(135deg, var(--c1, var(--brand)), var(--c2, var(--brand-2))); margin-bottom: 10px;
    box-shadow: 0 10px 20px -10px var(--c1, var(--brand)); transition: transform .5s var(--spring);
  }
  .step strong { font-size: 19px; font-weight: 800; color: var(--ink); }
  .step span:last-child:not(.step-no) { font-size: 14px; color: var(--muted); }

  /* 时间线 */
  .b-timeline { list-style: none; display: grid; grid-template-columns: repeat(6, 1fr); gap: 16px; }
  .b-timeline li { position: relative; padding: 24px 20px; border-radius: 24px; background: var(--surface); box-shadow: 0 10px 24px -18px rgba(10,22,48,.3); transition: transform .5s var(--spring); cursor: default; }
  .b-timeline li:nth-child(even) { margin-top: 36px; }
  .tl-year { font-size: 36px; font-weight: 900; display: block; line-height: 1.1; background: linear-gradient(120deg, var(--c1, var(--brand)), var(--c2, var(--brand-2))); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .tl-dot { display: none; }
  .b-timeline p { font-size: 14px; color: var(--muted); margin-top: 8px; }

  /* 荣誉 */
  .b-honors { columns: 3; column-gap: 20px; }
  .honor { break-inside: avoid; margin-bottom: 20px; padding: 24px; border-radius: 24px; background: var(--surface); box-shadow: 0 10px 24px -18px rgba(10,22,48,.3); transition: transform .5s var(--spring); }
  .honor-year { display: inline-block; font-size: 14px; font-weight: 800; color: #fff; padding: 3px 14px; border-radius: 999px; background: linear-gradient(120deg, var(--c1, var(--brand)), var(--c2, var(--brand-2))); }
  .honor ul { list-style: none; margin-top: 12px; }
  .honor li { font-size: 14px; color: var(--text); line-height: 1.7; margin-bottom: 8px; padding-left: 18px; position: relative; }
  .honor li::before { content: '★'; position: absolute; left: 0; top: 0; font-size: 11px; color: var(--sun); }

  /* 引言：彩色大卡 */
  .b-quote {
    position: relative; overflow: hidden; border-radius: 32px; padding: 48px; color: #fff;
    background: linear-gradient(135deg, var(--c1, var(--brand)), var(--violet));
  }
  .b-quote::before { content: '“'; position: absolute; right: 36px; top: -30px; font-size: 240px; line-height: 1; color: rgba(255,255,255,.15); font-family: Georgia, serif; }
  .b-quote::after { content: ''; position: absolute; width: 280px; height: 280px; border-radius: 50%; background: var(--c2, var(--brand-2)); filter: blur(60px); opacity: .5; left: -60px; bottom: -120px; }
  .b-quote blockquote { position: relative; z-index: 1; font-size: clamp(20px, 2.4vw, 30px); line-height: 1.7; font-weight: 700; }
  .b-quote figcaption { position: relative; z-index: 1; display: flex; align-items: center; gap: 14px; margin-top: 32px; flex-wrap: wrap; }
  .b-quote figcaption > span:nth-child(2) { display: flex; flex-direction: column; margin-right: auto; }
  .b-quote small { opacity: .8; font-size: 13px; }
  .b-quote .btn-outline { background: #fff; box-shadow: none; }
  .b-quote .btn-outline:hover { background: var(--ink); }
  .avatar { width: 56px; height: 56px; border-radius: 50%; background: #fff; color: var(--c1, var(--brand)); display: grid; place-items: center; font-weight: 900; }

  /* 致股东信 */
  .b-letter { background: var(--surface); border-radius: 32px; padding: 44px; box-shadow: 0 16px 40px -24px rgba(10,22,48,.3); }
  .b-letter h3 { font-size: 26px; font-weight: 800; color: var(--ink); }
  .b-letter blockquote { margin: 22px 0 28px; padding: 24px 28px; border-radius: 22px; background: linear-gradient(120deg, color-mix(in srgb, var(--c2, var(--brand-2)) 12%, transparent), color-mix(in srgb, var(--violet) 10%, transparent)); font-size: 18px; line-height: 1.9; font-weight: 600; }
  .themes { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .theme { display: flex; flex-direction: column; gap: 6px; padding: 20px; border-radius: 20px; background: var(--bg); transition: transform .5s var(--spring), background .3s; }
  .theme em { font-style: normal; width: 32px; height: 32px; border-radius: 50%; background: linear-gradient(135deg, var(--c1, var(--brand)), var(--c2, var(--brand-2))); color: #fff; display: grid; place-items: center; font-size: 14px; font-weight: 800; }
  .theme strong { font-size: 16px; color: var(--ink); }
  .theme span { color: var(--muted); font-size: 14px; }
  .full { margin-top: 22px; }
  .full summary { cursor: pointer; color: var(--c1, var(--brand)); font-weight: 700; list-style: none; }
  .full summary::after { content: ' ↓'; display: inline-block; transition: transform .4s var(--spring); }
  .full[open] summary::after { transform: rotate(180deg); }
  .full p { margin-top: 12px; color: var(--muted); }
  .b-letter footer { margin-top: 24px; color: var(--muted); font-size: 14px; }

  /* 新闻 */
  .b-news { list-style: none; display: flex; flex-direction: column; gap: 10px; }
  .b-news a {
    display: grid; grid-template-columns: 110px 72px 1fr 40px; align-items: center; gap: 20px;
    padding: 22px 24px; border-radius: 22px; background: var(--surface);
