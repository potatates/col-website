---
// 右下角 AI 助手：浮动按钮 + 对话面板（替代原“回到顶部”按钮）。
// 原型阶段按关键词匹配预设问答（见 content/zh.ts 的 aiAssistant），交互逻辑在 BaseLayout 的全站脚本里。
import { useLang } from '../../lib/i18n';
const { c, ui, lang } = useLang(Astro.url);
const { aiAssistant } = c;
// 预设答案里的站内链接，英文版加 /en 前缀
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + (lang === 'en' ? '/en' : '');
---
<div class="ai" id="ai-chat" data-base={base}>
  <script type="application/json" id="ai-data" set:html={JSON.stringify(aiAssistant)} />

  <section class="ai-panel" id="ai-panel" role="dialog" aria-label={aiAssistant.title} aria-hidden="true">
    <header class="ai-head">
      <span class="ai-avatar" aria-hidden="true">✦</span>
      <span class="ai-titles">
        <strong>{aiAssistant.title}</strong>
        <small>{ui.aiNote}</small>
      </span>
      <button class="ai-close" data-ai-close aria-label={ui.close}>×</button>
    </header>
    <div class="ai-log" id="ai-log" aria-live="polite">
      <div class="msg bot">{aiAssistant.greeting}</div>
      <div class="ai-chips">
        {aiAssistant.suggestions.map((q) => <button class="ai-chip" data-ai-q={q}>{q}</button>)}
      </div>
    </div>
    <form class="ai-form" data-ai-form data-astro-reload>
      <textarea name="q" rows="1" autocomplete="off" placeholder={ui.aiPlaceholder} aria-label={ui.aiInput}></textarea>
      <button type="submit" aria-label={ui.send}>↑</button>
    </form>
  </section>

  <!-- 首次进站的问候气泡（每次会话只出现一次，见 BaseLayout 全站脚本） -->
  <div class="ai-nudge" id="ai-nudge" role="status">
    <button class="ai-nudge-x" data-ai-nudge-close aria-label={ui.close}>×</button>
    <p>{ui.aiNudge}</p>
    <button class="ai-nudge-go" data-ai-open>{ui.aiNudgeGo} <span aria-hidden="true">→</span></button>
  </div>

  <button class="ai-fab" data-ai-open aria-controls="ai-panel" aria-expanded="false">
    <span class="spark" aria-hidden="true">✦</span><span class="ai-fab-text">{ui.aiFab}</span>
  </button>
</div>

<style>
  /* 容器本身不拦截点击；只有按钮和打开的面板可交互 */
  .ai { position: fixed; right: 24px; bottom: 24px; z-index: 60; display: flex; flex-direction: column; align-items: flex-end; gap: 14px; pointer-events: none; }
  .ai-fab, .ai.open .ai-panel { pointer-events: auto; }

  /* 圆形按钮：青蓝到紫的渐变光球，悬停时上方出现文字提示 */
  .ai-fab {
    position: relative; width: 58px; height: 58px; border-radius: 50%; border: 0; cursor: pointer; color: #fff; isolation: isolate;
    display: grid; place-items: center; background: linear-gradient(135deg, var(--brand-2), var(--violet));
    box-shadow: 0 12px 30px -8px color-mix(in srgb, var(--violet) 60%, transparent);
    transition: transform .4s var(--spring), box-shadow .4s;
  }
  .ai-fab::before { content: ''; position: absolute; inset: 3px; border-radius: 50%; z-index: -1; background: radial-gradient(circle at 35% 30%, rgba(255,255,255,.3), transparent 60%); }
  .ai-fab:hover { transform: translateY(-3px) scale(1.06); box-shadow: 0 16px 34px -8px color-mix(in srgb, var(--violet) 70%, transparent), 0 0 24px color-mix(in srgb, var(--brand-2) 45%, transparent); }
  .spark { font-size: 22px; line-height: 1; display: inline-block; animation: twinkle 3s ease-in-out infinite; }
  @keyframes twinkle { 50% { transform: rotate(90deg) scale(1.15); } }
  /* 文字提示：悬停时出现在光球正上方 */
  .ai-fab-text {
    position: absolute; bottom: calc(100% + 10px); right: 50%; translate: 50% 0; white-space: nowrap; pointer-events: none;
    font-size: 13px; font-weight: 600; color: var(--ink); padding: 6px 12px; border-radius: 999px;
    background: var(--surface); box-shadow: 0 8px 20px -10px color-mix(in srgb, var(--violet) 55%, rgba(10,22,48,.4));
    opacity: 0; transform: translateY(4px); transition: opacity .2s, transform .3s var(--spring);
  }
  .ai-fab:hover .ai-fab-text, .ai-fab:focus-visible .ai-fab-text { opacity: 1; transform: none; }
  .ai.open .ai-fab-text, .ai.nudge .ai-fab-text { display: none; }

  /* 面板关闭时，光球外圈周期性泛起两道光环 */
  .ai:not(.open) .ai-fab::after {
    content: ''; position: absolute; inset: 0; border-radius: 50%; z-index: -1; pointer-events: none;
    animation: halo 4.5s var(--ease) infinite 1.5s;
  }
  @keyframes halo {
    0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--violet) 55%, transparent), 0 0 0 0 color-mix(in srgb, var(--brand-2) 45%, transparent); }
    35%, 100% { box-shadow: 0 0 0 14px transparent, 0 0 0 26px transparent; }
  }

  /* 问候气泡 */
  .ai-nudge {
    position: relative; width: 260px; padding: 16px 18px 14px; border-radius: 22px 22px 8px 22px; pointer-events: none;
    background: var(--surface); color: var(--text); font-size: 14px; line-height: 1.65;
    box-shadow: 0 20px 44px -18px color-mix(in srgb, var(--violet) 50%, rgba(10,22,48,.45));
    opacity: 0; visibility: hidden; transform: translateY(10px) scale(.95); transform-origin: bottom right;
    transition: opacity .3s, transform .45s var(--spring), visibility .3s;
  }
  .ai-nudge::before { content: ''; position: absolute; inset: 0; border-radius: inherit; padding: 1.5px; pointer-events: none;
    background: linear-gradient(120deg, var(--brand-2), var(--brand-2), var(--violet));
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude; }
  .ai.nudge .ai-nudge { opacity: 1; visibility: visible; transform: none; pointer-events: auto; }
  .ai.open .ai-nudge { display: none; }
  .ai-nudge p { padding-right: 14px; }
  .ai-nudge-x { position: absolute; top: 8px; right: 10px; border: 0; background: none; color: var(--muted); font-size: 18px; line-height: 1; cursor: pointer; }
  .ai-nudge-go { margin-top: 10px; border: 0; cursor: pointer; font: inherit; font-size: 13px; font-weight: 600; color: #fff; padding: 6px 14px; border-radius: 999px; background: linear-gradient(120deg, var(--brand-2), var(--violet)); transition: transform .3s var(--spring), box-shadow .3s; }
  .ai-nudge-go:hover { transform: translateY(-2px); box-shadow: 0 8px 18px -8px color-mix(in srgb, var(--violet) 60%, transparent); }

  /* 面板：柔和的彩色光晕代替整条色块标题栏 */
  .ai-panel {
    position: relative; isolation: isolate; width: 390px; height: 560px; max-height: calc(100vh - 120px); display: flex; flex-direction: column; overflow: hidden;
    background: var(--surface); border-radius: 30px; box-shadow: 0 30px 70px -24px color-mix(in srgb, var(--violet) 45%, rgba(10,22,48,.5));
    transform-origin: bottom right; opacity: 0; visibility: hidden; transform: translateY(16px) scale(.94);
    transition: opacity .25s, transform .4s var(--spring), visibility .25s;
  }
  .ai-panel::before {
    content: ''; position: absolute; inset: -40% -20% auto; height: 70%; z-index: -1; pointer-events: none; filter: blur(40px); opacity: .5;
    background: radial-gradient(40% 50% at 20% 60%, var(--brand-2), transparent 70%), radial-gradient(40% 50% at 55% 50%, var(--violet), transparent 70%), radial-gradient(35% 45% at 85% 65%, var(--brand), transparent 70%);
  }
  .ai.open .ai-panel { opacity: 1; visibility: visible; transform: none; }
  .ai-head { display: flex; align-items: center; gap: 12px; padding: 18px 18px 12px; }
  .ai-avatar {
    width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; color: #fff; font-size: 18px; flex-shrink: 0;
    background: linear-gradient(135deg, var(--brand-2), var(--violet));
  }
  .ai-titles { display: flex; flex-direction: column; margin-right: auto; line-height: 1.35; }
  .ai-titles strong { font-size: 16px; font-weight: 700; color: var(--ink); }
  .ai-titles small { font-size: 11px; color: var(--muted); }
  .ai-close { border: 0; background: color-mix(in srgb, var(--surface) 70%, transparent); color: var(--ink); width: 34px; height: 34px; border-radius: 50%; font-size: 20px; cursor: pointer; line-height: 1; backdrop-filter: blur(8px); transition: transform .3s var(--spring); }
  .ai-close:hover { transform: rotate(90deg); }

  .ai-log { flex: 1; overflow-y: auto; padding: 6px 16px 16px; display: flex; flex-direction: column; gap: 10px; scrollbar-width: thin; }
  .ai-log :global(.msg) { max-width: 88%; padding: 10px 14px; border-radius: 20px; font-size: 14px; line-height: 1.7; animation: pop .35s var(--spring) both; }
  .ai-log :global(.msg.bot) { align-self: flex-start; color: var(--text); background: color-mix(in srgb, var(--violet) 7%, var(--bg)); border-bottom-left-radius: 8px; }
  .ai-log :global(.msg.user) { align-self: flex-end; color: #fff; background: linear-gradient(120deg, var(--brand-2), var(--violet)); border-bottom-right-radius: 8px; }
  .ai-log :global(.msg a) { display: inline-flex; margin-top: 8px; font-weight: 700; background: linear-gradient(90deg, var(--brand-2), var(--violet)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .ai-log :global(.typing) { display: inline-flex; gap: 4px; }
  .ai-log :global(.typing i) { width: 6px; height: 6px; border-radius: 50%; background: linear-gradient(135deg, var(--brand-2), var(--violet)); animation: blink 1s infinite; }
  .ai-log :global(.typing i:nth-child(2)) { animation-delay: .15s; }
  .ai-log :global(.typing i:nth-child(3)) { animation-delay: .3s; }
  @keyframes blink { 50% { opacity: .2; transform: translateY(-2px); } }
  @keyframes pop { from { opacity: 0; transform: translateY(8px) scale(.96); } }
  .ai-log :global(.ai-chips) { display: flex; flex-wrap: wrap; gap: 8px; }
  .ai-log :global(.ai-chip) { border: 0; background: color-mix(in srgb, var(--brand-2) 10%, var(--surface)); color: var(--ink); font: inherit; font-size: 13px; padding: 7px 13px; border-radius: 999px; cursor: pointer; transition: background .25s, color .25s, transform .3s var(--spring); }
  .ai-log :global(.ai-chip:nth-child(3n+2)) { background: color-mix(in srgb, var(--violet) 10%, var(--surface)); }
  .ai-log :global(.ai-chip:nth-child(3n)) { background: color-mix(in srgb, var(--brand) 10%, var(--surface)); }
  .ai-log :global(.ai-chip:hover) { color: #fff; background: linear-gradient(120deg, var(--brand-2), var(--violet)); transform: translateY(-2px); }

  /* 合作留言卡 */
  .ai-log :global(.msg.has-lead) { max-width: 100%; width: 100%; }
  .ai-log :global(.lead) { display: flex; flex-direction: column; gap: 10px; margin-top: 10px; padding: 14px; border-radius: 18px; background: var(--surface); }
  .ai-log :global(.lead-f) { display: flex; flex-direction: column; gap: 4px; border: 0; min-width: 0; }
  .ai-log :global(.lead-f > span), .ai-log :global(.lead-f legend) { font-size: 12px; font-weight: 600; color: var(--muted); padding: 0; margin-bottom: 4px; }
  .ai-log :global(.lead-f input), .ai-log :global(.lead-f textarea) {
    font: inherit; font-size: 14px; color: var(--text); padding: 9px 12px; border-radius: 12px; resize: none;
    border: 1.5px solid transparent; background: var(--bg); transition: border-color .2s, box-shadow .2s;
  }
  .ai-log :global(.lead-f input:focus), .ai-log :global(.lead-f textarea:focus) { outline: none; border-color: color-mix(in srgb, var(--violet) 55%, transparent); box-shadow: 0 0 0 4px color-mix(in srgb, var(--violet) 12%, transparent); }
  .ai-log :global(.lead-opts) { display: flex; flex-wrap: wrap; gap: 6px; }
  .ai-log :global(.lead-opt) { position: relative; cursor: pointer; }
  .ai-log :global(.lead-opt input) { position: absolute; opacity: 0; pointer-events: none; }
  .ai-log :global(.lead-opt span) { display: inline-block; font-size: 13px; padding: 6px 12px; border-radius: 999px; background: var(--bg); color: var(--text); transition: background .25s, color .25s, transform .3s var(--spring); }
  .ai-log :global(.lead-opt:hover span) { transform: translateY(-1px); background: color-mix(in srgb, var(--violet) 10%, var(--bg)); }
  .ai-log :global(.lead-opt input:checked + span) { color: #fff; background: linear-gradient(120deg, var(--brand-2), var(--violet)); }
  .ai-log :global(.lead-opt input:focus-visible + span) { outline: 2px solid var(--violet); outline-offset: 2px; }
  .ai-log :global(.lead-err) { font-size: 12px; color: var(--pink); min-height: 0; }
  .ai-log :global(.lead-err:empty) { display: none; }
  .ai-log :global(.lead button) { align-self: flex-start; border: 0; cursor: pointer; font: inherit; font-size: 14px; font-weight: 600; color: #fff; padding: 9px 18px; border-radius: 999px; background: linear-gradient(120deg, var(--brand-2), var(--violet)); transition: box-shadow .3s, transform .4s var(--spring); }
  .ai-log :global(.lead button:hover) { transform: translateY(-2px); box-shadow: 0 10px 22px -8px color-mix(in srgb, var(--violet) 60%, transparent); }
  .ai-log :global(.lead.sent) { opacity: .55; }
  .ai-log :global(.lead.sent button) { display: none; }

  .ai-form { display: flex; align-items: flex-end; gap: 8px; margin: 0 12px 12px; padding: 6px 6px 6px 4px; border-radius: 24px; background: var(--bg); transition: box-shadow .2s; }
  .ai-form:focus-within { box-shadow: 0 0 0 2px color-mix(in srgb, var(--violet) 45%, transparent), 0 0 18px color-mix(in srgb, var(--brand) 20%, transparent); }
  .ai-form textarea { flex: 1; resize: none; max-height: 140px; font: inherit; font-size: 14px; line-height: 1.5; color: var(--text); padding: 7px 10px; border: 0; background: transparent; }
  .ai-form textarea:focus { outline: none; }
  .ai-form button { flex-shrink: 0; width: 38px; height: 38px; border: 0; border-radius: 50%; cursor: pointer; color: #fff; font-size: 17px; font-weight: 800; background: linear-gradient(135deg, var(--brand-2), var(--violet)); transition: transform .3s var(--spring); }
  .ai-form button:hover { transform: scale(1.08) rotate(-8deg); }

  @media (max-width: 640px) {
    .ai { right: 16px; bottom: 16px; left: 16px; }
    .ai-fab-text { display: none; }
    .ai-nudge { width: min(260px, 100%); }
    .ai-panel { width: 100%; height: 75vh; }
  }
  @media (prefers-reduced-motion: reduce) { .spark, .ai:not(.open) .ai-fab::after { animation: none; } }
</style>
