---
// 右下角 AI 助手：浮动按钮 + 对话面板（替代原“回到顶部”按钮）。
// 原型阶段按关键词匹配预设问答（见 content/zh.ts 的 aiAssistant），交互逻辑在 BaseLayout 的全站脚本里。
import { useLang } from '../../lib/i18n';
const { c, ui, lang } = useLang(Astro.url);
const { aiAssistant } = c;
// 预设答案里的站内链接，英文版加 /en 前缀
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + (lang === 'en' ? '/en' : '');
---
<div class="ai" id="ai-chat" data-base={base}>
  <script type="application/json" id="ai-data" set:html={JSON.stringify(aiAssistant)} />

  <section class="ai-panel" id="ai-panel" role="dialog" aria-label={aiAssistant.title} aria-hidden="true">
    <header class="ai-head">
      <span class="ai-avatar" aria-hidden="true">✦</span>
      <span class="ai-titles">
        <strong>{aiAssistant.title}</strong>
        <small>{ui.aiNote}</small>
      </span>
      <button class="ai-close" data-ai-close aria-label={ui.close}>×</button>
    </header>
    <div class="ai-log" id="ai-log" aria-live="polite">
      <div class="msg bot">{aiAssistant.greeting}</div>
      <div class="ai-chips">
        {aiAssistant.suggestions.map((q) => <button class="ai-chip" data-ai-q={q}>{q}</button>)}
      </div>
    </div>
    <form class="ai-form" data-ai-form data-astro-reload>
      <input name="q" autocomplete="off" placeholder={ui.aiPlaceholder} aria-label={ui.aiInput} />
      <button type="submit" aria-label={ui.send}>↑</button>
    </form>
  </section>

  <button class="ai-fab" data-ai-open aria-controls="ai-panel" aria-expanded="false">
    <span class="spark" aria-hidden="true">✦</span><span class="ai-fab-text">{ui.aiFab}</span>
  </button>
</div>

<style>
  /* 容器本身不拦截点击；只有按钮和打开的面板可交互 */
  .ai { position: fixed; right: 24px; bottom: 24px; z-index: 60; display: flex; flex-direction: column; align-items: flex-end; gap: 14px; pointer-events: none; }
  .ai-fab, .ai.open .ai-panel { pointer-events: auto; }
  /* 圆形按钮（和原“回到顶部”同尺寸），悬停时左侧出现文字提示 */
  .ai-fab {
    position: relative; width: 56px; height: 56px; border-radius: 50%; border: 0; cursor: pointer; color: #fff;
    display: grid; place-items: center; background: linear-gradient(135deg, var(--brand), var(--brand-2), var(--violet)); background-size: 200% 200%;
    box-shadow: 0 14px 30px -10px rgba(0,113,206,.65); transition: transform .4s var(--spring), background-position .6s, box-shadow .3s;
  }
  .ai-fab:hover { transform: translateY(-3px) scale(1.06); background-position: 100% 100%; }
  .spark { font-size: 22px; line-height: 1; display: inline-block; animation: twinkle 3s ease-in-out infinite; }
  @keyframes twinkle { 50% { transform: rotate(90deg) scale(1.15); } }
  .ai-fab-text {
    position: absolute; right: calc(100% + 10px); top: 50%; translate: 0 -50%; white-space: nowrap;
    font-size: 13px; font-weight: 700; color: var(--ink); background: var(--surface); padding: 6px 12px; border-radius: 999px;
    box-shadow: 0 8px 20px -10px rgba(10,22,48,.35); opacity: 0; transform: translateX(6px); pointer-events: none;
    transition: opacity .2s, transform .3s var(--spring);
  }
  .ai-fab:hover .ai-fab-text, .ai-fab:focus-visible .ai-fab-text { opacity: 1; transform: none; }
  .ai.open .ai-fab-text { display: none; }
  .ai.open .ai-fab { box-shadow: 0 0 0 4px rgba(0,113,206,.2), 0 16px 34px -12px rgba(0,113,206,.65); }

  .ai-panel {
    width: 380px; height: 540px; max-height: calc(100vh - 120px); display: flex; flex-direction: column; overflow: hidden;
    background: var(--surface); border-radius: 26px; box-shadow: 0 30px 70px -24px rgba(10,22,48,.45);
    transform-origin: bottom right; opacity: 0; visibility: hidden; transform: translateY(16px) scale(.94);
    transition: opacity .25s, transform .4s var(--spring), visibility .25s;
  }
  .ai.open .ai-panel { opacity: 1; visibility: visible; transform: none; }
  .ai-head { display: flex; align-items: center; gap: 12px; padding: 16px 18px; color: #fff; background: linear-gradient(120deg, var(--brand), var(--violet)); }
  .ai-avatar { width: 38px; height: 38px; border-radius: 50%; display: grid; place-items: center; background: rgba(255,255,255,.2); font-size: 18px; }
  .ai-titles { display: flex; flex-direction: column; margin-right: auto; line-height: 1.35; }
  .ai-titles strong { font-size: 15px; }
  .ai-titles small { font-size: 11px; opacity: .85; }
  .ai-close { border: 0; background: rgba(255,255,255,.18); color: #fff; width: 32px; height: 32px; border-radius: 50%; font-size: 20px; cursor: pointer; line-height: 1; }
  .ai-close:hover { background: rgba(255,255,255,.32); }

  .ai-log { flex: 1; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 10px; background: var(--bg); }
  .ai-log :global(.msg) { max-width: 86%; padding: 10px 14px; border-radius: 18px; font-size: 14px; line-height: 1.7; animation: pop .35s var(--spring) both; }
  .ai-log :global(.msg.bot) { align-self: flex-start; background: var(--surface); border-bottom-left-radius: 6px; box-shadow: 0 6px 16px -12px rgba(10,22,48,.35); }
  .ai-log :global(.msg.user) { align-self: flex-end; color: #fff; background: linear-gradient(120deg, var(--brand), var(--brand-2)); border-bottom-right-radius: 6px; }
  .ai-log :global(.msg a) { display: inline-flex; margin-top: 8px; font-weight: 700; color: var(--brand); }
  .ai-log :global(.typing) { display: inline-flex; gap: 4px; }
  .ai-log :global(.typing i) { width: 6px; height: 6px; border-radius: 50%; background: var(--muted); animation: blink 1s infinite; }
  .ai-log :global(.typing i:nth-child(2)) { animation-delay: .15s; }
  .ai-log :global(.typing i:nth-child(3)) { animation-delay: .3s; }
  @keyframes blink { 50% { opacity: .2; } }
  @keyframes pop { from { opacity: 0; transform: translateY(8px) scale(.96); } }
  .ai-log :global(.ai-chips) { display: flex; flex-wrap: wrap; gap: 8px; }
  .ai-log :global(.ai-chip) { border: 1.5px solid var(--line); background: var(--surface); color: var(--text); font: inherit; font-size: 13px; padding: 7px 12px; border-radius: 999px; cursor: pointer; transition: border-color .2s, color .2s, transform .3s var(--spring); }
  .ai-log :global(.ai-chip:hover) { border-color: var(--brand); color: var(--brand); transform: translateY(-2px); }

  .ai-form { display: flex; gap: 8px; padding: 12px; border-top: 1px solid var(--line); background: var(--surface); }
  .ai-form input { flex: 1; font: inherit; font-size: 14px; padding: 11px 14px; border-radius: 999px; border: 1.5px solid var(--line); background: var(--bg); }
  .ai-form input:focus { outline: none; border-color: var(--brand); box-shadow: 0 0 0 4px rgba(0,113,206,.12); }
  .ai-form button { width: 42px; height: 42px; border: 0; border-radius: 50%; cursor: pointer; color: #fff; font-size: 18px; font-weight: 800; background: linear-gradient(135deg, var(--brand), var(--brand-2)); }

  @media (max-width: 640px) {
    .ai { right: 16px; bottom: 16px; left: 16px; }
    .ai-fab-text { display: none; }
    .ai-panel { width: 100%; height: 70vh; }
  }
  @media (prefers-reduced-motion: reduce) { .spark { animation: none; } }
</style>
