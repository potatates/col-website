---
// 业务海报墙：首页“业务与产品”板块使用。每项业务一张彩色海报卡，错落排列。
import { useLang } from '../../lib/i18n';
const { c, ui, l: u } = useLang(Astro.url);
const { businessPages } = c;

const hook = ui.bizHook;
---
<div class="posters">
  {businessPages.map((b, i) => (
    <a href={u(b.href)} class:list={['poster', 'spot', 'reveal', `p${i + 1}`]} style={`--c1:${b.theme?.[0]};--c2:${b.theme?.[1]};--d:${i * 80}ms`}>
      <span class="p-shape s1" aria-hidden="true"></span>
      <span class="p-shape s2" aria-hidden="true"></span>
      <span class="p-en">{b.en}</span>
      <span class="p-title">{b.title}</span>
      <span class="p-hook">{hook[b.key]}</span>
      <span class="p-go" aria-hidden="true">→</span>
    </a>
  ))}
</div>

<style>
  /* 便当盒（bento）布局：大小不一、错落排列，避免整齐的方格感
     网文 = 大块主视觉；影视·短剧 = 横幅；海外 = 竖长；AI / 版权 / 数商 填充（顺序见 10/22 会议） */
  .posters {
    display: grid; gap: 18px;
    grid-template-columns: repeat(12, 1fr);
    grid-auto-rows: 190px;
    grid-template-areas:
      "a a a a a b b b b b b b"
      "a a a a a c c c d d d d"
      "e e e e f f f f d d d d";
  }
  .p1 { grid-area: a; } .p2 { grid-area: b; } .p3 { grid-area: d; } .p4 { grid-area: f; } .p5 { grid-area: e; } .p6 { grid-area: c; }
  .poster {
    position: relative; overflow: hidden; isolation: isolate; border-radius: 32px; color: #fff;
    min-height: 0; padding: 28px; display: flex; flex-direction: column; justify-content: flex-end; gap: 6px;
    background:
      radial-gradient(120% 90% at 0% 0%, color-mix(in srgb, var(--c1) 70%, #fff) 0%, transparent 55%),
      linear-gradient(135deg, var(--c1) 0%, var(--c2) 100%);
    box-shadow: 0 20px 40px -24px color-mix(in srgb, var(--c2) 80%, transparent);
    transition: transform .6s var(--spring), box-shadow .4s, opacity .8s var(--ease);
  }
  .p1 .p-title, .p3 .p-title { font-size: clamp(36px, 4.2vw, 58px); }
  .p4 .p-hook, .p6 .p-hook { font-size: 13px; }
  .poster::after {
    content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: radial-gradient(360px circle at var(--mx, 50%) var(--my, 50%), rgba(255,255,255,.28), transparent 65%);
    opacity: 0; transition: opacity .3s;
  }
  .poster:hover { transform: translateY(-10px) rotate(-1deg); box-shadow: 0 36px 60px -28px color-mix(in srgb, var(--c1) 90%, transparent); }
  .poster:nth-child(even):hover { transform: translateY(-10px) rotate(1deg); }
  .poster:hover::after { opacity: 1; }

  .p-shape { position: absolute; z-index: -1; transition: transform .8s var(--spring); }
  .s1 { width: 260px; height: 260px; border-radius: 50%; border: 2px solid rgba(255,255,255,.3); right: -60px; top: -80px; }
  .s2 { width: 120px; height: 120px; border-radius: 40% 60% 55% 45%; background: rgba(255,255,255,.18); right: 36px; top: 40px; }
  .poster:hover .s1 { transform: scale(1.15) rotate(20deg); }
  .poster:hover .s2 { transform: translate(-20px, 16px) rotate(60deg) scale(1.2); }

  .p-en { font-size: 12px; font-weight: 700; letter-spacing: .22em; opacity: .8; }
  .p-title { font-size: clamp(30px, 3.4vw, 46px); font-weight: 900; line-height: 1.1; }
  .p-hook { font-size: 15px; opacity: .9; }
  .p-go {
    position: absolute; right: 28px; bottom: 28px; width: 52px; height: 52px; border-radius: 50%;
    background: #fff; color: var(--c1); display: grid; place-items: center; font-size: 20px; font-weight: 700;
    transform: scale(.6) rotate(-45deg); opacity: 0; transition: transform .5s var(--spring), opacity .3s;
  }
  .poster:hover .p-go { transform: none; opacity: 1; }

  @media (max-width: 1080px) {
    .posters { grid-template-columns: 1fr 1fr; grid-auto-rows: 200px; grid-template-areas: "a a" "b d" "c d" "e f"; }
    
    .p-go { opacity: 1; transform: none; width: 44px; height: 44px; }
  }
  @media (max-width: 640px) {
    .posters { grid-template-columns: 1fr; grid-auto-rows: auto; grid-template-areas: "a" "b" "d" "c" "e" "f"; }
    .poster { min-height: 190px; padding: 24px; border-radius: 26px; }
  }
</style>
