---
// 页头：8 个一级栏目直接链接；只有“业务与产品”带下拉，列出各业务；“合作”为突出按钮
import { u as asset } from '../../lib/url';
import { useLang, switchPath } from '../../lib/i18n';

const { c, ui, l: u, lang } = useLang(Astro.url);
const { site, navOrder, businessPages } = c;

interface Props {
  current?: string; // 当前所在栏目 key，用于高亮
}
const { current = '' } = Astro.props;
const businessKeys = ['business', ...businessPages.map((p) => p.key)];
const isActive = (key: string) => key === current || (key === 'business' && businessKeys.includes(current));
---
<header class="site-header" id="site-header">
  <div class="container bar">
    <a href={u("/")} class="logo" aria-label={`${site.name} ${ui.homeAria}`}>
      <img src={asset("/logo-white.png")} alt={site.name} width="177" height="24" class="on-dark" />
      <img src={asset("/logo.png")} alt="" width="177" height="24" class="on-light" aria-hidden="true" />
    </a>

    <nav class="nav" aria-label={ui.mainNav}>
      {navOrder.map((page) => (
        <div class:list={['nav-item', { 'has-dd': page.key === 'business', cta: page.key === 'partner' }]}>
          <a href={u(page.href)} class:list={['nav-link', { active: isActive(page.key) }]}>
            {page.nav ?? page.title}{page.key === 'business' && <span class="caret" aria-hidden="true">▾</span>}
          </a>
          {page.key === 'business' && (
            <div class="dropdown">
              <div class="dd">
                {businessPages.map((bp) => (
                  <a href={u(bp.href)} class="dd-link" style={`--c1:${bp.theme?.[0]};--c2:${bp.theme?.[1]}`}>
                    <i aria-hidden="true"></i>{bp.title}
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>
      ))}
    </nav>

    <div class="tools">
      <!-- 股价小标签：页面打开时读取腾讯财经公开行情（BaseLayout 全站脚本），读取失败时显示 --.-- -->
      <a href={u("/investors")} class="stock" title={ui.stockPending}>{site.stockCode}<em data-stock="price">--.--</em><b data-stock="pct"></b></a>
      <button class="theme-btn" id="theme-btn" type="button" aria-label={ui.toggleTheme} title={ui.toggleTheme}>
        <svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" /></svg>
        <svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
      </button>
      <span class="lang">
        <a href={switchPath(Astro.url, 'zh')} class:list={{ on: lang === 'zh' }} lang="zh-CN">中</a>
        <span class="sep">/</span>
        <a href={switchPath(Astro.url, 'en')} class:list={{ on: lang === 'en' }} lang="en">EN</a>
      </span>
      <button class="menu-btn" aria-label={ui.openMenu} aria-expanded="false" id="menu-btn">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
  <div class="progress" id="progress" aria-hidden="true"></div>

  <nav class="drawer" id="drawer" aria-label={ui.mobileNav}>
    <a href={u("/")}>{ui.home}</a>
    {navOrder.map((page) => (
      <>
        <a href={u(page.href)}>{page.nav ?? page.title}</a>
        {page.key === 'business' && businessPages.map((bp) => <a href={u(bp.href)} class="sub">{bp.title}</a>)}
      </>
    ))}
  </nav>
</header>

<style>
  .site-header {
    position: fixed; inset: 0 0 auto 0; z-index: 50; color: #fff;
    transition: background .35s, color .35s, box-shadow .35s;
  }
  .site-header.scrolled, .site-header.open {
    background: var(--glass); backdrop-filter: saturate(180%) blur(18px);
    color: var(--text); box-shadow: 0 1px 0 rgba(10,22,48,.06);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 76px; gap: 24px; }
  .logo { display: flex; align-items: center; flex-shrink: 0; transition: transform .4s var(--spring); }
  .logo:hover { transform: scale(1.03); } /* 品牌手册不允许改动标识比例/角度，悬停只做轻微放大 */
  .logo img { height: 24px; width: auto; }
  .logo .on-light { display: none; }
  .scrolled .logo .on-dark, .open .logo .on-dark { display: none; }
  .scrolled .logo .on-light, .open .logo .on-light { display: block; }

  .nav { display: flex; align-items: center; gap: 6px; padding: 5px; border-radius: 999px; background: rgba(255,255,255,.1); backdrop-filter: blur(10px); }
  .scrolled .nav { background: rgba(10,22,48,.04); }
  .nav-item { position: relative; }
  .nav-link {
    display: inline-flex; align-items: center; gap: 4px;
    padding: 8px 13px; border-radius: 999px; font-size: 15px; font-weight: 500; white-space: nowrap;
    transition: background .25s, color .25s;
  }
  .nav-link:hover, .nav-item:hover .nav-link { background: rgba(255,255,255,.18); }
  .scrolled .nav-link:hover, .scrolled .nav-item:hover .nav-link { background: rgba(0,113,206,.08); color: var(--brand); }
  .nav-link.active { background: #fff; color: #0b1430; }
  .scrolled .nav-link.active { background: var(--night); color: #fff; }
  :global([data-theme="dark"]) .scrolled .nav-link.active { background: var(--brand); }
  .caret { font-size: 10px; opacity: .7; transition: transform .3s var(--spring); }
  .has-dd:hover .caret { transform: rotate(180deg); }
  .cta .nav-link { background: linear-gradient(120deg, var(--brand), var(--brand-2)); color: #fff; }
  .cta .nav-link:hover { filter: brightness(1.1); color: #fff !important; }
  .stock { display: inline-flex; align-items: baseline; gap: 6px; font-size: 12px; font-weight: 700; padding: 5px 10px; border-radius: 999px; background: rgba(255,255,255,.14); transition: background .2s; white-space: nowrap; }
  .stock em { font-style: normal; opacity: .7; font-variant-numeric: tabular-nums; }
  .stock b { font-variant-numeric: tabular-nums; }
  .stock b:empty { display: none; }
  .scrolled .stock { background: rgba(10,22,48,.05); }
  .stock:hover { background: rgba(255,255,255,.28); }

  /* 业务布局下拉：五大业务 */
  .dropdown {
    position: absolute; top: 100%; left: 50%; padding-top: 12px;
    opacity: 0; visibility: hidden; transform: translate(-50%, 10px) scale(.96); transform-origin: top center;
    transition: opacity .2s, transform .35s var(--spring), visibility .2s;
  }
  .has-dd:hover .dropdown, .has-dd:focus-within .dropdown { opacity: 1; visibility: visible; transform: translate(-50%, 0) scale(1); }
  .dd-off .dropdown { opacity: 0 !important; visibility: hidden !important; }
  .dd {
    background: var(--surface); color: var(--text); border-radius: 20px; padding: 8px; min-width: 200px;
    box-shadow: 0 24px 60px -20px rgba(10,22,48,.35); display: flex; flex-direction: column;
  }
  .dd-link {
    display: flex; align-items: center; gap: 12px; padding: 11px 14px; border-radius: 12px; font-size: 15px; font-weight: 500;
    transition: background .2s, transform .3s var(--spring);
  }
  .dd-link i { width: 12px; height: 12px; border-radius: 50%; background: linear-gradient(135deg, var(--c1), var(--c2)); transition: transform .3s var(--spring); }
  .dd-link:hover { background: var(--bg); transform: translateX(4px); }
  .dd-link:hover i { transform: scale(1.5); }

  .tools { display: flex; align-items: center; gap: 16px; }
  .theme-btn { width: 34px; height: 34px; border-radius: 50%; border: 0; display: grid; place-items: center; cursor: pointer; color: inherit; background: rgba(127,140,170,.16); transition: transform .5s var(--spring), background .3s; }
  .theme-btn:hover { transform: rotate(-20deg) scale(1.08); background: rgba(127,140,170,.28); }
  .theme-btn svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .theme-btn .i-sun { display: none; }
  :global([data-theme="dark"]) .theme-btn .i-sun { display: block; }
  :global([data-theme="dark"]) .theme-btn .i-moon { display: none; }
  /* 深色模式下页头滚动后仍是深底，继续用白色 logo */
  :global([data-theme="dark"]) .scrolled .logo .on-dark, :global([data-theme="dark"]) .open .logo .on-dark { display: block; }
  :global([data-theme="dark"]) .scrolled .logo .on-light, :global([data-theme="dark"]) .open .logo .on-light { display: none; }
  .lang { font-size: 14px; display: flex; gap: 6px; align-items: center; }
  .lang .on { font-weight: 700; }
  .lang a:not(.on), .lang .sep { opacity: .55; }
  .lang a:not(.on):hover { opacity: 1; }

  .progress {
    position: absolute; left: 0; right: 0; bottom: 0; height: 3px; transform-origin: left; transform: scaleX(0);
    background: linear-gradient(90deg, var(--brand), var(--brand-2), #6c4dff, #ff5c9a);
  }

  .menu-btn { display: none; background: none; border: 0; width: 28px; height: 28px; cursor: pointer; position: relative; color: inherit; }
  .menu-btn span { position: absolute; left: 3px; right: 3px; height: 2px; border-radius: 2px; background: currentColor; transition: transform .3s var(--spring), opacity .25s; }
  .menu-btn span:nth-child(1) { top: 7px; }
  .menu-btn span:nth-child(2) { top: 13px; }
  .menu-btn span:nth-child(3) { top: 19px; }
  .open .menu-btn span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .open .menu-btn span:nth-child(2) { opacity: 0; }
  .open .menu-btn span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

  .drawer { display: none; }

  @media (max-width: 1280px) { .stock { display: none; } }
  /* 英文导航更长：字号、间距收紧一档 */
  :global(html[lang='en']) .nav-link { font-size: 14px; padding: 8px 11px; }
  @media (max-width: 1440px) { :global(html[lang='en']) .stock { display: none; } }
  @media (max-width: 1180px) {
    .nav { display: none; }
    .menu-btn { display: block; }
    .drawer {
      display: flex; flex-direction: column; background: var(--surface); color: var(--text);
      max-height: 0; overflow: auto; transition: max-height .45s var(--ease);
    }
    .open .drawer { max-height: calc(100vh - 76px); }
    .drawer a { padding: 16px 20px; font-size: 20px; font-weight: 700; border-top: 1px solid var(--line); }
    .drawer a.sub { padding: 10px 20px 10px 40px; font-size: 15px; font-weight: 500; color: var(--muted); border-top: 0; }
  }
</style>
